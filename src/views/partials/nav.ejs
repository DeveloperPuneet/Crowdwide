<header class="site-nav">
  <a class="brand" href="/">
    <img src="/images/Crowdwide_logo.png" alt="Crowdwide logo">
    <span>Crowdwide</span>
  </a>
  <nav class="nav-links">
    <a href="#why">Why Crowdwide</a>
    <a href="#communities">Communities</a>
    <a href="/about">About</a>
  </nav>
  <div class="nav-actions">
    <% if (currentUser) { %>
      <a class="button button-small button-ghost" href="/dashboard">Open app</a>
