<%#
  One chat bubble (direct message or group message). Rendered on the server for
  the first page load AND for every message that arrives later (send / poll /
  "load earlier" all return this same markup), so there is a single source of
  truth for how a message looks.
%>
<%
  const m = locals.message;
  const inGroup = locals.group === true;
  const senderId = String(m.sender?._id || m.sender);
  const mine = senderId === String(locals.viewerId);
  const iso = new Date(m.createdAt).toISOString();
  const reactions = (m.reactions || []).map((r) => ({ emoji: r.emoji, count: (r.users || []).length, reacted: (r.users || []).some((id) => String(id) === String(locals.viewerId)) }));
%>
<% if (m.kind === 'system') { %>
<div class="chat-system" data-id="<%= m._id %>" data-time="<%= iso %>"><span><strong><%= m.sender?.name || 'Someone' %></strong> <%= m.body %></span></div>
<% } else { %>
<div class="chat-msg<%= mine ? ' is-own' : '' %>" data-id="<%= m._id %>" data-time="<%= iso %>" data-sender="<%= senderId %>">
	<% if (!mine && inGroup) { %><span class="chat-msg-avatar"><%- include('avatar', { person: m.sender || {}, size: 'tiny', link: false }) %></span><% } %>
	<div class="chat-msg-main">
		<% if (!mine && inGroup) { %><span class="chat-sender"><%= m.sender?.name || 'Member' %></span><% } %>
		<div class="chat-bubble<%= (m.gif?.url || m.postPreview) && !m.body ? ' is-media' : '' %>">
			<% if (m.postPreview) { %>
				<% if (m.postPreview.unavailable) { %>
				<div class="chat-post is-unavailable"><%- icon('lock', { size: 15 }) %> <span>This post isn't available to you.</span></div>
				<% } else { const p = m.postPreview; %>
				<a class="chat-post" href="/posts/<%= p.id %>">
					<% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } %>
					<span class="chat-post-body"><span class="chat-post-kind"><%= p.label %> · <%= p.author %></span><span class="chat-post-text"><%= p.excerpt || 'Open to view' %></span></span>
				</a>
				<% } %>
			<% } %>
			<% if (m.gif?.url) { %><img class="chat-gif" src="<%= m.gif.url %>" alt="<%= m.gif.title || 'GIF' %>" loading="lazy"<% if (m.gif.width && m.gif.height) { %> width="<%= m.gif.width %>" height="<%= m.gif.height %>"<% } %>><% } %>
			<% if (m.attachment?.filename) { const attachmentUrl = inGroup ? `${locals.reportBaseUrl}/messages/${m._id}/attachment` : `${locals.reportBaseUrl}/${m._id}/attachment`; const attachmentType = m.attachment.contentType || ''; const isImage = attachmentType.startsWith('image/'); const isVideo = attachmentType.startsWith('video/'); %>
			<% if (isImage) { %><a class="chat-attachment-media-link" href="<%= attachmentUrl %>" download><img class="chat-attachment-media" src="<%= attachmentUrl %>" alt="<%= m.attachment.filename %>" loading="lazy"></a><% } else if (isVideo) { %><video class="chat-attachment-media" controls preload="metadata" playsinline src="<%= attachmentUrl %>"></video><% } %>
			<a class="chat-attachment" href="<%= attachmentUrl %>" download><%- icon('paperclip', { size: 15 }) %><span><%= m.attachment.filename %></span><small><%= Math.ceil(m.attachment.size / 1024) %> KB</small></a>
			<% } %>
			<% if (m.body) { %><p class="chat-text"><%= m.body %></p><% } %>
		</div>
		<time class="chat-time" datetime="<%= iso %>"></time>
		<%- include('emoji-reaction-bar', { reactions, targetType: inGroup ? 'group' : 'dm', targetId: m._id, groupId: inGroup ? locals.groupId : null }) %>
		<% if (!mine && locals.reportBaseUrl) { const reportUrl = inGroup ? `${locals.reportBaseUrl}/messages/${m._id}/report` : `${locals.reportBaseUrl}/${m._id}/report`; %>
		<details class="report-options chat-message-report">
			<summary aria-label="Report message"><%- icon('flag', { size: 13 }) %><span>Report</span></summary>
			<form method="post" action="<%= reportUrl %>">
				<input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
				<%- include('report-reason-field') %>
				<button type="submit">Send report</button>
			</form>
		</details>
		<% } %>
	</div>
</div>
<% } %>
