<%# Feed card: content and the four counters only (likes, comments, shares, views).
    Everything you do *after* reading - reply, quote, save, react, report, edit - lives on the post page. %>
<% const readOnly = Boolean(locals.readOnly); const canInteract = Boolean(locals.currentUser) && !readOnly; %>
<article class="post-card <%= post.contentWarning ? 'has-content-warning' : '' %>" id="post-<%= post._id %>" data-post-url="/posts/<%= post._id %>">
	<% if (post.contentWarning) { %><button class="content-warning-toggle" type="button" data-warning-toggle>Show content: <%= post.contentWarning %></button><% } %>
	<% const coAuthorNames = (post.coAuthors || []).map((person) => person && typeof person === 'object' ? person.name : '').filter(Boolean); %>
	<div class="post-meta">
		<%- include('avatar', { person: post.author, size: 'small' }) %>
		<div><strong><a class="name-link" href="/u/<%= post.author?._id %>"><%= post.author?.name || 'Crowdwide member' %></a></strong><% if (coAuthorNames.length) { %><span class="co-author-line">with <%= coAuthorNames.slice(0, 2).join(', ') %><% if (coAuthorNames.length > 2) { %> +<%= coAuthorNames.length - 2 %><% } %></span><% } %><span><%= post.type === 'article' ? 'Article' : post.type === 'poll' ? 'Poll' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %><% if (post.status === 'draft') { %> · Draft<% } else if (post.status === 'scheduled') { %> · Scheduled<% } %></span></div>
		<% if (!locals.hideSource) { %><span class="post-source"><%= post.feedSource || 'From your communities' %></span><% } %>
	</div>
	<% if (post.questTitle) { %><span class="quest-post-label">Quest post · <%= post.questTitle %></span><% } %>
	<% const cardReadingWords = String(post.body || '').trim().split(/\s+/).filter(Boolean).length; const cardReadingMinutes = Math.max(1, Math.ceil(cardReadingWords / 220)); %>
	<span class="post-reading-time"><%- icon('clock', { size: 12 }) %> <%= cardReadingMinutes %> min read</span>
	<div class="post-body" data-translatable data-original="<%= post.body %>"><%- renderRichBody(post.body) %></div>
	<% if (post.body && post.body.trim()) { %><button type="button" class="action-translate action-translate-inline" data-translate-trigger><%- icon('globe', { size: 13 }) %> <span class="label">Translate</span></button><% } %>
	<% if (post.poll?.question && post.poll.options?.length) { %>
	<section class="post-poll"><strong><%= post.poll.question %></strong><% post.poll.options.forEach((option, index) => { %><% if (canInteract) { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/poll/vote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="optionIndex" value="<%= index %>"><button type="submit"><%= option.label %> <span><%= option.votes?.length || 0 %></span></button></form><% } else { %><p><%= option.label %> <span><%= option.votes?.length || 0 %></span></p><% } %><% }) %><% if (!locals.currentUser && !readOnly) { %><a class="public-interaction-prompt" href="/auth/register">Create an account to vote</a><% } %><%- include('poll-voters', { poll: post.poll }) %></section>
	<% } %>
	<% if (post.quotedPost) { %><a class="quoted-post" href="/posts/<%= post.quotedPost._id %>"><strong><%= post.quotedPost.author?.name || 'Crowdwide member' %>'s post</strong><p><%= preview(post.quotedPost.body, 240) %></p></a><% } %>
	<% if (post.replyTo) { %><a class="quoted-post reply-source" href="/posts/<%= post.replyTo._id %>"><strong>Replying to <%= post.replyTo.author?.name || 'Crowdwide member' %></strong><p><%= preview(post.replyTo.body, 240) %></p></a><% } %>
	<% if ((post.hashtags || []).length) { %><div class="hashtag-row" style="margin-top: 20px;"><% post.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
	<% if (post.linkPreview?.title) { %>
	<a class="link-preview-card" href="<%= post.linkPreview.url %>" target="_blank" rel="noopener noreferrer nofollow">
		<% if (post.linkPreview.image) { %><img src="<%= post.linkPreview.image %>" alt="" loading="lazy"><% } %>
		<div class="link-preview-body"><span class="link-preview-site"><%= post.linkPreview.siteName %></span><strong><%= post.linkPreview.title %></strong><% if (post.linkPreview.description) { %><p><%= post.linkPreview.description %></p><% } %></div>
	</a>
	<% } %>
	<%- include('post-media', { post }) %>
	<div class="post-actions<%= post.ama?.enabled ? ' has-ama' : '' %>" role="group" aria-label="Post activity" style="background: none;">
		<span class="post-stat post-ama-indicator" data-ama-badge <%= post.ama?.enabled ? '' : 'hidden' %>><%- icon('message-square', { size: 15 }) %><span>AMA</span></span>
		<% if (canInteract) { %><form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="action-like <%= post.liked ? 'is-liked' : '' %>" aria-pressed="<%= post.liked ? 'true' : 'false' %>"><%- icon('heart', { size: 17 }) %><span class="visually-hidden">Like </span><span class="count"><%= post.likes?.length || 0 %></span></button></form><% } else if (readOnly) { %><span class="post-stat guest-like-link" aria-label="<%= post.likes?.length || 0 %> likes"><%- icon('heart', { size: 17 }) %><span><%= post.likes?.length || 0 %></span></span><% } else { %><a class="post-stat guest-like-link" href="/auth/register" aria-label="Create an account to like this post (<%= post.likes?.length || 0 %> likes)"><%- icon('heart', { size: 17 }) %><span><%= post.likes?.length || 0 %></span></a><% } %>
		<a class="post-stat" href="/posts/<%= post._id %>#replies"><%- icon('message-circle', { size: 17 }) %><span class="visually-hidden">Comments </span><span><%= post.commentsCount || 0 %></span></a>
		<a class="post-stat post-stat-replyposts" href="/posts/<%= post._id %>/replies-with-posts" title="Replies with a post"><%- icon('reply-post', { size: 17 }) %><span class="visually-hidden">Replies with a post </span><span><%= post.replyPostsCount || 0 %></span></a>
		<% if (canInteract) { %><button type="button" class="action-share" data-share-open data-post-id="<%= post._id %>" data-post-url="/posts/<%= post._id %>"><%- icon('send', { size: 17 }) %><span class="visually-hidden">Share </span><span data-share-count-for="<%= post._id %>"><%= post.sharesCount || 0 %></span></button><% } else if (readOnly) { %><span class="post-stat" aria-label="<%= post.sharesCount || 0 %> shares"><%- icon('send', { size: 17 }) %><span><%= post.sharesCount || 0 %></span></span><% } else { %><a class="post-stat" href="/auth/register" aria-label="Create an account to share this post (<%= post.sharesCount || 0 %> shares)"><%- icon('send', { size: 17 }) %><span><%= post.sharesCount || 0 %></span></a><% } %>
		<span class="post-stat post-views"><%- icon('eye', { size: 17 }) %><span class="visually-hidden">Views </span><span><%= post.viewsCount || 0 %></span></span>
	</div>
	<% if (!locals.currentUser && !readOnly) { %><a class="public-interaction-prompt" href="/auth/register">Join Crowdwide to like, comment, and share</a><% } %>
</article>
