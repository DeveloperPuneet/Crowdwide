<article class="post-card <%= post.contentWarning ? 'has-content-warning' : '' %>" id="post-<%= post._id %>">
	<% if (post.contentWarning) { %><button class="content-warning-toggle" type="button" data-warning-toggle>Show content: <%= post.contentWarning %></button><% } %>
	<div class="post-meta">
		<%- include('avatar', { person: post.author, size: 'small' }) %>
		<div><strong><a class="name-link" href="/u/<%= post.author?._id %>"><%= post.author?.name || 'Crowdwide member' %></a></strong><span><%= post.type === 'article' ? 'Article' : post.type === 'poll' ? 'Poll' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %><% if (post.status === 'draft') { %> · Draft<% } else if (post.status === 'scheduled') { %> · Scheduled<% } %></span></div>
		<span class="post-source"><%= post.feedSource || 'From your communities' %></span>
	</div>
	<p class="post-body"><%- renderMentions(post.body) %></p>
	<% if (post.poll?.question && post.poll.options?.length) { %>
	<section class="post-poll"><strong><%= post.poll.question %></strong><% post.poll.options.forEach((option, index) => { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/poll/vote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="optionIndex" value="<%= index %>"><button type="submit"><%= option.label %> <span><%= option.votes?.length || 0 %></span></button></form><% }) %></section>
	<% } %>
	<% if (post.quotedPost) { %><a class="quoted-post" href="/posts/<%= post.quotedPost._id %>"><strong><%= post.quotedPost.author?.name || 'Crowdwide member' %>'s post</strong><p><%= (post.quotedPost.body || '').slice(0, 240) %><%= (post.quotedPost.body || '').length > 240 ? '…' : '' %></p></a><% } %>
	<% if (post.replyTo) { %><a class="quoted-post reply-source" href="/posts/<%= post.replyTo._id %>"><strong>Replying to <%= post.replyTo.author?.name || 'Crowdwide member' %></strong><p><%= (post.replyTo.body || '').slice(0, 240) %><%= (post.replyTo.body || '').length > 240 ? '…' : '' %></p></a><% } %>
	<% if ((post.hashtags || []).length) { %><div class="hashtag-row"><% post.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
	<% if ((post.media || []).length) { %>
	<div class="post-media <%= post.media.length === 2 ? 'count-2' : 'count-1' %>">
		<% post.media.forEach((media) => { %>
		<div class="post-media-frame">
			<% if (media.kind === 'image') { %><img src="<%= media.thumbnailUrl || media.url %>" alt="<%= media.alt || 'Post image' %>" loading="lazy">
			<% } else if (media.kind === 'video') { %><video controls controlsList="nodownload" disablePictureInPicture preload="none" src="<%= media.url %>"></video>
			<% } else if (media.kind === 'audio') { %><audio controls controlsList="nodownload" preload="none" src="<%= media.url %>"></audio><% } %>
		</div>
		<% }) %>
	</div>
	<% } %>
	<div class="post-actions">
		<form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= post.liked ? '♥' : '♡' %> <%= post.likes?.length || 0 %></button></form>
		<form method="post" action="/posts/<%= post._id %>/bookmark"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= post.bookmarked ? '▣ Saved' : '▱ Save' %></button></form>
		<form class="share-form" method="post" action="/posts/<%= post._id %>/share"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">↗ Share</button></form>
		<span>◉ <%= post.viewsCount || 0 %></span>
		<a href="/posts/<%= post._id %>" style="color:#85889e;font-size:12px;padding:8px 10px;text-decoration:none;">◌ <%= post.commentsCount || 0 %></a>
	</div>
	<div class="reaction-bar" aria-label="React to this post">
		<% [['celebrate', '👏'], ['insightful', '💡'], ['support', '🤝'], ['funny', '😄']].forEach(([reaction, icon]) => { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/reaction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reaction" value="<%= reaction %>"><button type="submit" title="<%= reaction %>"><%= icon %> <%= post.reactions?.[reaction]?.length || 0 %></button></form><% }) %>
	</div>
	<% if (currentUser && String(post.author?._id) === String(currentUser.id)) { %>
	<details class="post-owner-tools">
		<summary>Edit post</summary>
		<form method="post" action="/posts/<%= post._id %>/edit">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<textarea name="body" maxlength="4000" required><%= post.body %></textarea>
			<button type="submit">Save changes</button>
		</form>
		<form method="post" action="/posts/<%= post._id %>/delete" onsubmit="return confirm('Delete this post?');">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<button type="submit">Delete post</button>
		</form>
	</details>
	<% } %>
	<details class="post-owner-tools">
		<summary>Reply with a post</summary>
		<form class="post-reply-form" data-async-interaction method="post" action="/posts/<%= post._id %>/reply">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<textarea data-mention-input name="body" maxlength="4000" placeholder="Write a public reply..." required></textarea>
			<button type="submit">Publish reply</button>
		</form>
	</details>
	<details class="post-owner-tools">
		<summary>Quote</summary>
		<form method="post" action="/posts/<%= post._id %>/quote">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<textarea data-mention-input name="body" maxlength="4000" placeholder="Add your commentary..." required></textarea>
			<button type="submit">Publish quote</button>
		</form>
	</details>
	<form class="post-report-form" method="post" action="/posts/<%= post._id %>/report"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" maxlength="500" placeholder="Report this post"><button type="submit">Report</button></form>
	<form class="comment-form" data-async-interaction method="post" action="/posts/<%= post._id %>/comments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input data-mention-input name="body" maxlength="2000" placeholder="Add a thoughtful comment..." required><button type="submit">Comment</button></form>
</article>
