<%# Feed card: content and the four counters only (likes, comments, shares, views).
    Everything you do *after* reading - reply, quote, save, react, report, edit - lives on the post page. %>
<article class="post-card <%= post.contentWarning ? 'has-content-warning' : '' %>" id="post-<%= post._id %>" data-post-url="/posts/<%= post._id %>">
	<% if (post.contentWarning) { %><button class="content-warning-toggle" type="button" data-warning-toggle>Show content: <%= post.contentWarning %></button><% } %>
	<div class="post-meta">
		<%- include('avatar', { person: post.author, size: 'small' }) %>
		<div><strong><a class="name-link" href="/u/<%= post.author?._id %>"><%= post.author?.name || 'Crowdwide member' %></a></strong><span><%= post.type === 'article' ? 'Article' : post.type === 'poll' ? 'Poll' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %><% if (post.status === 'draft') { %> · Draft<% } else if (post.status === 'scheduled') { %> · Scheduled<% } %></span></div>
		<% if (!locals.hideSource) { %><span class="post-source"><%= post.feedSource || 'From your communities' %></span><% } %>
	</div>
	<div class="post-body"><%- renderRichBody(post.body) %></div>
	<% if (post.poll?.question && post.poll.options?.length) { %>
	<section class="post-poll"><strong><%= post.poll.question %></strong><% post.poll.options.forEach((option, index) => { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/poll/vote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="optionIndex" value="<%= index %>"><button type="submit"><%= option.label %> <span><%= option.votes?.length || 0 %></span></button></form><% }) %></section>
	<% } %>
	<% if (post.quotedPost) { %><a class="quoted-post" href="/posts/<%= post.quotedPost._id %>"><strong><%= post.quotedPost.author?.name || 'Crowdwide member' %>'s post</strong><p><%= (post.quotedPost.body || '').slice(0, 240) %><%= (post.quotedPost.body || '').length > 240 ? '…' : '' %></p></a><% } %>
	<% if (post.replyTo) { %><a class="quoted-post reply-source" href="/posts/<%= post.replyTo._id %>"><strong>Replying to <%= post.replyTo.author?.name || 'Crowdwide member' %></strong><p><%= (post.replyTo.body || '').slice(0, 240) %><%= (post.replyTo.body || '').length > 240 ? '…' : '' %></p></a><% } %>
	<% if ((post.hashtags || []).length) { %><div class="hashtag-row"><% post.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
	<% if (post.linkPreview?.title) { %>
	<a class="link-preview-card" href="<%= post.linkPreview.url %>" target="_blank" rel="noopener noreferrer nofollow">
		<% if (post.linkPreview.image) { %><img src="<%= post.linkPreview.image %>" alt="" loading="lazy"><% } %>
		<div class="link-preview-body"><span class="link-preview-site"><%= post.linkPreview.siteName %></span><strong><%= post.linkPreview.title %></strong><% if (post.linkPreview.description) { %><p><%= post.linkPreview.description %></p><% } %></div>
	</a>
	<% } %>
	<%- include('post-media', { post }) %>
	<div class="post-actions" aria-label="Post activity">
		<form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="action-like <%= post.liked ? 'is-liked' : '' %>" aria-label="Like" aria-pressed="<%= post.liked ? 'true' : 'false' %>"><%- icon('heart', { size: 17 }) %><span class="count"><%= post.likes?.length || 0 %></span></button></form>
		<a class="post-stat" href="/posts/<%= post._id %>#replies" aria-label="Comments"><%- icon('message-circle', { size: 17 }) %><span><%= post.commentsCount || 0 %></span></a>
		<button type="button" class="action-share" data-share-open data-post-id="<%= post._id %>" data-post-url="/posts/<%= post._id %>" aria-label="Share"><%- icon('send', { size: 17 }) %><span data-share-count-for="<%= post._id %>"><%= post.sharesCount || 0 %></span></button>
		<span class="post-stat post-views" aria-label="Views"><%- icon('eye', { size: 17 }) %><span><%= post.viewsCount || 0 %></span></span>
	</div>
</article>
