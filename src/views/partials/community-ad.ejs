<% const adCommunityId = locals.community?._id || ''; const adContext = ad.contextType || (adCommunityId ? 'community' : 'sitewide'); %>
<article class="community-ad-card" data-community-ad data-context-type="<%= adContext %>" data-campaign-id="<%= ad.campaign._id %>" data-community-id="<%= adCommunityId %>" data-event-token="<%= ad.eventToken %>" data-csrf="<%= csrfToken %>">
  <div class="community-ad-topline">
    <span class="community-ad-sponsored-label"><span aria-hidden="true">✦</span> Sponsored</span>
    <details class="community-ad-report">
      <summary aria-label="Ad options">Ad · Options</summary>
      <form method="post" action="/ads/<%= ad.campaign._id %>/report">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="deliveryContext" value="<%= adContext %>">
        <% if (adCommunityId) { %><input type="hidden" name="communityId" value="<%= adCommunityId %>"><% } %>
        <label>Report this ad
          <select name="reason" required>
            <option value="">Choose a reason</option>
            <option value="Misleading or deceptive">Misleading or deceptive</option>
            <option value="Inappropriate content">Inappropriate content</option>
            <option value="Spam or scam">Spam or scam</option>
            <option value="Other concern">Other concern</option>
          </select>
        </label>
        <button class="button button-small button-ghost" type="submit">Send report</button>
      </form>
    </details>
  </div>
  <div class="community-ad-brand">
    <% if (ad.campaign.advertiser?.logoUrl) { %><img src="<%= ad.campaign.advertiser.logoUrl %>" alt="" class="community-ad-logo" loading="lazy"><% } else { %><span class="community-ad-logo community-ad-logo-fallback" aria-hidden="true"><%= (ad.campaign.advertiser?.businessName || 'A').charAt(0).toUpperCase() %></span><% } %>
    <div><strong><%= ad.campaign.advertiser?.businessName || 'Advertiser' %></strong><span><%= (ad.campaign.campaignType || 'other').replace(/-/g, ' ') %></span></div>
  </div>
  <% if (ad.campaign.bannerUrl) { %><img src="<%= ad.campaign.bannerUrl %>" alt="<%= ad.campaign.campaignType === 'product' ? `Image of ${ad.campaign.productName || ad.campaign.title}` : `Banner for ${ad.campaign.title}` %>" class="community-ad-image" loading="lazy"><% } %>
  <div class="community-ad-copy">
    <h2><%= ad.campaign.campaignType === 'product' ? (ad.campaign.productName || ad.campaign.title) : ad.campaign.title %></h2>
    <% if (ad.campaign.description) { %><p><%= ad.campaign.description %></p><% } %>
    <% if (ad.campaign.campaignType === 'product' && ad.campaign.productPrice) { %><p class="community-ad-price"><strong><%= ad.campaign.productPrice %></strong><small>Advertiser-listed price · purchases are not processed on Crowdwide.</small></p><% } %>
  </div>
  <div class="community-ad-footer">
    <% if (ad.campaign.destinationUrl || ad.campaign.advertiser?.website) { %><a class="community-ad-cta" href="/ads/<%= ad.campaign._id %>/click?<%= adContext === 'sitewide' ? 'context=sitewide' : `community=${encodeURIComponent(adCommunityId)}` %>&amp;event=<%= ad.eventToken %>" target="_blank" rel="noopener noreferrer"><span><%= ad.campaign.campaignType === 'product' ? 'Explore product' : ad.campaign.campaignType === 'service' ? 'Explore service' : 'Learn more' %></span><span aria-hidden="true">↗</span></a><% } %>
    <span class="community-ad-disclosure"><%= adContext === 'sitewide' ? 'Crowdwide feed' : 'Community sponsor' %></span>
  </div>
</article>
