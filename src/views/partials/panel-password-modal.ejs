<div class="panel-password-overlay" role="dialog" aria-modal="true" aria-labelledby="panel-password-title">
  <form class="panel-password-card" method="post" action="/account/panel-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel-password-icon" aria-hidden="true"><%- icon('shield', { size: 24 }) %></div>
    <h2 id="panel-password-title">Set your panel password</h2>
    <p>You have the <strong><%= currentUser.role === 'admin' ? 'admin' : 'moderator' %></strong> role and signed in with Google or GitHub, so there is no password for the panel yet. Choose one now. It will be your panel password, and you can also use it to sign in with your email.</p>
    <label>New password<input type="password" name="newPassword" minlength="8" maxlength="200" autocomplete="new-password" required></label>
    <label>Confirm password<input type="password" name="confirmPassword" minlength="8" maxlength="200" autocomplete="new-password" required></label>
    <button class="button button-primary button-full" type="submit">Set password</button>
    <% if (locals.flash && flash.type === 'error') { %><p class="panel-password-error" role="alert"><%= flash.message %></p><% } %>
  </form>
</div>
