<%# Message list + composer shared by direct messages and group chats.
    The composer is pinned to the bottom of the chat panel; only the message list scrolls. %>
<div class="chat-scroll" data-chat-scroll>
	<% if (locals.hasMore) { %><button class="chat-load-more" data-chat-more type="button">Load earlier messages</button><% } %>
	<div class="chat-messages" data-chat-messages><%- locals.messagesHtml %></div>
	<p class="chat-empty" data-chat-empty<%- String(locals.messagesHtml || '').trim() ? ' hidden' : '' %>><%= locals.emptyText || 'No messages yet. Say hello.' %></p>
</div>
<button class="chat-jump" data-chat-jump type="button" hidden><%- icon('arrow-right', { size: 14, className: 'chat-jump-arrow' }) %> New messages</button>
<p class="chat-error" data-chat-error role="alert" hidden></p>
<p class="chat-retention">Messages and attachments are deleted 30 days after sending. Attachments must be smaller than 3 MB.</p>
<% if (locals.pending) { %>
<div class="chat-request-gate">
	<p><%- icon('user-plus', { size: 16 }) %> <%= locals.requestPersonName %> isn't in your messages yet. Accept to reply, or decline to dismiss this request.</p>
	<div class="request-actions">
		<form method="post" action="/messages/requests/<%= requestPersonId %>/respond">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<input type="hidden" name="decision" value="accept">
			<button type="submit" class="button button-small button-primary">Accept</button>
		</form>
		<form method="post" action="/messages/requests/<%= requestPersonId %>/respond">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<input type="hidden" name="decision" value="decline">
			<button type="submit" class="button button-small button-ghost">Decline</button>
		</form>
	</div>
</div>
<% } else { %>
<form class="chat-composer" data-chat-form method="post" action="<%= sendUrl %>" autocomplete="off" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>">
	<% if (locals.gifsEnabled) { %><button class="chat-tool" type="button" data-gif-trigger aria-label="Send a GIF"><span class="gif-badge">GIF</span></button><% } %>
	<label class="chat-tool chat-attachment-picker" title="Attach a file smaller than 3 MB" aria-label="Attach a file smaller than 3 MB"><span class="chat-attachment-plus" aria-hidden="true">+</span><input type="file" name="attachment" data-chat-attachment accept="image/*,video/mp4,video/webm,video/quicktime,application/pdf,text/plain" aria-label="Attach a file smaller than 3 MB"></label>
	<span class="chat-attachment-selected" data-chat-attachment-selected hidden><span data-chat-attachment-name></span><button type="button" data-chat-attachment-remove aria-label="Remove attachment"><%- icon('x', { size: 15 }) %></button></span>
	<textarea name="body" rows="1" maxlength="2000" placeholder="<%= locals.placeholder || 'Write a message...' %>" data-chat-input aria-label="Message"></textarea>
	<button class="chat-send" type="submit" aria-label="Send message"><%- icon('send', { size: 18 }) %></button>
</form>
<% } %>
