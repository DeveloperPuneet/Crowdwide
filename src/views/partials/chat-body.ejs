<%# Message list + composer shared by direct messages and group chats.
    The composer is pinned to the bottom of the chat panel; only the message list scrolls. %>
<div class="chat-scroll" data-chat-scroll>
	<% if (locals.hasMore) { %><button class="chat-load-more" data-chat-more type="button">Load earlier messages</button><% } %>
	<div class="chat-messages" data-chat-messages><%- locals.messagesHtml %></div>
	<p class="chat-empty" data-chat-empty<%- String(locals.messagesHtml || '').trim() ? ' hidden' : '' %>><%= locals.emptyText || 'No messages yet. Say hello.' %></p>
</div>
<button class="chat-jump" data-chat-jump type="button" hidden><%- icon('arrow-right', { size: 14, className: 'chat-jump-arrow' }) %> New messages</button>
<p class="chat-error" data-chat-error role="alert" hidden></p>
<form class="chat-composer" data-chat-form method="post" action="<%= sendUrl %>" autocomplete="off">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>">
	<% if (locals.gifsEnabled) { %><button class="chat-tool" type="button" data-gif-trigger aria-label="Send a GIF"><span class="gif-badge">GIF</span></button><% } %>
	<textarea name="body" rows="1" maxlength="2000" placeholder="<%= locals.placeholder || 'Write a message...' %>" data-chat-input aria-label="Message"></textarea>
	<button class="chat-send" type="submit" aria-label="Send message"><%- icon('send', { size: 18 }) %></button>
</form>
