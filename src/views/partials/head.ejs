<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VW1V8S9J0V"></script>
  <script nonce="<%= locals.cspNonce || '' %>">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-VW1V8S9J0V');
  </script>
  <title><%= title %> · Crowdwide</title>
  <meta name="description" content="<%= locals.description || 'Crowdwide is a calmer social network for real discovery, thoughtful communities, and voices worth finding.' %>">
  <meta name="robots" content="<%= locals.noIndex ? 'noindex,nofollow' : 'index,follow' %>">
  <link rel="canonical" href="<%= locals.canonicalUrl || (locals.appUrl || 'http://localhost:3000').replace(/\/$/, '') + (locals.pagePath || '/') %>">
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:site_name" content="Crowdwide">
  <meta property="og:title" content="<%= title %> · Crowdwide">
  <meta property="og:description" content="<%= locals.description || 'A fair chance at discovery.' %>">
  <meta property="og:url" content="<%= locals.canonicalUrl || (locals.appUrl || 'http://localhost:3000').replace(/\/$/, '') + (locals.pagePath || '/') %>">
  <meta property="og:image" content="<%= locals.ogImage || (locals.appUrl || 'http://localhost:3000').replace(/\/$/, '') + '/images/Crowdwide_cover.png' %>">
  <meta property="og:image:alt" content="Crowdwide — a fair chance at discovery">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> · Crowdwide">
  <meta name="twitter:description" content="<%= locals.description || 'A fair chance at discovery.' %>">
  <meta name="twitter:image" content="<%= locals.ogImage || (locals.appUrl || 'http://localhost:3000').replace(/\/$/, '') + '/images/Crowdwide_cover.png' %>">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="app-url" content="<%= locals.appUrl || 'http://localhost:3000' %>">
  <link rel="alternate" type="application/rss+xml" title="Crowdwide RSS" href="/rss.xml">
  <link rel="icon" type="image/png" href="/images/Crowdwide_logo_192.png">
  <link rel="apple-touch-icon" href="/images/Crowdwide_logo_192.png">
  <% if (locals.structuredData) { %><script type="application/ld+json"><%- JSON.stringify(locals.structuredData).replace(/</g, '\\u003c') %></script><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# The web-font stylesheet is added by app.js after first paint (see loadWebFonts), so a slow or blocked font host can never hold the page back. %>
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"></noscript>
  <!-- One consolidated, organized stylesheet for the whole app. -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive-media.css">
  <link rel="stylesheet" href="/css/media-player.css">
  <link rel="stylesheet" href="/css/admin-panel.css">
  <link rel="stylesheet" href="/css/responsive-layout.css">
  <link rel="stylesheet" href="/css/chat-ui.css">
  <link rel="stylesheet" href="/css/code-blocks.css">
  <% if (locals.communityPage) { %><link rel="stylesheet" href="/css/community-workspace.css"><% } %>
  <% if (locals.includeLeaflet) { %>
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <script defer src="/vendor/leaflet/leaflet.js"></script>
  <script defer src="/js/community-map.js?v=4"></script>
  <% } %>
</head>
<body class="<%= locals.bodyClass || '' %>" data-theme="<%= locals.currentUser?.theme || 'default' %>">
<% if (locals.isStaging) { %><div class="staging-banner" role="status">Staging environment · not the live site · emails are restricted</div><% } %>
<div class="page-preloader" aria-hidden="true">
  <img class="preloader-mark" src="/images/Crowdwide_logo_192.png" alt="">
  <span class="preloader-label">Loading Crowdwide</span>
  <span class="preloader-line" aria-hidden="true"></span>
</div>
