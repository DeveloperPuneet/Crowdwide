<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Crowdwide</title>
  <meta name="description" content="<%= locals.description || 'Crowdwide is a calmer social network for real discovery, thoughtful communities, and voices worth finding.' %>">
  <meta name="robots" content="<%= locals.noIndex ? 'noindex,nofollow' : 'index,follow' %>">
  <link rel="canonical" href="<%= locals.canonicalUrl || 'http://localhost:3000' + (locals.pagePath || '/') %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Crowdwide">
  <meta property="og:title" content="<%= title %> · Crowdwide">
  <meta property="og:description" content="<%= locals.description || 'A fair chance at discovery.' %>">
  <meta property="og:url" content="<%= locals.canonicalUrl || 'http://localhost:3000' + (locals.pagePath || '/') %>">
  <meta property="og:image" content="/images/Crowdwide_cover.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> · Crowdwide">
  <meta name="twitter:description" content="<%= locals.description || 'A fair chance at discovery.' %>">
  <meta name="twitter:image" content="/images/Crowdwide_cover.png">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="app-url" content="<%= locals.appUrl || 'http://localhost:3000' %>">
  <link rel="alternate" type="application/rss+xml" title="Crowdwide RSS" href="/rss.xml">
  <link rel="icon" type="image/png" href="/images/Crowdwide_logo_192.png">
  <link rel="apple-touch-icon" href="/images/Crowdwide_logo_192.png">
  <% if (locals.structuredData) { %><script type="application/ld+json"><%- JSON.stringify(locals.structuredData) %></script><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# The web-font stylesheet is added by app.js after first paint (see loadWebFonts), so a slow or blocked font host can never hold the page back. %>
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"></noscript>
  <!-- One consolidated, organized stylesheet for the whole app. -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive-media.css">
  <link rel="stylesheet" href="/css/media-player.css">
  <link rel="stylesheet" href="/css/admin-panel.css">
</head>
<body class="<%= locals.bodyClass || '' %>">
