<%
  const siteUrl = String(locals.appUrl || 'http://localhost:3000').replace(/\/$/, '');
  const absolutize = (value) => /^https?:\/\//i.test(value || '') ? value : (value && String(value).startsWith('/') ? siteUrl + value : '');
  const defaultOgImage = siteUrl + '/images/Crowdwide_cover.png';
  const shareImage = absolutize(locals.ogImage) || defaultOgImage;
  const usingDefaultImage = shareImage === defaultOgImage;
  const shareImageAlt = locals.ogImageAlt || (usingDefaultImage ? 'Crowdwide — a fair chance at discovery' : title);
  const twitterCard = locals.twitterCard || (usingDefaultImage || locals.ogImageLarge ? 'summary_large_image' : 'summary');
  const shareTitle = locals.ogTitle || (title + ' · Crowdwide');
  const shareDescription = locals.description || 'A fair chance at discovery.';
%><!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VW1V8S9J0V"></script>
  <script nonce="<%= locals.cspNonce || '' %>">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-VW1V8S9J0V');
  </script>
  <title><%= /Crowdwide$/.test(title) ? title : title + ' · Crowdwide' %></title>
  <meta name="description" content="<%= locals.description || 'Crowdwide is a calmer social network for real discovery, thoughtful communities, and voices worth finding.' %>">
  <meta name="robots" content="<%= locals.noIndex ? 'noindex,nofollow' : 'index,follow' %>">
  <link rel="canonical" href="<%= locals.canonicalUrl || (locals.appUrl || 'http://localhost:3000').replace(/\/$/, '') + (locals.pagePath || '/') %>">
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:site_name" content="Crowdwide">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="<%= shareTitle %>">
  <meta property="og:description" content="<%= shareDescription %>">
  <meta property="og:url" content="<%= locals.canonicalUrl || (locals.appUrl || 'http://localhost:3000').replace(/\/$/, '') + (locals.pagePath || '/') %>">
  <meta property="og:image" content="<%= shareImage %>">
  <meta property="og:image:alt" content="<%= shareImageAlt %>">
  <% if (usingDefaultImage) { %><meta property="og:image:width" content="1672">
  <meta property="og:image:height" content="941"><% } %>
  <meta name="twitter:card" content="<%= twitterCard %>">
  <meta name="twitter:title" content="<%= shareTitle %>">
  <meta name="twitter:description" content="<%= shareDescription %>">
  <meta name="twitter:image" content="<%= shareImage %>">
  <meta name="twitter:image:alt" content="<%= shareImageAlt %>">
  <% if (process.env.TWITTER_SITE) { %><meta name="twitter:site" content="<%= process.env.TWITTER_SITE %>"><% } %>
  <% if (locals.ogArticleAuthor) { %><meta property="article:author" content="<%= locals.ogArticleAuthor %>"><% } %>
  <% if (locals.ogPublishedTime) { %><meta property="article:published_time" content="<%= locals.ogPublishedTime %>"><% } %>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="app-url" content="<%= locals.appUrl || 'http://localhost:3000' %>">
  <link rel="alternate" type="application/rss+xml" title="Crowdwide RSS" href="/rss.xml">
  <link rel="icon" type="image/png" href="/images/Crowdwide_logo_192.png">
  <link rel="apple-touch-icon" href="/images/Crowdwide_apple_touch_180.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#080914">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Crowdwide">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <% if (locals.structuredData) { %><script type="application/ld+json"><%- JSON.stringify(locals.structuredData).replace(/</g, '\\u003c') %></script><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# The web-font stylesheet is added by app.js after first paint (see loadWebFonts), so a slow or blocked font host can never hold the page back. %>
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"></noscript>
  <!-- One consolidated, organized stylesheet for the whole app. -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive-media.css">
  <link rel="stylesheet" href="/css/media-player.css">
  <link rel="stylesheet" href="/css/admin-panel.css">
  <link rel="stylesheet" href="/css/responsive-layout.css">
  <link rel="stylesheet" href="/css/chat-ui.css">
  <link rel="stylesheet" href="/css/code-blocks.css">
  <link rel="stylesheet" href="/css/modern-ui.css">
  <link rel="stylesheet" href="/css/surveys.css">
  <link rel="stylesheet" href="/css/partnerships.css">
  <% if (locals.communityPage) { %><link rel="stylesheet" href="/css/community-workspace.css"><% } %>
  <% if (locals.includeLeaflet) { %>
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <script defer src="/vendor/leaflet/leaflet.js"></script>
  <script defer src="/js/community-map.js?v=4"></script>
  <% } %>
</head>
<body class="<%= locals.bodyClass || '' %>" data-theme="<%= locals.currentUser?.theme || 'default' %>">
<% if (locals.isStaging) { %><div class="staging-banner" role="status">Staging environment · not the live site · emails are restricted</div><% } %>
<div class="page-preloader" aria-hidden="true">
  <img class="preloader-mark" src="/images/Crowdwide_logo_192.png" alt="">
  <span class="preloader-label">Loading Crowdwide</span>
  <span class="preloader-line" aria-hidden="true"></span>
</div>
