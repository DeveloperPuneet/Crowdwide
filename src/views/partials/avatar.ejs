<%
  const person = locals.person || {};
  const sizeClass = locals.size ? ' ' + locals.size : '';
  const initial = (person.name || '?').trim().charAt(0).toUpperCase() || '?';
  const targetId = locals.link === false ? null : (person._id || person.id || null);
%><% if (targetId) { %><a class="avatar-link" href="/u/<%= targetId %>" aria-label="<%= person.name || 'View profile' %>"><% } %><span class="avatar<%= sizeClass %><%= person.profilePicture ? ' has-image' : '' %>"><span class="avatar-initial" aria-hidden="true"><%= initial %></span><% if (person.profilePicture) { %><img class="avatar-image" src="<%= person.profilePicture %>" alt="" aria-hidden="true"><% } %></span><% if (targetId) { %></a><% } %>
