<%
  const g = locals.group || {};
  const sizeClass = locals.size ? ' ' + locals.size : '';
  const initial = (g.name || '?').trim().charAt(0).toUpperCase() || '?';
%><span class="avatar group-avatar<%= sizeClass %><%= g.avatar ? ' has-image' : '' %>"><span class="avatar-initial" aria-hidden="true"><%= initial %></span><% if (g.avatar) { %><img class="avatar-image" src="<%= g.avatar %>" alt="" aria-hidden="true" loading="lazy"><% } %></span>
