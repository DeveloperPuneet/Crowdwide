<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex, communityPage: true }) %>
<%- include('../partials/app-nav', { active: 'explore', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="profile-layout community-detail-layout community-detail-modern">
<div>
	<a class="back-link" href="/explore">← All communities</a>
	<% if (community.coverImage) { %><div class="profile-banner community-cover"><img src="<%= community.coverImage %>" alt=""></div><% } %>
	<section class="community-detail-hero">
		<div class="community-detail-identity">
			<% if (community.avatarImage) { %><img class="community-detail-avatar" src="<%= community.avatarImage %>" alt=""><% } else { %><span class="community-glyph community-detail-avatar"><%= (community.name || '?').trim().charAt(0).toUpperCase() || '?' %></span><% } %>
			<div><p class="eyebrow"><%= community.category || 'general' %> · <%= community.isPrivate ? 'Private community' : 'Open community' %></p><% if (community.promotionStatus === 'active' && community.promotionUntil && new Date(community.promotionUntil) > new Date()) { %><span class="post-source">Promoted · paid with Waves</span><% } %><h1><%= community.name %></h1></div>
		</div>
		<p><%= community.description %></p>
		<% if ((community.hashtags || []).length) { %><div class="hashtag-row" style="margin-top: 25px;"><% community.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
		<div class="community-detail-meta">
			<span><strong><%= community.membersCount %></strong> members</span>
			<span>Owner: <a class="name-link" href="/u/<%= community.owner?._id %>"><%= community.owner?.name || 'Crowdwide' %></a></span>
			<% if (isOwner) { %><a class="button button-small button-ghost" href="/communities/<%= community._id %>/manage">Manage community</a>
			<% } else if (joined) { %><span class="joined-mark">Joined</span><form method="post" action="/communities/<%= community._id %>/leave"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost community-leave-button" type="submit">Leave community</button></form>
			<% } else if (requested) { %><span class="joined-mark">Request pending</span>
			<% } else { %><form method="post" action="/communities/<%= community._id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-small" type="submit"><%= community.isPrivate ? 'Request to join' : 'Join community' %> <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button></form><% } %>
		</div>
	</section>
	<% if (quests && quests.length) { %>
	<section class="discover-panel quest-board">
		<div class="panel-heading"><h2>Quest board</h2><span><%= quests.length %></span></div>
		<% quests.forEach((quest) => {
			const joinedQuest = (quest.participants || []).some((person) => String(person?._id || person) === String(currentUser.id));
			const doneQuest = (quest.completedBy || []).some((person) => String(person?._id || person) === String(currentUser.id));
		%>
		<div class="quest-card">
			<div class="quest-header">
				<span class="quest-badge <%= ['ended', 'archived'].includes(quest.status) || quest.status === 'completed' ? 'quest-badge-complete' : 'quest-badge-open' %>"><%= quest.status === 'ended' ? 'Ended' : quest.status === 'archived' ? 'Archived' : quest.status === 'completed' ? 'Completed' : quest.status === 'active' ? 'Active' : 'Open' %></span>
				<span class="quest-progress"><%= (quest.completedBy || []).length %>/<%= (quest.participants || []).length || 0 %> complete</span>
			</div>
			<strong><%= quest.title %></strong>
			<% if (quest.goal) { %><p><%= quest.goal %></p><% } %>
			<% if (quest.description) { %><small><%= quest.description %></small><% } %>
			<% if (quest.reward) { %><span class="quest-reward">Reward: <%= quest.reward %></span><% } %>
			<% if (quest.status === 'ended' && quest.winner) { %><span class="quest-winner">Winner: <%= quest.winner?.name || 'Community member' %></span><% } %>
			<% if (quest.status === 'ended' && quest.winner && quest.achievementTag) { %><span class="quest-rewarded">Achievement: <%= quest.achievementTag %></span><% } %>
			<% if (quest.status === 'ended' && quest.rewarded) { %><span class="quest-rewarded">Reward sent</span><% } %>
			<% if (joined && !['ended', 'archived'].includes(quest.status)) { %>
				<div class="quest-actions">
					<% if (!joinedQuest) { %>
					<form method="post" action="/communities/<%= community._id %>/quests/<%= quest._id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-primary" type="submit">Join quest</button></form>
					<% } else { %>
					<a class="button button-small button-ghost" href="/dashboard?quest=<%= quest._id %>">Post for quest</a>
					<form method="post" action="/communities/<%= community._id %>/quests/<%= quest._id %>/complete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit"><%= doneQuest ? 'Undo complete' : 'Complete quest' %></button></form>
					<form method="post" action="/communities/<%= community._id %>/quests/<%= quest._id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-dark" type="submit">Leave</button></form>
					<% } %>
				</div>
			<% } %>
		</div>
		<% }) %>
	</section>
	<% } %>
	<section class="community-posts">
		<div class="panel-heading"><h2>Community posts</h2><span><%= locked ? 'Members only' : `${posts.length} recent` %></span></div>
		<% if (locked) { %>
		<div class="empty-feed"><h2>This is a private community.</h2><p>Posts and members are only visible once your request to join is approved.</p></div>
		<% } else if (!posts.length) { %>
		<div class="empty-feed"><h2>This community is just beginning.</h2><p>Be the first person to start the conversation.</p></div>
		<% } %>
		<% if (!locked) { %>
		<% posts.forEach((post, postIndex) => { %>
		<% const isPinnedPost = (community.pinnedPosts || []).some((id) => String(id) === String(post._id)); const isModPost = moderatorIds.includes(String(post.author?._id)); %>
		<% if (isPinnedPost || isModPost) { %><div class="community-post-flags"><% if (isPinnedPost) { %><span class="community-flag"><%- icon('map-pin', { size: 12 }) %> Pinned</span><% } %><% if (isModPost) { %><span class="community-moderator-label">MOD post</span><% } %></div><% } %>
		<%- include('../partials/post-card', { post, csrfToken, hideSource: true }) %>
		<% (locals.feedAds || []).filter((ad) => ad.afterPost === postIndex + 1).forEach((ad) => { %>
		<%- include('../partials/community-ad', { ad, community }) %>
		<% }) %>
		<% }) %>
		<% } %>
	</section>
</div>
<aside class="discover-column">
	<% (locals.sidebarAds || []).forEach((ad) => { %>
	<%- include('../partials/community-ad', { ad, community }) %>
	<% }) %>
	<% if (locals.acceptsAds) { %>
	<section class="discover-panel community-advertise-panel">
		<div class="panel-heading"><h2>Advertise here</h2></div>
		<p class="community-guidelines-copy">Reach this community’s members with a Sponsored ad shown only in <%= community.name %>. Ads are reviewed before they go live.</p>
		<a class="button button-small button-ghost" href="/advertising?community=<%= encodeURIComponent(community.slug) %>#submit-ad"><%- icon('megaphone', { size: 16 }) %> Advertise in this community</a>
	</section>
	<% } %>
	<% if (community.guidelines) { %>
	<section class="discover-panel">
		<div class="panel-heading"><h2>About & guidelines</h2></div>
		<p class="community-guidelines-copy"><%= community.guidelines %></p>
	</section>
	<% } %>
	<section class="discover-panel">
		<div class="panel-heading"><h2>Members</h2><span><%= community.membersCount %></span></div>
		<% members.slice(0, 12).forEach((member) => { %>
		<div class="discover-row">
			<%- include('../partials/avatar', { person: member, size: 'tiny' }) %>
			<div><strong><a class="name-link" href="/u/<%= member._id %>"><%= member.name %></a></strong><span><%= String(member._id) === String(community.owner?._id) ? 'Owner' : moderatorIds.includes(String(member._id)) ? 'Moderator' : 'Member' %></span></div>
		</div>
		<% }) %>
		<% if (members.length > 12) { %><p style="color:var(--tx-faint);font-size:11px;padding-top:10px;">+<%= members.length - 12 %> more members</p><% } %>
	</section>
</aside>
</main>
<script nonce="<%= locals.cspNonce || '' %>">
document.addEventListener('DOMContentLoaded', function () {
  var cards = document.querySelectorAll('[data-community-ad]');
  if (!('IntersectionObserver' in window)) return;
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      observer.unobserve(entry.target);
      var card = entry.target;
      fetch('/ads/' + encodeURIComponent(card.dataset.campaignId) + '/impression', {
        method: 'POST',
        credentials: 'same-origin',
        keepalive: true,
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': card.dataset.csrf },
        body: JSON.stringify({ communityId: card.dataset.communityId, deliveryContext: card.dataset.contextType || 'community', eventToken: card.dataset.eventToken })
      }).then(function (response) {
        if (!response.ok) console.error('Advertisement impression tracking failed:', response.status);
      }).catch(function (error) {
        console.error('Advertisement impression tracking failed:', error);
      });
    });
  }, { threshold: 0.5 });
  cards.forEach(function (card) { observer.observe(card); });
});
</script>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
