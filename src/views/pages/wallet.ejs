<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="recap-layout wallet-page">
  <a class="back-link" href="/dashboard">← Back to your feed</a>
  <header class="recap-heading wallet-heading">
    <p class="eyebrow">Crowdwide platform currency</p>
    <h1>Your Waves wallet</h1>
    <p>Waves are the platform currency for rewards, transfers, campaign budgets, and platform purchases. Crowdwide does not process real-money payments or payouts.</p>
    <p><a href="/waves/terms">Read the Waves Terms</a>.</p>
  </header>
  <section class="recap-stats wallet-stats" aria-label="Waves wallet totals">
    <div class="recap-stat wallet-balance"><span>Available balance</span><strong><%= wallet.balance.toLocaleString() %> Waves</strong></div>
    <div class="recap-stat wallet-earned"><span>Total earned</span><strong><%= wallet.totalEarned.toLocaleString() %></strong></div>
    <div class="recap-stat wallet-spent"><span>Total spent</span><strong><%= wallet.totalSpent.toLocaleString() %></strong></div>
  </section>
  <% if (locals.earnGuide && earnGuide.items.length) { %>
  <section class="recap-panel wallet-earn" id="earn">
    <div class="recap-section-heading"><div><p class="eyebrow"><%= locals.isWelcome ? 'Welcome to Crowdwide' : 'Earn Waves' %></p><h2><%= locals.isWelcome ? 'Your first Waves are here' : 'How to earn Waves' %></h2></div></div>
    <% if (locals.isWelcome && earnGuide.welcomeBonus > 0) { %><p class="wallet-welcome">🎉 We added <strong><%= earnGuide.welcomeBonus.toLocaleString() %> Waves</strong> to your wallet. Here is how to earn more:</p><% } else { %><p class="recap-muted">Waves are rewarded for taking part. Typical rewards per action:</p><% } %>
    <div class="wallet-earn-grid">
      <% earnGuide.items.forEach((item) => { %>
      <div class="wallet-earn-item"><span class="wallet-earn-icon"><%- icon(item.icon, { size: 18 }) %></span><div><strong><%= item.title %></strong><small><%= item.detail %></small></div><b>+<%= item.range %></b></div>
      <% }) %>
    </div>
    <p class="recap-muted">You can earn up to about <%= earnGuide.dailyLimit.toLocaleString() %> Waves a day from activity. Spend Waves on Ad-Free plans, boosting posts and promoting communities, or send them to friends.</p>
  </section>
  <% } %>
  <% const adFreeInfo = locals.adFree || { enabled: false, plans: [] }; %>
  <% if (adFreeInfo.enabled || adFreeInfo.active) { %>
  <section class="recap-panel wallet-adfree" id="ad-free">
    <div class="recap-section-heading"><div><p class="eyebrow">Waves premium</p><h2>Go Ad-Free</h2></div>
      <% if (adFreeInfo.active) { %><span class="wallet-adfree-status is-active"><%- icon('check', { size: 13 }) %> Active until <%= new Date(adFreeInfo.until).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span><% } %></div>
    <p class="recap-muted">Hide advertiser campaigns and sponsored posts in your feeds and communities. Buying again while active adds time to your plan.</p>
    <% if (adFreeInfo.enabled) { %>
    <div class="wallet-plan-grid">
      <% adFreeInfo.plans.forEach((plan) => { %>
      <form class="wallet-plan<%= plan.id === '4m' ? ' is-popular' : '' %>" method="post" action="/wallet/ad-free">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="plan" value="<%= plan.id %>">
        <% if (plan.savingsPercent > 0) { %><b class="wallet-plan-badge">Save <%= plan.savingsPercent %>%</b><% } %>
        <h3><%= plan.label %></h3>
        <p class="wallet-plan-price"><strong><%= plan.price.toLocaleString() %></strong> Waves</p>
        <button class="button <%= plan.id === '4m' ? 'button-primary' : 'button-ghost' %> button-small" type="submit" <%= wallet.balance < plan.price ? 'disabled' : '' %>><%= wallet.balance < plan.price ? 'Not enough Waves' : (adFreeInfo.active ? 'Extend' : 'Get Ad-Free') %></button>
      </form>
      <% }) %>
    </div>
    <% } %>
  </section>
  <% } %>
  <section class="recap-panel wallet-send">
    <div class="recap-section-heading"><div><p class="eyebrow">Send Waves</p><h2>Transfer to another user</h2></div></div>
    <form method="post" action="/wallet/transfer" class="admin-edit-form wallet-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Recipient username<input type="text" name="recipientUsername" minlength="3" maxlength="25" pattern="@?[A-Za-z0-9_]{3,24}" placeholder="@username" required autocomplete="off" autocapitalize="none" spellcheck="false"></label>
      <label>Amount in Waves<input type="number" name="amount" min="0.01" step="0.01" max="<%= wallet.balance %>" required></label>
      <div class="admin-edit-form-actions"><button class="button button-primary button-small" type="submit">Send Waves</button></div>
    </form>
    <% if (locals.username) { %><p class="recap-muted">Your username is <strong>@<%= username %></strong> — share it so others can send you Waves. <a href="/settings/profile">Change it</a>.</p><% } %>
    <p class="recap-muted">Transfers are subject to per-transfer and daily limits set by the platform.</p>
  </section>
  <section class="recap-panel">
    <div class="recap-section-heading"><div><p class="eyebrow">Wallet activity</p><h2>Recent transactions</h2></div><span class="recap-muted">Latest 50 entries</span></div>
    <% if (transactions.length) { %>
    <div class="wallet-table-wrap">
      <table class="admin-table wallet-table">
        <thead><tr><th>When</th><th>Activity</th><th>Details</th><th>Amount</th><th>Balance</th></tr></thead>
        <tbody>
          <% transactions.forEach((entry) => { %>
          <tr>
            <td data-label="When"><%= new Date(entry.createdAt).toLocaleString() %></td>
            <td data-label="Activity"><span class="wallet-type"><%= entry.type.replace(/-/g, ' ') %></span> · <span class="wallet-status"><%= entry.status %></span></td>
            <td data-label="Details"><%= entry.description || entry.reason || 'Waves transaction' %><% if (entry.community?.name) { %> · <a href="/communities/<%= entry.community.slug %>"><%= entry.community.name %></a><% } %><% if (entry.relatedUser?.name) { %> · <%= entry.relatedUser.name %><% } %></td>
            <td data-label="Amount" class="wallet-amount <%= entry.amount > 0 ? 'is-in' : 'is-out' %>"><%= entry.amount > 0 ? '+' : '' %><%= Number(entry.amount).toLocaleString() %></td>
            <td data-label="Balance"><%= Number(entry.balanceAfter || 0).toLocaleString() %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <p class="recap-empty">Your Waves transactions will appear here.</p>
    <% } %>
  </section>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
