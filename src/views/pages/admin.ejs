<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% const pendingMonetizationList = Array.isArray(locals.pendingMonetization) ? locals.pendingMonetization : []; %>
<% const pendingAdvertiserList = Array.isArray(locals.pendingAdvertisers) ? locals.pendingAdvertisers : []; %>
<% const pendingCampaignList = Array.isArray(locals.pendingCampaigns) ? locals.pendingCampaigns : []; %>
<% const managedCampaignList = Array.isArray(locals.managedCampaigns) ? locals.managedCampaigns : []; %>
<main class="explore-page admin-console admin-wide admin-modern"><%- include('../partials/flash') %>
  <header class="admin-page-header"><div><p class="eyebrow">Restricted operations</p><h1>Admin console</h1><p>Monitor the community, resolve reports, and manage platform settings.</p></div><span class="admin-access-badge"><%- icon('shield', { size: 15 }) %> Admin access</span></header>
  <div class="admin-stats" aria-label="Platform overview">
    <article class="admin-stat"><span>Community</span><strong><%= stats.users.toLocaleString() %></strong><small>users</small></article>
    <article class="admin-stat"><span>Content</span><strong><%= stats.posts.toLocaleString() %></strong><small>posts</small></article>
    <article class="admin-stat"><span>Spaces</span><strong><%= stats.communities.toLocaleString() %></strong><small>communities</small></article>
    <article class="admin-stat"><span>Safety</span><strong><%= stats.reports.toLocaleString() %></strong><small>reports</small></article>
    <article class="admin-stat admin-stat-attention"><span>Action needed</span><strong><%= pendingActions.length.toLocaleString() %></strong><small>pending approvals</small></article>
  </div>

  <nav class="admin-tabs" role="tablist" aria-label="Admin sections">
    <button type="button" class="admin-tab" id="admin-tab-overview" role="tab" aria-controls="admin-panel-overview" data-tab="overview">Overview</button>
    <button type="button" class="admin-tab" id="admin-tab-users" role="tab" aria-controls="admin-panel-users" data-tab="users">Users</button>
    <button type="button" class="admin-tab" id="admin-tab-posts" role="tab" aria-controls="admin-panel-posts" data-tab="posts">Posts</button>
    <button type="button" class="admin-tab" id="admin-tab-communities" role="tab" aria-controls="admin-panel-communities" data-tab="communities">Communities</button>
    <button type="button" class="admin-tab" id="admin-tab-advertisers" role="tab" aria-controls="admin-panel-advertisers" data-tab="advertisers">Advertisers<% if (pendingAdvertiserList.length) { %> (<%= pendingAdvertiserList.length %>)<% } %></button>
    <button type="button" class="admin-tab" id="admin-tab-campaigns" role="tab" aria-controls="admin-panel-campaigns" data-tab="campaigns">Campaigns<% if (pendingCampaignList.length) { %> (<%= pendingCampaignList.length %> pending)<% } %></button>
    <button type="button" class="admin-tab" id="admin-tab-reports" role="tab" aria-controls="admin-panel-reports" data-tab="reports">Reports<% if (openReports.length) { %> (<%= openReports.length %>)<% } %></button>
    <button type="button" class="admin-tab" id="admin-tab-appeals" role="tab" aria-controls="admin-panel-appeals" data-tab="appeals">Appeals<% if (pendingAppeals.length) { %> (<%= pendingAppeals.length %>)<% } %></button>
    <button type="button" class="admin-tab" id="admin-tab-queue" role="tab" aria-controls="admin-panel-queue" data-tab="queue">Approval queue<% if (pendingActions.length) { %> (<%= pendingActions.length %>)<% } %></button>
    <button type="button" class="admin-tab" id="admin-tab-moderators" role="tab" aria-controls="admin-panel-moderators" data-tab="moderators">Moderators</button>
    <button type="button" class="admin-tab" id="admin-tab-settings" role="tab" aria-controls="admin-panel-settings" data-tab="settings">Site settings</button>
    <button type="button" class="admin-tab" id="admin-tab-maintenance" role="tab" aria-controls="admin-panel-maintenance" data-tab="maintenance">Data cleanup</button>
    <button type="button" class="admin-tab" id="admin-tab-audit" role="tab" aria-controls="admin-panel-audit" data-tab="audit">Audit log</button>
  </nav>

  <!-- OVERVIEW -->
  <section class="admin-panel" id="admin-panel-overview" role="tabpanel" aria-labelledby="admin-tab-overview" data-panel="overview">
    <div class="settings-block admin-wide">
      <h2>What needs attention</h2>
      <p><%= pendingActions.length %> moderator action<%= pendingActions.length === 1 ? '' : 's' %> waiting for your approval, <%= openReports.length %> open report<%= openReports.length === 1 ? '' : 's' %>, <%= pendingAppeals.length %> pending appeal<%= pendingAppeals.length === 1 ? '' : 's' %>.</p>
      <% if (siteSettings.maintenanceMode) { %><p class="admin-badge status-suspended">Maintenance mode is ON — the site is showing a maintenance message to visitors.</p><% } %>
    </div>
    <% const rewardSignals = Array.isArray(locals.suspiciousRewardPairs) ? locals.suspiciousRewardPairs : []; %>
    <% const economyRows = Array.isArray(locals.wavesEconomy) ? locals.wavesEconomy : []; %>
    <% const heldWavesAccounts = Array.isArray(locals.heldWavesUsers) ? locals.heldWavesUsers : []; %>
    <% const repeatedAdEvents = Array.isArray(locals.suspiciousAdEvents) ? locals.suspiciousAdEvents : []; %>
    <% const transferSignals = Array.isArray(locals.suspiciousWavesTransfers) ? locals.suspiciousWavesTransfers : []; %>
    <% const communityAdShares = Array.isArray(locals.communityAdShares) ? locals.communityAdShares : []; %>
    <% const pendingCommunityAdShares = Array.isArray(locals.pendingCommunityShares) ? locals.pendingCommunityShares : []; %>
    <section class="settings-block admin-wide">
      <h2>Waves activity · last 30 days</h2>
      <% if (!economyRows.length) { %><p>No posted Waves ledger activity in the last 30 days.</p><% } %>
      <div class="admin-stats" aria-label="Waves economy totals">
        <% economyRows.forEach((row) => { %><article class="admin-stat"><span><%= row._id.replace(/-/g, ' ') %></span><strong><%= Number(row.entries || 0).toLocaleString() %></strong><small>entries · net <%= Number(row.netWaves || 0).toLocaleString() %> Waves</small></article><% }) %>
      </div>
      <h3>Temporary Waves holds</h3>
      <% if (!heldWavesAccounts.length) { %><p>No accounts currently have a Waves hold.</p><% } %>
      <% heldWavesAccounts.forEach((heldUser) => { %><div class="device-row"><div><strong><%= heldUser.name %> · <%= heldUser.email %></strong><span><%= Number(heldUser.wavesBalance || 0).toLocaleString() %> Waves · held until <%= new Date(heldUser.wavesSuspendedUntil).toLocaleString() %></span><small><%= heldUser.wavesSuspensionReason || 'No reason recorded' %></small></div></div><% }) %>
      <p>Holds are review controls, not automatic findings or proof of abuse. Adjust or lift them from the user management panel.</p>
    </section>
    <section class="settings-block admin-wide">
      <h2>Community ad shares · lifetime</h2>
      <p>These are internal Waves credited from eligible, deduplicated community campaign spend. Crowdwide does not receive real-money ad payments or process cash payouts.</p>
      <% if (!communityAdShares.length) { %><p>No community ad shares have been credited.</p><% } %>
      <% communityAdShares.forEach((row) => { %>
      <% if (row.community) { %>
      <div class="device-row">
        <div><strong><a href="/communities/<%= row.community.slug %>"><%= row.community.name %></a> · owner <%= row.community.owner?.name || 'unknown' %></strong><span><%= Number(row.entries || 0).toLocaleString() %> credited events · <%= Number(row.totalWaves || 0).toLocaleString() %> Waves · last <%= new Date(row.lastEarnedAt).toLocaleString() %></span></div>
      </div>
      <% } %>
      <% }) %>
    </section>
    <section class="settings-block admin-wide">
      <h2>Pending community Waves shares</h2>
      <p>Pending entries are retained for retry if an owner account was temporarily ineligible or a credit could not be finalized.</p>
      <% if (!pendingCommunityAdShares.length) { %><p>No community ad shares are pending.</p><% } %>
      <% pendingCommunityAdShares.forEach((event) => { %>
      <div class="device-row">
        <div><strong><%= event.community?.name || 'Community' %> · <%= event.communityOwner?.name || 'Owner account unavailable' %></strong><span><%= event.campaign?.title || 'Campaign' %> · <%= Number(event.communityOwnerShareWaves || 0).toLocaleString() %> Waves · <%= event.eventType %> · <%= new Date(event.createdAt).toLocaleString() %></span></div>
        <form method="post" action="/admin/community-ad-shares/<%= event._id %>/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-primary" type="submit">Retry credit</button></form>
      </div>
      <% }) %>
    </section>
    <section class="settings-block admin-wide">
      <h2>Suspicious Waves transfer activity</h2>
      <p>Repeated outgoing transfers (five or more in ten minutes, or four to the same recipient) are queued for review only. These patterns can have legitimate causes and do not trigger automatic account restrictions.</p>
      <% if (!transferSignals.length) { %><p>No Waves transfer signals are waiting for review.</p><% } %>
      <% transferSignals.forEach((signal) => { %><div class="device-row"><div><strong><%= signal.sender?.name || 'Account' %> · <%= signal.sender?.email || '' %></strong><span><%= Number(signal.transferCount || 0).toLocaleString() %> transfers · <%= Number(signal.totalWaves || 0).toLocaleString() %> Waves<% if (signal.recipient) { %> · recipient: <%= signal.recipient.name %> (<%= signal.recipient.email %>)<% } %> · last seen <%= new Date(signal.lastSeenAt).toLocaleString() %></span><small><%= signal.reason %></small></div><form method="post" action="/admin/waves-abuse/<%= signal._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Review note<input name="reviewNote" maxlength="500" required></label><button class="button button-small button-primary" type="submit">Mark reviewed</button></form></div><% }) %>
    </section>
    <section class="settings-block admin-wide">
      <h2>Advertisement abuse and bot-activity signals</h2>
      <p>Daily duplicate events are excluded from advertiser totals. High-volume activity (20 or more unique ad events in one minute) is flagged for review only. Signals are not proof of bot or coordinated activity and do not trigger automatic penalties.</p>
      <% if (!repeatedAdEvents.length) { %><p>No advertisement signals are waiting for review.</p><% } %>
      <% repeatedAdEvents.forEach((signal) => { %><div class="device-row"><div><strong><%= signal.eventType === 'bot-activity' ? 'Possible bot activity' : signal.eventType %> · <%= signal.campaign?.title || 'Campaign' %></strong><span><%= signal.viewer?.name || 'Member' %> · <%= signal.community?.name || 'Community' %> · <%= Number(signal.attempts || 0).toLocaleString() %> flagged events/attempts · last seen <%= new Date(signal.lastSeenAt).toLocaleString() %></span><small><%= signal.reason %></small></div><form method="post" action="/admin/ad-abuse/<%= signal._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Review note<input name="reviewNote" maxlength="500" required></label><button class="button button-small button-primary" type="submit">Mark reviewed</button></form></div><% }) %>
    </section>
    <section class="settings-block admin-wide">
      <h2>Possible coordinated Waves rewards</h2>
      <p>Behavior-only review signals: reciprocal rewarded likes/comments across multiple posts and days. These are leads, not proof of linked accounts; no automatic account action is taken.</p>
      <% if (!rewardSignals.length) { %><p>No account pairs currently meet the review threshold.</p><% } %>
      <% rewardSignals.forEach((signal) => { %>
      <div class="device-row">
        <div>
          <strong><%= signal.accountA.name %> · <%= signal.accountB.name %></strong>
          <span><%= signal.totalRewards %> rewarded engagements across <%= signal.uniqueTargets %> posts on <%= signal.activeDays %> days · <%= signal.totalWaves.toLocaleString() %> Waves</span>
          <small><%= signal.accountA.name %> → <%= signal.accountB.name %>: <%= signal.rewardsFromA %> · <%= signal.accountB.name %> → <%= signal.accountA.name %>: <%= signal.rewardsFromB %></small>
        </div>
      </div>
      <% }) %>
    </section>
    <section class="settings-block admin-wide admin-storage-card" aria-labelledby="admin-storage-heading">
      <div class="admin-storage-heading">
        <div><p class="eyebrow">MongoDB clusters</p><h2 id="admin-storage-heading">Database storage</h2></div>
        <% if (mongoStorage.available) { %><strong class="admin-storage-percent"><%= mongoStorage.percentUsed %>% used · <%= mongoStorage.percentRemaining %>% left</strong><% } %>
      </div>
      <% if (mongoStorage.available) { %>
      <div class="admin-storage-meter<%= mongoStorage.percentUsed >= 80 ? ' is-near-limit' : '' %>" role="meter" aria-label="MongoDB filesystem storage used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= mongoStorage.barPercent %>" aria-valuetext="<%= mongoStorage.percentUsed %>% used, <%= mongoStorage.percentRemaining %>% left">
        <span style="width:<%= mongoStorage.barPercent %>%"></span>
      </div>
      <div class="admin-storage-values"><strong><%= formatStorage(mongoStorage.usedBytes) %> / <%= formatStorage(mongoStorage.capacityBytes) %></strong><span><%= formatStorage(mongoStorage.remainingBytes) %> remaining across <%= mongoStorage.clusters %> cluster<%= mongoStorage.clusters === 1 ? '' : 's' %></span></div>
      <p class="admin-storage-footnote">Combined filesystem figures reported by the configured MongoDB URLs; an Atlas plan quota may differ.</p>
      <% } else { %>
      <p class="admin-storage-message">MongoDB did not report filesystem usage and capacity for every configured cluster, so a combined storage percentage cannot be calculated. Check the application logs and cluster connections.</p>
      <% } %>
    </section>
  </section>

  <!-- USERS -->
  <section class="admin-panel" id="admin-panel-users" role="tabpanel" aria-labelledby="admin-tab-users" data-panel="users">
    <div class="admin-section-head"><h2>Users</h2><input class="admin-search" type="search" placeholder="Filter by name or email" data-filter-table="users-table"></div>
    <table class="admin-table" id="users-table">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Verified</th><th>Status</th><th>Joined</th><th></th></tr></thead>
      <tbody>
      <% users.forEach((user) => { %>
        <tr data-row-text="<%= (user.name + ' ' + user.email).toLowerCase() %>">
          <td data-label="Name"><strong><%= user.name %></strong><% if (user.moderatorId) { %><br><span style="color:var(--tx-faint)"><%= user.moderatorId %></span><% } %></td>
          <td data-label="Email"><%= user.email %></td>
          <td data-label="Role"><span class="admin-badge role-<%= user.role %>"><%= user.role %></span></td>
          <td data-label="Verified"><%= user.isVerified ? 'Yes' : 'No' %></td>
          <td data-label="Status"><% if (user.suspendedUntil && new Date(user.suspendedUntil) > new Date()) { %><span class="admin-badge status-suspended">Suspended</span><% } else if (user.postingRestrictedUntil && new Date(user.postingRestrictedUntil) > new Date()) { %><span class="admin-badge status-suspended">Posting restricted</span><% } else { %>Active<% } %><% if (user.warnings?.length) { %> · <%= user.warnings.length %> warning<%= user.warnings.length === 1 ? '' : 's' %><% } %></td>
          <td data-label="Joined"><%= new Date(user.createdAt).toLocaleDateString() %></td>
          <td><button type="button" class="admin-row-toggle" data-edit-toggle="user-edit-<%= user._id %>">Edit</button></td>
        </tr>
        <tr class="admin-editrow" id="user-edit-<%= user._id %>">
          <td colspan="7">
            <form class="admin-edit-form" method="post" action="/admin/users/<%= user._id %>/edit">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label>Name<input type="text" name="name" value="<%= user.name %>"></label>
              <label>Email<input type="email" name="email" value="<%= user.email %>"></label>
              <label>Role<select name="role" <%= String(user._id) === String(currentUser.id) ? 'disabled' : '' %>>
                <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
                <option value="moderator" <%= user.role === 'moderator' ? 'selected' : '' %>>Moderator</option>
                <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
              </select></label>
              <label class="checkbox-field"><input type="checkbox" name="isVerified" <%= user.isVerified ? 'checked' : '' %>> Verified</label>
              <% if (String(user._id) !== String(currentUser.id)) { %>
              <% if (user.suspendedUntil && new Date(user.suspendedUntil) > new Date()) { %>
              <p class="full-width" style="margin:0;font-size:11px;color:var(--ac-orange);">Currently suspended until <%= new Date(user.suspendedUntil).toLocaleString() %>.</p>
              <% } %>
              <label>Suspension
                <select name="suspend">
                  <option value="">No change</option>
                  <option value="on">Suspend (default length)</option>
                  <option value="off">Lift suspension</option>
                </select>
              </label>
              <label>Custom suspension end date<input type="datetime-local" name="suspendUntil" min="<%= new Date(Date.now() + 60000).toISOString().slice(0, 16) %>"></label>
              <label class="full-width">Suspension reason (shown to admins only)<input type="text" name="suspensionReason" value="<%= user.suspensionReason || '' %>"></label>
              <label>Posting restriction
                <select name="postingRestriction">
                  <option value="">No change</option>
                  <option value="24h">Restrict 24 hours</option>
                  <option value="72h">Restrict 3 days</option>
                  <option value="7d">Restrict 7 days</option>
                  <option value="off">Lift restriction</option>
                </select>
              </label>
              <label class="full-width">Restriction reason (shown to admins only)<input type="text" name="postingRestrictionReason" value="<%= user.postingRestrictionReason || '' %>"></label>
              <label>Waves adjustment<input type="number" step="1" name="wavesAdjustment" placeholder="e.g. 50 or -25"></label>
              <label class="full-width">Waves reason<input type="text" name="wavesAdjustmentReason" placeholder="Reason to log in the ledger"></label>
              <label>Waves activity hold
                <select name="wavesHold">
                  <option value="">No change<% if (user.wavesSuspendedUntil && new Date(user.wavesSuspendedUntil) > new Date()) { %> · currently held until <%= new Date(user.wavesSuspendedUntil).toLocaleString() %><% } %></option>
                  <option value="24h">Hold for 24 hours</option>
                  <option value="72h">Hold for 3 days</option>
                  <option value="7d">Hold for 7 days</option>
                  <option value="off">Lift Waves hold</option>
                </select>
              </label>
              <label class="full-width">Waves hold reason<input type="text" name="wavesSuspensionReason" value="<%= user.wavesSuspensionReason || '' %>" placeholder="Required for a hold"></label>
              <% } %>
              <div class="admin-edit-form-actions">
                <button class="button button-small button-primary" type="submit">Save</button>
              </div>
            </form>
            <% if (String(user._id) !== String(currentUser.id) && user.role !== 'admin') { %>
            <form method="post" action="/admin/users/<%= user._id %>/delete" data-confirm="Permanently delete this user and their posts?" style="margin-top:8px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-small button-danger" type="submit">Delete user</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>

  <!-- POSTS -->
  <section class="admin-panel" id="admin-panel-posts" role="tabpanel" aria-labelledby="admin-tab-posts" data-panel="posts">
    <div class="admin-section-head"><h2>Posts</h2><input class="admin-search" type="search" placeholder="Filter by author or text" data-filter-table="posts-table"></div>
    <table class="admin-table" id="posts-table">
      <thead><tr><th>Author</th><th>Body</th><th>Type</th><th>Status</th><th>Moderation</th><th>Community</th><th></th></tr></thead>
      <tbody>
      <% posts.forEach((post) => { %>
        <tr data-row-text="<%= ((post.author?.name || '') + ' ' + (post.body || '')).toLowerCase() %>">
          <td data-label="Author"><a class="name-link" href="/u/<%= post.author?._id %>"><%= post.author?.name || 'Unknown' %></a></td>
          <td data-label="Body"><%= (post.body || '').slice(0, 90) %><%= (post.body || '').length > 90 ? '…' : '' %></td>
          <td data-label="Type"><%= post.type %></td>
          <td data-label="Status"><%= post.status %></td>
          <td data-label="Moderation"><span class="admin-badge status-<%= post.moderationStatus %>"><%= post.moderationStatus %></span> (<%= post.moderationScore || 0 %>)</td>
          <td data-label="Community"><%= post.community?.name || 'Open Crowdwide' %></td>
          <td><a class="admin-row-toggle" href="/posts/<%= post._id %>" target="_blank" rel="noopener">View</a> <button type="button" class="admin-row-toggle" data-edit-toggle="post-edit-<%= post._id %>">Edit</button></td>
        </tr>
        <tr class="admin-editrow" id="post-edit-<%= post._id %>">
          <td colspan="7">
            <form class="admin-edit-form" method="post" action="/admin/posts/<%= post._id %>/edit">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="full-width">Body<textarea name="body"><%= post.body %></textarea></label>
              <label>Status<select name="status">
                <% ['draft','scheduled','published','pending','rejected'].forEach((s) => { %><option value="<%= s %>" <%= post.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
              </select></label>
              <label>Moderation status<select name="moderationStatus">
                <% ['unreviewed','good','needs-review','reported'].forEach((s) => { %><option value="<%= s %>" <%= post.moderationStatus === s ? 'selected' : '' %>><%= s %></option><% }) %>
              </select></label>
              <label>Content warning<input type="text" name="contentWarning" value="<%= post.contentWarning || '' %>"></label>
              <% if (post.community) { %><label>Community pin<select name="pinToCommunity">
                <option value="off" <%= pinnedPostIds.has(String(post._id)) ? '' : 'selected' %>>Not pinned</option>
                <option value="on" <%= pinnedPostIds.has(String(post._id)) ? 'selected' : '' %>>Pinned</option>
              </select></label><% } %>
              <div class="admin-edit-form-actions">
                <button class="button button-small button-primary" type="submit">Save</button>
              </div>
            </form>
            <form method="post" action="/admin/posts/<%= post._id %>/delete" data-confirm="Delete this post?" style="margin-top:8px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-small button-danger" type="submit">Delete post</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>

  <!-- ADVERTISERS -->
  <section class="admin-panel" id="admin-panel-advertisers" role="tabpanel" aria-labelledby="admin-tab-advertisers" data-panel="advertisers">
    <h2>Advertiser applications</h2>
    <p>Moderator screening is required before final admin approval. Applications waiting for moderator review are shown here with their submitted business details.</p>
    <% if (!pendingAdvertiserList.length) { %><p>No advertiser applications are waiting for review.</p><% } %>
    <% if (pendingAdvertiserList.length) { %>
    <section class="settings-block">
      <% pendingAdvertiserList.forEach((advertiser) => { %>
      <article class="device-row advertiser-application-card" style="flex-direction:column;align-items:stretch;">
        <% if (advertiser.bannerUrl) { %><img class="advertiser-application-banner" src="<%= advertiser.bannerUrl %>" alt="<%= advertiser.businessName %> banner" loading="lazy"><% } %>
        <div class="advertiser-application-identity">
          <% if (advertiser.logoUrl) { %><img class="advertiser-application-logo" src="<%= advertiser.logoUrl %>" alt="<%= advertiser.businessName %> logo" loading="lazy"><% } %>
          <div><strong><%= advertiser.businessName %></strong><span><%= advertiser.user?.name || 'unknown' %> · <%= advertiser.user?.email || '' %></span></div>
        </div>
        <% if (advertiser.businessDescription) { %><p><%= advertiser.businessDescription %></p><% } %>
        <% if (advertiser.website) { %><p><a href="<%= advertiser.website %>" rel="nofollow noopener noreferrer"><%= advertiser.website %></a></p><% } %>
        <% if (advertiser.notes) { %><p>Additional information: <%= advertiser.notes %></p><% } %>
        <p>Application status: <strong><%= advertiser.moderatorReview?.status === 'cleared' ? 'Awaiting admin decision' : advertiser.moderatorReview?.status === 'flagged' ? 'Flagged by moderator' : 'Awaiting moderator screening' %></strong></p>
        <p>Advertising Terms: <%= advertiser.termsVersion || 'not accepted' %><% if (advertiser.termsAcceptedAt) { %> · <%= new Date(advertiser.termsAcceptedAt).toLocaleString() %><% } %></p>
        <p>Moderator review: <strong><%= advertiser.moderatorReview?.status || 'pending' %></strong><% if (advertiser.moderatorReview?.reason) { %> · <%= advertiser.moderatorReview.reason %><% } %></p>
          <details><summary>Advertiser review history (<%= (advertiser.moderationHistory || []).length %>)</summary>
            <% (advertiser.moderationHistory || []).slice().reverse().forEach((event) => { %><p><strong><%= event.status.replace(/-/g, ' ') %></strong> · <%= new Date(event.createdAt).toLocaleString() %> · <%= event.actor?.name || 'Staff' %><% if (event.reason) { %><br><%= event.reason %><% } %></p><% }) %>
          </details>
        <div class="advertiser-review-actions">
          <% if (advertiser.moderatorReview?.status === 'cleared') { %>
          <form method="post" action="/admin/advertisers/<%= advertiser._id %>/review">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button-small button-primary" name="decision" value="approved" type="submit">Approve and verify advertiser</button>
          </form>
          <% } else if (advertiser.moderatorReview?.status === 'flagged') { %>
          <p>Moderator flagged this application. Read the reason and history before deciding.</p>
          <% } else { %>
          <p>Awaiting moderator screening. The Approve button appears here after a moderator clears the application.</p>
          <% } %>
          <form method="post" action="/admin/advertisers/<%= advertiser._id %>/review" class="advertiser-reject-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>Rejection reason<input type="text" name="reason" maxlength="500" placeholder="Required to reject" required></label>
            <button class="button button-small button-danger" name="decision" value="rejected" type="submit">Reject application</button>
          </form>
        </div>
      </article>
      <% }) %>
    </section>
    <% } %>
  </section>

  <!-- CAMPAIGNS -->
  <section class="admin-panel" id="admin-panel-campaigns" role="tabpanel" aria-labelledby="admin-tab-campaigns" data-panel="campaigns">
    <h2>Advertisement campaigns</h2>
    <p>Campaigns cleared or flagged by moderators wait here for your final decision. Approved campaigns still need advertiser activation before they can serve.</p>
    <% if (!pendingCampaignList.length) { %><p>No campaign decisions are waiting for admin review.</p><% } %>
    <% if (pendingCampaignList.length) { %>
    <section class="settings-block">
      <h3>Campaign review queue (<%= pendingCampaignList.length %>)</h3>
      <% pendingCampaignList.forEach((campaign) => { %>
      <article class="device-row" style="flex-direction:column;align-items:stretch;">
        <div>
          <strong><%= campaign.campaignType === 'product' ? (campaign.productName || campaign.title) : campaign.title %></strong>
          <span><%= (campaign.campaignType || 'other').replace(/-/g, ' ') %> · <%= campaign.advertiser?.businessName || 'Advertiser' %> · <%= campaign.advertiser?.user?.email || '' %></span>
          <% if (campaign.campaignType === 'product' && campaign.productPrice) { %><p>Advertiser-displayed price: <%= campaign.productPrice %></p><% } %>
          <p><%= campaign.description || 'No ad details provided.' %></p>
          <% if (campaign.bannerUrl) { %><img src="<%= campaign.bannerUrl %>" alt="Campaign banner for <%= campaign.productName || campaign.title %>" style="display:block;max-width:100%;max-height:180px;object-fit:contain;margin:8px 0;"><% } %>
          <% if (campaign.destinationUrl) { %><p>Ad destination: <a href="<%= campaign.destinationUrl %>" rel="nofollow noopener noreferrer"><%= campaign.destinationUrl %></a></p><% } %>
          <p>Budget: <%= Number(campaign.totalBudget || 0).toLocaleString() %> Waves · Daily: <%= Number(campaign.dailyBudget || 0).toLocaleString() %> · <%= campaign.sitewideFallback ? 'normal-feed fallback (only while no public community is monetized)' : `Targets: ${(campaign.targetCommunities || []).length} communities` %></p>
          <p>Rates: <%= Number(campaign.impressionCostWaves ?? 0.1) %> Waves/impression · <%= Number(campaign.clickCostWaves ?? 1) %> Waves/click</p>
          <p>Moderator review: <strong><%= campaign.moderatorReview?.status || 'pending' %></strong> · <%= campaign.moderatorReview?.reason || '' %><% if (campaign.moderatorReview?.reviewedBy?.name) { %> · <%= campaign.moderatorReview.reviewedBy.name %><% } %><% if (campaign.moderatorReview?.reviewedAt) { %> · <%= new Date(campaign.moderatorReview.reviewedAt).toLocaleString() %><% } %><% if (campaign.moderatorReview?.flaggedCategory) { %> · category: <%= campaign.moderatorReview.flaggedCategory %><% } %><% if (campaign.moderatorReview?.policyChecks?.length) { %> · checks confirmed: <%= campaign.moderatorReview.policyChecks.join(', ') %><% } %></p>
          <p>Rights attestation: <%= campaign.rightsConfirmedAt ? `confirmed ${new Date(campaign.rightsConfirmedAt).toLocaleString()}` : 'not recorded for this legacy campaign' %></p>
          <p>Advertising Terms: <%= campaign.advertiser?.termsVersion || 'not accepted' %><% if (campaign.advertiser?.termsAcceptedAt) { %> · <%= new Date(campaign.advertiser.termsAcceptedAt).toLocaleString() %><% } %></p>
          <details><summary>Campaign review history (<%= (campaign.moderationHistory || []).length %>)</summary>
            <% (campaign.moderationHistory || []).slice().reverse().forEach((event) => { %><p><strong><%= event.status.replace(/-/g, ' ') %></strong> · <%= new Date(event.createdAt).toLocaleString() %> · <%= event.actor?.name || 'Staff' %><% if (event.reason) { %><br><%= event.reason %><% } %></p><% }) %>
          </details>
        </div>
        <form method="post" action="/admin/campaigns/<%= campaign._id %>/review" style="display:flex;gap:8px;flex-wrap:wrap;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="reason" maxlength="500" placeholder="Reason (required for reject)" style="flex:1;min-width:180px;">
          <% if (campaign.moderatorReview?.status === 'cleared') { %><button class="button button-small button-primary" name="decision" value="approved" type="submit">Approve campaign</button><% } %>
          <button class="button button-small button-danger" name="decision" value="rejected" type="submit">Reject and refund</button>
        </form>
      </article>
      <% }) %>
    </section>
    <% } %>
    <% if (managedCampaignList.length) { %>
    <section class="settings-block">
      <h3>Approved campaign management</h3>
      <p>Suspend a campaign to immediately stop delivery while keeping its remaining Waves held. Removal cancels it and refunds any unused funded balance. Reinstated campaigns return as approved and require advertiser activation.</p>
      <% managedCampaignList.forEach((campaign) => { %>
      <article class="device-row" style="flex-direction:column;align-items:stretch;">
        <div>
          <strong><%= campaign.campaignType === 'product' ? (campaign.productName || campaign.title) : campaign.title %></strong>
          <span><%= (campaign.campaignType || 'other').replace(/-/g, ' ') %> · <%= campaign.status %> · <%= campaign.advertiser?.businessName || 'Advertiser' %> · <%= campaign.advertiser?.user?.email || '' %></span>
          <% if (campaign.campaignType === 'product' && campaign.productPrice) { %><p>Advertiser-listed price: <%= campaign.productPrice %></p><% } %>
          <p><%= campaign.description || 'No description provided.' %></p>
          <p><%= Number(campaign.remainingBudget || 0).toLocaleString() %> Waves remaining · <%= Number(campaign.wavesSpent || 0).toLocaleString() %> Waves spent · <%= campaign.sitewideFallback ? 'normal-feed fallback' : `${(campaign.targetCommunities || []).length} target communities` %></p>
          <% if (campaign.suspensionReason) { %><p>Suspension reason: <%= campaign.suspensionReason %></p><% } %>
          <details><summary>Campaign review history (<%= (campaign.moderationHistory || []).length %>)</summary>
            <% (campaign.moderationHistory || []).slice().reverse().forEach((event) => { %><p><strong><%= event.status.replace(/-/g, ' ') %></strong> · <%= new Date(event.createdAt).toLocaleString() %> · <%= event.actor?.name || 'Staff' %><% if (event.reason) { %><br><%= event.reason %><% } %></p><% }) %>
          </details>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <% if (campaign.status === 'suspended') { %>
          <form method="post" action="/admin/campaigns/<%= campaign._id %>/manage" style="display:flex;gap:6px;flex:1 1 280px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="reason" maxlength="500" placeholder="Reinstatement reason" required style="flex:1;min-width:160px;">
            <button class="button button-small button-primary" name="action" value="reinstate" type="submit">Reinstate</button>
          </form>
          <% } else { %>
          <form method="post" action="/admin/campaigns/<%= campaign._id %>/manage" style="display:flex;gap:6px;flex:1 1 280px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="reason" maxlength="500" placeholder="Suspension reason" required style="flex:1;min-width:160px;">
            <button class="button button-small button-danger" name="action" value="suspend" type="submit">Suspend</button>
          </form>
          <% } %>
          <form method="post" action="/admin/campaigns/<%= campaign._id %>/manage" data-confirm="Remove this campaign and refund its unused funded Waves?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="reason" maxlength="500" placeholder="Removal reason" required>
            <button class="button button-small button-danger" name="action" value="remove" type="submit">Remove campaign</button>
          </form>
        </div>
      </article>
      <% }) %>
    </section>
    <% } %>
    <% if (!pendingCampaignList.length && !managedCampaignList.length) { %><p>No campaign review or management items right now.</p><% } %>
  </section>

  <!-- COMMUNITIES -->
  <section class="admin-panel" id="admin-panel-communities" role="tabpanel" aria-labelledby="admin-tab-communities" data-panel="communities">
    <h2>Communities</h2>
    <% if (pendingMonetizationList.length) { %>
    <section class="settings-block">
      <h3>Monetization applications</h3>
      <% pendingMonetizationList.forEach((community) => { %>
      <div class="device-row" style="flex-direction:column;align-items:stretch;">
        <div>
          <strong><%= community.name %></strong>
          <span>Owner <%= community.owner?.name || 'unknown' %> · submitted <%= new Date(community.monetizationApplication?.submittedAt || community.createdAt).toLocaleDateString() %></span>
          <p><%= community.monetizationApplication?.goals || 'No goals provided yet.' %></p>
          <p>Moderator screening: <strong><%= community.monetizationModeratorReview?.status || 'not reviewed' %></strong> · <%= community.monetizationModeratorReview?.reason || '' %></p>
          <% if (community.monetizationApplication?.appealStatus === 'pending') { %><p><strong>Appeal filed:</strong> <%= community.monetizationApplication.appealMessage %></p><% } %>
        </div>
        <form method="post" action="/admin/communities/<%= community._id %>/monetization" style="display:flex;gap:8px;flex-wrap:wrap;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Owner Waves share (%)<input type="number" name="revenueSharePercent" min="0" max="100" step="0.01" value="<%= community.monetizationSettings?.revenueSharePercent ?? 50 %>" required></label>
          <label class="checkbox-field"><input type="checkbox" name="adsEnabled"> Enable ads after approval</label>
          <label>Ad placement<select name="adPlacement"><option value="feed">Feed</option><option value="sidebar">Sidebar</option><option value="all">Feed and sidebar</option></select></label>
          <label>Show after every<input type="number" name="adFrequency" min="1" max="10" step="1" value="1" style="max-width:90px;"> posts</label>
          <input type="text" name="note" placeholder="Decision note (optional)" style="flex:1;min-width:140px;">
          <% if (community.monetizationApplication?.appealStatus === 'pending') { %>
          <button class="button button-small button-primary" name="decision" value="approve-appeal" type="submit">Approve appeal</button>
          <button class="button button-small button-danger" name="decision" value="deny-appeal" type="submit">Deny appeal</button>
          <% } else { %>
          <button class="button button-small button-primary" name="decision" value="approve" type="submit" <%= community.monetizationModeratorReview?.status === 'cleared' ? '' : 'disabled' %>>Approve</button>
          <button class="button button-small button-ghost" name="decision" value="reject" type="submit" <%= ['cleared', 'flagged'].includes(community.monetizationModeratorReview?.status) ? '' : 'disabled' %>>Reject</button>
          <% } %>
          <button class="button button-small button-danger" name="decision" value="pause" type="submit">Pause</button>
        </form>
      </div>
      <% }) %>
    </section>
    <% } %>
    <table class="admin-table">
      <thead><tr><th>Name</th><th>Owner</th><th>Members</th><th>Privacy</th><th>Monetization</th><th></th></tr></thead>
      <tbody>
      <% communities.forEach((community) => { %>
        <tr>
          <td data-label="Name"><strong><%= community.name %></strong></td>
          <td data-label="Owner"><%= community.owner?.name || 'unknown' %></td>
          <td data-label="Members"><%= community.membersCount %></td>
          <td data-label="Privacy"><%= community.isPrivate ? 'Private' : 'Public' %> · <%= community.requireApproval ? 'approval on' : 'approval off' %></td>
          <td data-label="Monetization"><%= community.monetizationStatus || 'none' %></td>
          <td><button type="button" class="admin-row-toggle" data-edit-toggle="community-edit-<%= community._id %>">Edit</button></td>
        </tr>
        <tr class="admin-editrow" id="community-edit-<%= community._id %>">
          <td colspan="6">
            <form class="admin-edit-form" method="post" action="/admin/communities/<%= community._id %>/edit">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label>Name<input type="text" name="name" value="<%= community.name %>"></label>
              <label>Category<select name="category">
                <% if (!communityCategories.some((category) => category.value === community.category)) { %><option value="<%= community.category %>" selected><%= community.category %> (existing category)</option><% } %>
                <% communityCategories.forEach((category) => { %><option value="<%= category.value %>" <%= community.category === category.value ? 'selected' : '' %>><%= category.label %></option><% }) %>
              </select></label>
              <label class="full-width">Description<textarea name="description"><%= community.description %></textarea></label>
              <label class="full-width">Guidelines<textarea name="guidelines"><%= community.guidelines || '' %></textarea></label>
              <label class="full-width">Banned words (comma separated)<input type="text" name="bannedWords" value="<%= (community.bannedWords || []).join(', ') %>"></label>
              <label class="checkbox-field"><input type="checkbox" name="isPrivate" <%= community.isPrivate ? 'checked' : '' %>> Private</label>
              <label class="checkbox-field"><input type="checkbox" name="requireApproval" <%= community.requireApproval ? 'checked' : '' %>> Require post approval</label>
              <% if (community.monetizationStatus === 'approved' && community.isMonetized) { %>
              <fieldset class="full-width">
                <legend>Community advertising</legend>
                <input type="hidden" name="updateAdvertisingSettings" value="on">
                <label class="checkbox-field"><input type="checkbox" name="adsEnabled" <%= community.monetizationSettings?.adsEnabled ? 'checked' : '' %>> Ads enabled (uncheck to pause ads)</label>
                <label>Ad placement<select name="adPlacement">
                  <option value="feed" <%= (community.monetizationSettings?.adPlacement || 'feed') === 'feed' ? 'selected' : '' %>>Feed</option>
                  <option value="sidebar" <%= community.monetizationSettings?.adPlacement === 'sidebar' ? 'selected' : '' %>>Sidebar</option>
                  <option value="all" <%= community.monetizationSettings?.adPlacement === 'all' ? 'selected' : '' %>>Feed and sidebar</option>
                </select></label>
                <label>Frequency (posts between ads)<input type="number" name="adFrequency" min="1" max="10" step="1" value="<%= community.monetizationSettings?.adFrequency || 1 %>"></label>
                <label>Owner Waves share (%)<input type="number" name="revenueSharePercent" min="0" max="100" step="0.01" value="<%= community.monetizationSettings?.revenueSharePercent ?? 50 %>" required></label>
              </fieldset>
              <% } %>
              <div class="admin-edit-form-actions">
                <button class="button button-small button-primary" type="submit">Save</button>
              </div>
            </form>
            <% if (community.monetizationStatus === 'approved') { %>
            <form method="post" action="/admin/communities/<%= community._id %>/monetization" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="note" maxlength="500" placeholder="Required reason for monetization suspension" required>
              <button class="button button-small button-danger" name="decision" value="pause" type="submit">Suspend monetization now</button>
            </form>
            <% } else if (community.monetizationStatus === 'paused' && community.monetizationModeratorReview?.status === 'cleared') { %>
            <form method="post" action="/admin/communities/<%= community._id %>/monetization" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="checkbox-field"><input type="checkbox" name="adsEnabled"> Re-enable ads</label>
              <label>Placement<select name="adPlacement"><option value="feed">Feed</option><option value="sidebar">Sidebar</option><option value="all">Feed and sidebar</option></select></label>
              <label>Frequency<input type="number" name="adFrequency" min="1" max="10" value="1"></label>
              <input type="text" name="note" maxlength="500" placeholder="Reinstatement reason" required>
              <button class="button button-small button-primary" name="decision" value="approve" type="submit">Restore monetization</button>
            </form>
            <% } %>
            <form method="post" action="/admin/communities/<%= community._id %>/delete" data-confirm="Delete this community and all of its posts?" style="margin-top:8px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-small button-danger" type="submit">Delete community</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>

  <!-- REPORTS -->
  <section class="admin-panel" id="admin-panel-reports" role="tabpanel" aria-labelledby="admin-tab-reports" data-panel="reports">
    <h2>Open reports</h2>
    <% if (!openReports.length) { %><p>No open reports.</p><% } %>
    <% openReports.forEach((report) => { %>
    <div class="device-row">
      <div>
        <strong><%= report.targetType %> · <%= report.target %></strong>
        <span><%= report.reason %> · reported by <%= report.reporter?.name || 'member' %> · <%= new Date(report.createdAt).toLocaleString() %></span>
        <% if (report.contextText) { %><p class="report-context"><%= report.contextText %></p><% } %>
        <% if (report.evidenceUrl) { %><a href="<%= report.evidenceUrl %>" target="_blank" rel="noopener noreferrer"><img src="<%= report.evidenceUrl %>" alt="Reported evidence screenshot" style="max-width:160px;border-radius:6px;margin-top:6px;display:block;"></a><% } %>
      </div>
      <form method="post" action="/admin/reports/<%= report._id %>" style="display:flex;gap:6px;flex:1 1 260px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="resolution" placeholder="Resolution note (optional)" style="flex:1;min-width:0;background:transparent;border:1px solid var(--line);color:var(--tx-mid);border-radius:7px;padding:7px 9px;font-size:11px;">
        <button name="status" value="resolved" class="button button-small button-primary">Resolve</button>
        <button name="status" value="dismissed" class="button button-small button-ghost">Dismiss</button>
      </form>
    </div>
    <% }) %>
  </section>

  <!-- APPEALS -->
  <section class="admin-panel" id="admin-panel-appeals" role="tabpanel" aria-labelledby="admin-tab-appeals" data-panel="appeals">
    <h2>Pending appeals</h2>
    <% if (!pendingAppeals.length) { %><p>No pending appeals.</p><% } %>
    <% pendingAppeals.forEach((appeal) => { %>
    <div class="device-row">
      <div>
        <strong><%= appeal.actionType === 'advertiser' ? `Advertiser appeal · ${appeal.advertiser?.businessName || 'unknown business'}` : `${appeal.actionType} · ${appeal.user?.name || 'member'} (${appeal.user?.email || 'unknown'})` %></strong>
        <span>Filed <%= new Date(appeal.createdAt).toLocaleString() %><% if (appeal.reasonSnapshot) { %> · original reason: <%= appeal.reasonSnapshot %><% } %></span>
        <p><%= appeal.message %></p>
      </div>
      <form method="post" action="/admin/appeals/<%= appeal._id %>" style="display:flex;gap:6px;flex:1 1 260px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="note" placeholder="Review note (optional)" style="flex:1;min-width:0;background:transparent;border:1px solid var(--line);color:var(--tx-mid);border-radius:7px;padding:7px 9px;font-size:11px;">
        <button name="decision" value="approve" class="button button-small button-primary"><%= appeal.actionType === 'advertiser' ? 'Approve & restore' : 'Approve & lift' %></button>
        <button name="decision" value="deny" class="button button-small button-ghost"><%= appeal.actionType === 'advertiser' ? 'Deny appeal' : 'Deny' %></button>
      </form>
    </div>
    <% }) %>
  </section>

  <!-- APPROVAL QUEUE -->
  <section class="admin-panel" id="admin-panel-queue" role="tabpanel" aria-labelledby="admin-tab-queue" data-panel="queue">
    <h2>Pending moderator actions</h2>
    <% if (!pendingActions.length) { %><p>No actions waiting for approval.</p><% } %>
    <% pendingActions.forEach((item) => { %>
    <div class="device-row" style="flex-direction:column;align-items:stretch;">
      <div><strong><%= item.action === 'flag-spam' ? 'flag-spam · hidden, awaiting your final look' : item.action %></strong><span> requested by <%= item.moderator?.name || 'Moderator' %> (<%= item.moderator?.moderatorId %>) · target <%= item.targetType %> <%= item.target %></span></div>
      <% if (item.targetType === 'report' && item.reportContext) { %><div class="admin-diff"><strong>Reported <%= item.reportContext.targetType %></strong> — <%= item.reportContext.reason %></div><% } %>
      <% if (item.targetType === 'post' && item.postContext) { %><div class="admin-diff"><strong>Post by <%= item.postContext.author?.name || 'Member' %></strong><%= (item.postContext.body || '').slice(0, 180) %></div><% } %>
      <% if (item.targetType === 'user' && item.userContext) { %><div class="admin-diff"><strong>Account</strong> <%= item.userContext.name %> (<%= item.userContext.email %>)</div><% } %>
      <div class="admin-diff"><strong>Reason</strong><%= item.reason %><% if (item.payload && Object.keys(item.payload).length) { %><strong style="margin-top:8px;">Proposed change</strong><% Object.entries(item.payload).forEach(([k, v]) => { %><%= k %>: <%= v %>
<% }) %><% } %></div>
      <form method="post" action="/admin/moderation/<%= item._id %>/review" style="display:flex;gap:8px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="note" placeholder="Review note (optional)" style="flex:1;min-width:0;background:transparent;border:1px solid var(--line);color:var(--tx-mid);border-radius:7px;padding:7px 9px;font-size:11px;">
        <button class="button button-small button-primary" name="decision" value="approve"><%= item.action === 'flag-spam' ? 'Confirm spam' : 'Approve & apply' %></button>
        <button class="button button-small button-danger" name="decision" value="reject"><%= item.action === 'flag-spam' ? 'Not spam · restore' : 'Reject' %></button>
      </form>
    </div>
    <% }) %>
    <% if (locals.autoApplied && autoApplied.length) { %>
    <h2 style="margin-top:32px;">Applied automatically (low risk)</h2>
    <p class="form-note">Good/bad-post ratings and post edits by moderators take effect immediately. You can revert any of them.</p>
    <% autoApplied.forEach((item) => { %>
    <div class="device-row" style="flex-direction:column;align-items:stretch;">
      <div><strong><%= item.action %></strong><span> by <%= item.moderator?.name || 'Moderator' %> (<%= item.moderator?.moderatorId %>)</span></div>
      <% if (item.postContext) { %><div class="admin-diff"><strong>Post by <%= item.postContext.author?.name || 'Member' %></strong><%= (item.postContext.body || '').slice(0, 180) %></div><% } %>
      <div class="admin-diff"><strong>Reason</strong><%= item.reason %><% if (item.payload?.previousBody !== undefined) { %><strong style="margin-top:8px;">Before</strong><%= item.payload.previousBody.slice(0, 300) %><% } %></div>
      <form method="post" action="/admin/moderation/<%= item._id %>/revert"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit">Revert</button></form>
    </div>
    <% }) %>
    <% } %>
  </section>

  <!-- MODERATORS -->
  <section class="admin-panel" id="admin-panel-moderators" role="tabpanel" aria-labelledby="admin-tab-moderators" data-panel="moderators">
    <section class="settings-block"><h2>Create moderator</h2><form class="settings-form compact" method="post" action="/admin/moderators"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Temporary password<input type="password" name="password" minlength="8" required></label><button class="button button-primary button-small">Create moderator</button></form></section>
    <section class="settings-block"><h2>Current moderators</h2><% moderators.forEach((mod) => { %><div class="device-row"><div><strong><%= mod.name %></strong><span><%= mod.moderatorId %> · <%= mod.email %></span></div><form method="post" action="/admin/moderators/<%= mod._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-danger">Remove</button></form></div><% }) %><% if (!moderators.length) { %><p>No moderators yet.</p><% } %></section>
  </section>

  <!-- SITE SETTINGS -->
  <section class="admin-panel" id="admin-panel-settings" role="tabpanel" aria-labelledby="admin-tab-settings" data-panel="settings">
    <section class="settings-block admin-wide">
      <h2>Site settings</h2>
      <form class="admin-edit-form" method="post" action="/admin/settings">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Site name<input type="text" name="siteName" value="<%= siteSettings.siteName %>"></label>
        <label class="full-width">Tagline<input type="text" name="tagline" value="<%= siteSettings.tagline %>"></label>
        <label class="checkbox-field"><input type="checkbox" name="registrationOpen" <%= siteSettings.registrationOpen ? 'checked' : '' %>> New signups open</label>
        <label class="checkbox-field"><input type="checkbox" name="postApprovalDefault" <%= siteSettings.postApprovalDefault ? 'checked' : '' %>> New communities require post approval by default</label>
        <label class="checkbox-field"><input type="checkbox" name="maintenanceMode" <%= siteSettings.maintenanceMode ? 'checked' : '' %>> Maintenance mode</label>
        <label class="full-width">Maintenance message<input type="text" name="maintenanceMessage" value="<%= siteSettings.maintenanceMessage %>"></label>
        <label class="full-width">Site-wide announcement banner<input type="text" name="announcement" value="<%= siteSettings.announcement %>"></label>
        <label>Post word limit<input type="number" name="postWordLimit" min="10" max="2000" value="<%= siteSettings.postWordLimit %>"></label>
        <label>Article word limit<input type="number" name="articleWordLimit" min="50" max="20000" value="<%= siteSettings.articleWordLimit %>"></label>
        <label>Default suspension length (days)<input type="number" name="suspensionDefaultDays" min="1" max="3650" value="<%= siteSettings.suspensionDefaultDays %>"></label>
        <label>Moderators needed to clear a post<input type="number" name="postReviewThreshold" min="1" max="50" value="<%= siteSettings.postReviewThreshold %>"></label>
        <label>Monetization minimum posts<input type="number" name="monetizationMinimumPosts" min="0" max="10000" value="<%= siteSettings.monetizationMinimumPosts ?? 20 %>"></label>
        <label>Monetization minimum likes<input type="number" name="monetizationMinimumLikes" min="0" max="100000" value="<%= siteSettings.monetizationMinimumLikes ?? 30 %>"></label>
        <label>Monetization minimum comments<input type="number" name="monetizationMinimumComments" min="0" max="100000" value="<%= siteSettings.monetizationMinimumComments ?? 10 %>"></label>
        <label>Minimum community age (days)<input type="number" name="monetizationMinimumCommunityAgeDays" min="0" max="3650" value="<%= siteSettings.monetizationMinimumCommunityAgeDays ?? 30 %>"></label>
        <label>Recent activity window (days)<input type="number" name="monetizationRecentActivityDays" min="1" max="365" value="<%= siteSettings.monetizationRecentActivityDays ?? 30 %>"></label>
        <label>Post reward minimum Waves<input type="number" name="wavesPostRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesPostReward?.minimum ?? 1 %>"></label>
        <label>Post reward maximum Waves<input type="number" name="wavesPostRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesPostReward?.maximum ?? 3 %>"></label>
        <label>Comment reward minimum Waves<input type="number" name="wavesCommentRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesCommentReward?.minimum ?? 1 %>"></label>
        <label>Comment reward maximum Waves<input type="number" name="wavesCommentRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesCommentReward?.maximum ?? 3 %>"></label>
        <label>Received-like reward minimum Waves<input type="number" name="wavesLikeRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesLikeReward?.minimum ?? 0.1 %>"></label>
        <label>Received-like reward maximum Waves<input type="number" name="wavesLikeRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesLikeReward?.maximum ?? 1 %>"></label>
        <label>Received-comment reward minimum Waves<input type="number" name="wavesReceivedCommentRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesReceivedCommentReward?.minimum ?? 0.1 %>"></label>
        <label>Received-comment reward maximum Waves<input type="number" name="wavesReceivedCommentRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesReceivedCommentReward?.maximum ?? 1 %>"></label>
        <label>Community join reward minimum Waves<input type="number" name="wavesCommunityJoinRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesCommunityJoinReward?.minimum ?? 1 %>"></label>
        <label>Community join reward maximum Waves<input type="number" name="wavesCommunityJoinRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesCommunityJoinReward?.maximum ?? 2 %>"></label>
        <label>Community creation reward minimum Waves<input type="number" name="wavesCommunityCreateRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesCommunityCreateReward?.minimum ?? 2 %>"></label>
        <label>Community creation reward maximum Waves<input type="number" name="wavesCommunityCreateRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesCommunityCreateReward?.maximum ?? 5 %>"></label>
        <label>Quest completion reward minimum Waves<input type="number" name="wavesQuestCompletionRewardMinimum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesQuestCompletionReward?.minimum ?? 1 %>"></label>
        <label>Welcome bonus for new members (Waves, 0 = off)<input type="number" name="wavesWelcomeBonus" min="0" max="10000" step="1" value="<%= siteSettings.wavesWelcomeBonus ?? 25 %>"></label>
        <label>Quest completion reward maximum Waves<input type="number" name="wavesQuestCompletionRewardMaximum" min="0" max="10000" step="0.01" value="<%= siteSettings.wavesQuestCompletionReward?.maximum ?? 5 %>"></label>
        <label>Daily Waves earning limit<input type="number" name="wavesDailyEarningLimit" min="0" max="100000" step="0.01" value="<%= siteSettings.wavesDailyEarningLimit ?? 20 %>"></label>
        <label>Maximum Waves per transfer<input type="number" name="wavesMaxTransferAmount" min="0" max="1000000" step="0.01" value="<%= siteSettings.wavesMaxTransferAmount ?? 100 %>"></label>
        <label>Daily Waves transfer limit<input type="number" name="wavesDailyTransferLimit" min="0" max="10000000" step="0.01" value="<%= siteSettings.wavesDailyTransferLimit ?? 500 %>"></label>
        <label class="checkbox-field"><input type="checkbox" name="adFreeEnabled" <%= siteSettings.adFreeEnabled !== false ? 'checked' : '' %>> Offer Ad-Free plans paid with Waves</label>
        <label>Ad-Free 1 month price (Waves)<input type="number" name="adFreePrice1Month" min="1" max="1000000" step="1" value="<%= siteSettings.adFreePrice1Month ?? 100 %>"></label>
        <label>Ad-Free 4 months price (Waves)<input type="number" name="adFreePrice4Months" min="1" max="1000000" step="1" value="<%= siteSettings.adFreePrice4Months ?? 360 %>"></label>
        <label>Ad-Free 12 months price (Waves)<input type="number" name="adFreePrice12Months" min="1" max="1000000" step="1" value="<%= siteSettings.adFreePrice12Months ?? 1000 %>"></label>
        <label class="checkbox-field"><input type="checkbox" name="postPromotionEnabled" <%= siteSettings.postPromotionEnabled !== false ? 'checked' : '' %>> Allow post promotions paid with Waves</label>
        <label>Post promotion price (Waves)<input type="number" name="postPromotionWavesCost" min="1" max="10000" step="1" value="<%= siteSettings.postPromotionWavesCost ?? 25 %>"></label>
        <label>Post promotion duration (hours)<input type="number" name="postPromotionDurationHours" min="1" max="168" step="1" value="<%= siteSettings.postPromotionDurationHours ?? 24 %>"></label>
        <label class="checkbox-field"><input type="checkbox" name="communityPromotionEnabled" <%= siteSettings.communityPromotionEnabled !== false ? 'checked' : '' %>> Allow new community promotion purchases paid with Waves</label>
        <label>Community promotion price (Waves)<input type="number" name="communityPromotionWavesCost" min="1" max="10000" step="1" value="<%= siteSettings.communityPromotionWavesCost ?? 50 %>"></label>
        <label>Community promotion duration (hours)<input type="number" name="communityPromotionDurationHours" min="1" max="168" step="1" value="<%= siteSettings.communityPromotionDurationHours ?? 48 %>"></label>
        <label>Minimum advertiser campaign budget (Waves)<input type="number" name="advertisingMinimumCampaignBudget" min="1" max="1000000" step="0.01" value="<%= siteSettings.advertisingMinimumCampaignBudget ?? 25 %>"></label>
        <label>Waves charged per ad impression<input type="number" name="advertisingCostPerImpression" min="0" max="10000" step="0.001" value="<%= siteSettings.advertisingCostPerImpression ?? 0.1 %>"></label>
        <label>Waves charged per ad click<input type="number" name="advertisingCostPerClick" min="0" max="10000" step="0.01" value="<%= siteSettings.advertisingCostPerClick ?? 1 %>"></label>
        <div class="admin-edit-form-actions"><button class="button button-primary button-small" type="submit">Save settings</button></div>
      </form>
    </section>
  </section>

  <!-- DATA CLEANUP -->
  <section class="admin-panel" id="admin-panel-maintenance" role="tabpanel" aria-labelledby="admin-tab-maintenance" data-panel="maintenance">
    <h2>Data cleanup</h2>
    <p>Old chats, notifications, personal searches, recent-view history, and search trend events are removed after 30 days. The automatic cleanup runs daily. In-memory caches expire normally and can be cleared here. Recaps are generated live and have no stored history to clear. Admin audit logs are kept.</p>
    <div class="settings-block admin-wide">
      <h3>Run cleanup now</h3>
      <form class="admin-edit-form" method="post" action="/admin/maintenance/run" data-confirm="Run the selected cleanup process now? Deleted data cannot be recovered.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Cleanup process<select name="task" required><% Object.entries(maintenanceTaskLabels).forEach(([key, label]) => { %><option value="<%= key %>"><%= label %></option><% }) %></select></label>
        <button class="button button-small button-ghost" type="submit">Run selected</button>
      </form>
      <form method="post" action="/admin/maintenance/run" data-confirm="Run every cleanup process now? Old chat, notification, and history data will be permanently deleted.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="task" value="all">
        <button class="button button-small button-danger" type="submit">Run all cleanup processes</button>
      </form>
    </div>
    <h3>Recent cleanup runs</h3>
    <% if (!maintenanceRuns.length) { %><p>No cleanup runs have been recorded yet.</p><% } %>
    <% maintenanceRuns.forEach((entry) => { %>
      <div class="device-row">
        <div>
          <strong><%= entry.task === 'all' ? 'All cleanup processes' : maintenanceTaskLabels[entry.task] || entry.task %> · <%= entry.status %></strong>
          <span><%= entry.scheduled ? 'Automatic' : `Run by ${entry.triggeredBy?.name || 'admin'}` %> · <%= new Date(entry.startedAt).toLocaleString() %></span>
          <small><%= JSON.stringify(entry.results) %></small>
        </div>
      </div>
    <% }) %>
  </section>

  <!-- AUDIT LOG -->
  <section class="admin-panel" id="admin-panel-audit" role="tabpanel" aria-labelledby="admin-tab-audit" data-panel="audit">
    <div class="admin-section-head"><div><h2>Recent audit activity</h2><p>Moderation and administrative actions, including their reasons and affected records.</p></div><input class="admin-search" type="search" placeholder="Filter audit activity" aria-label="Filter audit activity" data-filter-audit></div>
    <% if (!auditLogs.length) { %><p>No audit activity has been recorded yet.</p><% } %>
    <% auditLogs.forEach((entry) => { const auditText = [entry.action, entry.actor?.name, entry.actor?.email, entry.targetType, entry.target, JSON.stringify(entry.details || {})].filter(Boolean).join(' ').toLowerCase(); %>
      <div class="device-row" data-audit-row data-audit-text="<%= auditText %>">
        <div>
          <strong><%= entry.action %></strong>
          <span><%= entry.actor?.name || 'system' %><% if (entry.actor?.role) { %> · <%= entry.actor.role %><% } %> · <%= new Date(entry.createdAt).toLocaleString() %></span>
          <% if (entry.targetType || entry.target) { %><small>Affected <%= entry.targetType || 'record' %><% if (entry.target) { %> · <%= entry.target %><% } %></small><% } %>
          <% if (entry.details && Object.keys(entry.details).length) { %><pre><%= JSON.stringify(entry.details, null, 2) %></pre><% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>
<script>
document.addEventListener('input', function (e) {
  var input = e.target.closest('[data-filter-table]');
  if (!input) return;
  var table = document.getElementById(input.dataset.filterTable);
  var q = input.value.trim().toLowerCase();
  table.querySelectorAll('tbody tr[data-row-text]').forEach(function (row) {
    row.style.display = row.dataset.rowText.indexOf(q) === -1 ? 'none' : '';
  });
});
document.addEventListener('input', function (e) {
  var input = e.target.closest('[data-filter-audit]');
  if (!input) return;
  var q = input.value.trim().toLowerCase();
  document.querySelectorAll('[data-audit-row]').forEach(function (row) {
    row.style.display = row.dataset.auditText.indexOf(q) === -1 ? 'none' : '';
  });
});
</script>
<%- include('../partials/app-footer') %><%- include('../partials/foot') %>
