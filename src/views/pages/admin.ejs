<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<main class="explore-page admin-console"><%- include('../partials/flash') %>
  <p class="eyebrow">Restricted operations</p><h1>Admin console</h1>
  <div class="admin-stats"><span><strong><%= stats.users %></strong> users</span><span><strong><%= stats.posts %></strong> posts</span><span><strong><%= stats.communities %></strong> communities</span><span><strong><%= stats.reports %></strong> reports</span></div>
  <section class="settings-block"><h2>Create moderator</h2><form class="settings-form compact" method="post" action="/admin/moderators"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Temporary password<input type="password" name="password" minlength="8" required></label><button class="button button-primary button-small">Create moderator</button></form></section>
  <section class="settings-block"><h2>Moderators</h2><% moderators.forEach((mod) => { %><div class="device-row"><div><strong><%= mod.name %></strong><span><%= mod.moderatorId %> · <%= mod.email %></span></div><form method="post" action="/admin/moderators/<%= mod._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-danger">Remove</button></form></div><% }) %></section>
  <section class="settings-block"><h2>Pending moderator actions</h2><% if (!pendingActions.length) { %><p>No actions waiting for approval.</p><% } %><% pendingActions.forEach((item) => { %><div class="device-row"><div><strong><%= item.action %></strong><span><%= item.moderator?.name || 'Moderator' %> · <%= item.reason %></span></div><form method="post" action="/admin/moderation/<%= item._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-primary" name="decision" value="approve">Approve</button><button class="button button-small button-danger" name="decision" value="reject">Reject</button></form></div><% }) %></section>
  <section class="settings-block"><h2>Reports</h2><% if (!openReports.length) { %><p>No open reports.</p><% } %><% openReports.forEach((report) => { %><div class="device-row"><div><strong><%= report.targetType %></strong><span><%= report.reason %> · reported by <%= report.reporter?.name || 'member' %></span></div><form method="post" action="/admin/reports/<%= report._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button name="status" value="resolved" class="button button-small button-primary">Resolve</button><button name="status" value="dismissed" class="button button-small button-ghost">Dismiss</button></form></div><% }) %></section>
  <section class="settings-block"><h2>Communities</h2><% communities.forEach((community) => { %><div class="device-row"><div><strong><%= community.name %></strong><span><%= community.membersCount %> members · owner <%= community.owner?.name || 'unknown' %> · <%= community.requireApproval ? 'approval on' : 'approval off' %></span></div></div><% }) %></section>
  <section class="settings-block"><h2>Recent audit activity</h2><% auditLogs.forEach((entry) => { %><div class="device-row"><div><strong><%= entry.action %></strong><span><%= entry.actor?.name || 'system' %> · <%= new Date(entry.createdAt).toLocaleString() %></span></div></div><% }) %></section>
</main><%- include('../partials/app-footer') %><%- include('../partials/foot') %>
