<%- include('../partials/head', { title, description: post.body?.slice(0, 160), pagePath, bodyClass: currentUser ? 'dashboard-page' : 'info-page' }) %>
<% if (currentUser) { %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% } else { %>
<header class="site-nav container">
	<a class="brand" href="/"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
	<a class="button button-small button-ghost" href="/auth/register">Join Crowdwide <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></a>
</header>
<% } %>
<main class="post-page">
	<div class="post-page-bar">
		<a class="post-back" href="<%= currentUser ? '/dashboard' : '/' %>" aria-label="<%= currentUser ? 'Back to feed' : 'Back to Crowdwide' %>"><%- icon('arrow-left', { size: 20 }) %></a>
		<h1><%= post.type === 'article' ? 'Article' : post.type === 'poll' ? 'Poll' : 'Post' %></h1>
	</div>
	<% if (locals.flash) { %><%- include('../partials/flash') %><% } %>
	<article class="post-view <%= post.contentWarning ? 'has-content-warning' : '' %>" id="post-<%= post._id %>">
		<% if (post.contentWarning) { %><button class="content-warning-toggle" type="button" data-warning-toggle>Show content: <%= post.contentWarning %></button><% } %>
		<header class="post-view-head">
			<%- include('../partials/avatar', { person: post.author, size: 'medium', link: !!currentUser }) %>
			<div class="post-view-author">
				<strong><%= post.author?.name || 'Crowdwide member' %></strong>
				<span><%= post.community?.name || 'Open Crowdwide' %> · <time datetime="<%= new Date(post.createdAt).toISOString() %>"><%= new Date(post.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></time></span>
			</div>
		</header>
		<div class="post-view-body"><%- renderRichBody(post.body) %></div>
		<% if (post.poll?.question && post.poll.options?.length) { %>
		<section class="post-poll"><strong><%= post.poll.question %></strong><% post.poll.options.forEach((option, index) => { %><% if (currentUser) { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/poll/vote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="optionIndex" value="<%= index %>"><button type="submit"><%= option.label %> <span><%= option.votes?.length || 0 %></span></button></form><% } else { %><p><%= option.label %> <span><%= option.votes?.length || 0 %></span></p><% } %><% }) %></section>
		<% } %>
		<% if (post.quotedPost) { %><a class="quoted-post" href="/posts/<%= post.quotedPost._id %>"><strong><%= post.quotedPost.author?.name || 'Crowdwide member' %>'s post</strong><p><%= post.quotedPost.body %></p></a><% } %>
		<% if (post.replyTo) { %><a class="quoted-post reply-source" href="/posts/<%= post.replyTo._id %>"><strong>Replying to <%= post.replyTo.author?.name || 'Crowdwide member' %></strong><p><%= post.replyTo.body %></p></a><% } %>
		<% if ((post.hashtags || []).length) { %><div class="hashtag-row"><% post.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
		<% if (post.linkPreview?.title) { %>
		<a class="link-preview-card" href="<%= post.linkPreview.url %>" target="_blank" rel="noopener noreferrer nofollow">
			<% if (post.linkPreview.image) { %><img src="<%= post.linkPreview.image %>" alt="" loading="lazy"><% } %>
			<div class="link-preview-body"><span class="link-preview-site"><%= post.linkPreview.siteName %></span><strong><%= post.linkPreview.title %></strong><% if (post.linkPreview.description) { %><p><%= post.linkPreview.description %></p><% } %></div>
		</a>
		<% } %>
		<%- include('../partials/post-media', { post }) %>

		<div class="post-view-counts" aria-label="Post statistics">
			<span><strong data-like-total><%= post.likes?.length || 0 %></strong> likes</span>
			<span><strong data-comment-total><%= post.commentsCount || 0 %></strong> comments</span>
			<span><strong data-share-count-for="<%= post._id %>"><%= post.sharesCount || 0 %></strong> shares</span>
			<span><strong><%= post.viewsCount || 0 %></strong> views</span>
		</div>

		<% if (currentUser) { %>
		<div class="post-view-actions" aria-label="Post activity">
			<form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="action-like <%= post.liked ? 'is-liked' : '' %>" aria-label="Like" aria-pressed="<%= post.liked ? 'true' : 'false' %>"><%- icon('heart', { size: 24 }) %><span class="label">Like</span></button></form>
			<a class="action-link" href="#comment-body" data-focus-comment aria-label="Comment"><%- icon('message-circle', { size: 24 }) %><span class="label">Comment</span></a>
			<button type="button" class="action-share" data-share-open data-post-id="<%= post._id %>" data-post-url="/posts/<%= post._id %>" aria-label="Share"><%- icon('send', { size: 24 }) %><span class="label">Share</span></button>
			<form class="post-view-save" method="post" action="/posts/<%= post._id %>/bookmark"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="action-save <%= post.bookmarked ? 'is-saved' : '' %>" aria-label="Save" aria-pressed="<%= post.bookmarked ? 'true' : 'false' %>"><%- icon('bookmark', { size: 24 }) %><span class="label"><%= post.bookmarked ? 'Saved' : 'Save' %></span></button></form>
		</div>
		<div class="reaction-strip" aria-label="React to this post">
			<% [['celebrate', 'award', 'Celebrate'], ['insightful', 'lightbulb', 'Insightful'], ['support', 'thumbs-up', 'Support'], ['funny', 'smile', 'Funny']].forEach(([reaction, glyph, label]) => { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/reaction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reaction" value="<%= reaction %>"><button type="submit" title="<%= label %>" aria-label="<%= label %>" data-reaction="<%= reaction %>"><%- icon(glyph, { size: 16 }) %><span class="label"><%= label %></span><span class="count"><%= post.reactions?.[reaction]?.length || 0 %></span></button></form><% }) %>
		</div>

		<details class="post-more">
			<summary><%- icon('more-horizontal', { size: 18 }) %> More options</summary>
			<div class="post-secondary-actions">
				<details class="post-owner-tools"><summary><%- icon('reply', { size: 14 }) %> Reply with a post</summary><form class="post-reply-form" data-async-interaction method="post" action="/posts/<%= post._id %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mention-wrap"><textarea data-mention-input name="body" maxlength="4000" placeholder="Write a public reply..." required></textarea></div><button type="submit">Publish reply</button></form></details>
				<% if (String(post.author?._id) === String(currentUser.id)) { %>
				<details class="post-owner-tools">
					<summary><%- icon('edit', { size: 14 }) %> Edit post</summary>
					<form method="post" action="/posts/<%= post._id %>/edit">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>">
						<textarea name="body" maxlength="4000" required><%= post.body %></textarea>
						<button type="submit">Save changes</button>
					</form>
					<form method="post" action="/posts/<%= post._id %>/delete" data-confirm="Delete this post? This cannot be undone.">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>">
						<button type="submit">Delete post</button>
					</form>
				</details>
				<% } else { %>
				<details class="post-owner-tools">
					<summary><%- icon('flag', { size: 14 }) %> Report</summary>
					<form class="post-report-form" method="post" action="/posts/<%= post._id %>/report" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" maxlength="500" placeholder="What is wrong with this post?"><label class="report-evidence-label">Evidence (optional)<input type="file" name="evidence" accept="image/*"></label><button type="submit">Send report</button></form>
				</details>
				<% } %>
			</div>
		</details>
		<% if (['admin', 'moderator'].includes(currentUser?.role) && String(post.author?._id) !== String(currentUser.id)) { %>
		<section class="post-moderation-tools">
			<strong>Moderation</strong>
			<form method="post" action="/posts/<%= post._id %>/moderate">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<label>Action<select name="action"><option value="rate-good-post">Mark as good</option><option value="rate-bad-post">Mark for review</option><option value="report-post">Report post</option><option value="suspend-user">Suspend author</option><option value="delete-post">Delete post</option></select></label>
				<input name="reason" maxlength="1000" placeholder="Reason (optional for ratings)">
				<button class="button button-small <%= currentUser.role === 'admin' ? 'button-danger' : 'button-ghost' %>" type="submit"><%= currentUser.role === 'admin' ? 'Apply action' : 'Send for approval' %></button>
			</form>
		</section>
		<% } %>
		<% } else { %>
		<div class="public-post-cta">
			<p>Thoughtful conversations live on Crowdwide.</p>
			<a class="button button-primary button-small" href="/auth/register">Join the conversation <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></a>
		</div>
		<% } %>
	</article>

	<section class="replies-section" id="replies">
		<div class="panel-heading"><h2>Comments</h2><span data-comment-total><%= comments.length %></span></div>
		<% if (currentUser) { %>
		<%- include('../partials/comment-form', { action: '/posts/' + post._id + '/comments', placeholder: 'Add a comment...', showAvatar: true, fieldId: 'comment-body', csrfToken }) %>
		<% } %>
		<p class="no-comments" data-no-comments<%- comments.length ? ' hidden' : '' %>>No comments yet. Start the conversation.</p>
		<div class="post-detail-thread">
			<% commentTree.forEach((node) => { %>
				<%- include('../partials/comment-node', { node, depth: 0, postId: post._id, csrfToken, canReply: !!currentUser }) %>
			<% }) %>
		</div>
	</section>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/foot') %>
