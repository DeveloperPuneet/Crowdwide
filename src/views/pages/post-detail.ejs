<%- include('../partials/head', { title, description: preview(post.body, 160), pagePath, bodyClass: currentUser ? 'dashboard-page' : 'info-page' }) %>
<% if (currentUser) { %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% } else { %>
<header class="site-nav container">
	<a class="brand" href="/"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
	<div class="post-guest-actions"><a class="button button-small button-ghost" href="/auth/login">Sign in</a><a class="button button-small button-primary" href="/auth/register">Join Crowdwide <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></a></div>
</header>
<% } %>
<main class="post-page">
	<div class="post-page-bar">
		<a class="post-back" href="<%= currentUser ? '/dashboard' : '/' %>" aria-label="<%= currentUser ? 'Back to feed' : 'Back to Crowdwide' %>"><%- icon('arrow-left', { size: 20 }) %></a>
		<h1><%= post.type === 'article' ? 'Article' : post.type === 'poll' ? 'Poll' : 'Post' %></h1>
	</div>
	<% if (locals.flash) { %><%- include('../partials/flash') %><% } %>
	<article class="post-view <%= post.contentWarning ? 'has-content-warning' : '' %>" id="post-<%= post._id %>">
		<% if (post.contentWarning) { %><button class="content-warning-toggle" type="button" data-warning-toggle>Show content: <%= post.contentWarning %></button><% } %>
		<% const coAuthorNames = (post.coAuthors || []).map((person) => person && typeof person === 'object' ? person.name : '').filter(Boolean); %>
		<header class="post-view-head">
			<%- include('../partials/avatar', { person: post.author, size: 'medium', link: !!currentUser, standalone: true }) %>
			<div class="post-view-author">
				<strong><%= post.author?.name || 'Crowdwide member' %></strong>
				<% if (coAuthorNames.length) { %><span class="co-author-line">with <%= coAuthorNames.slice(0, 2).join(', ') %><% if (coAuthorNames.length > 2) { %> +<%= coAuthorNames.length - 2 %><% } %></span><% } %>
				<span><%= post.community?.name || 'Open Crowdwide' %> · <time datetime="<%= new Date(post.createdAt).toISOString() %>"><%= new Date(post.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></time></span>
			</div>
			<% if (currentUser) { %>
			<details class="post-menu" data-post-menu>
				<summary class="post-menu-button" aria-label="Post options" aria-haspopup="menu"><%- icon('more-horizontal', { size: 20 }) %></summary>
				<div class="post-menu-list" role="menu" aria-label="Post options">
					<a class="post-menu-item" role="menuitem" href="/posts/<%= post._id %>/reply"><%- icon('reply', { size: 16 }) %><span>Reply with a post</span></a>
					<% if (String(post.author?._id) === String(currentUser.id)) { %>
					<a class="post-menu-item" role="menuitem" href="/posts/<%= post._id %>/edit"><%- icon('edit', { size: 16 }) %><span>Edit post</span></a>
					<% if (currentUser && promotionOffer && String(post.author?._id) === String(currentUser.id) && post.status === 'published' && ['unreviewed', 'good'].includes(post.moderationStatus) && !post.replyTo && !post.community?.isPrivate && post.boostStatus !== 'active' && (String(post.body || '').trim() || (post.media || []).length)) { %>
					<form method="post" action="/posts/<%= post._id %>/promote" data-confirm="Spend <%= promotionOffer.wavesCost %> Waves to promote this post for <%= promotionOffer.durationHours %> hours? Promoted posts are labeled.">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>">
						<button class="post-menu-item" role="menuitem" type="submit" title="Promote in the feed for <%= promotionOffer.durationHours %> hours"><%- icon('waves', { size: 16 }) %><span>Promote with Waves · <%= promotionOffer.wavesCost %></span></button>
					</form>
					<% } %>
					<form method="post" action="/posts/<%= post._id %>/delete" data-confirm="Delete this post? This cannot be undone.">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>">
						<button class="post-menu-item is-danger" role="menuitem" type="submit"><%- icon('trash', { size: 16 }) %><span>Delete post</span></button>
					</form>
					<% } else { %>
					<button class="post-menu-item is-danger" role="menuitem" type="button" data-report-open="report-dialog"><%- icon('flag', { size: 16 }) %><span>Report post</span></button>
					<% } %>
				</div>
			</details>
			<% } %>
		</header>
		<% if (post.questTitle) { %><span class="quest-post-label">Quest post · <%= post.questTitle %></span><% } %>
		<% if (post.boostStatus === 'active' && post.boostUntil && new Date(post.boostUntil) > new Date()) { %>
		<p class="post-source"><strong>Promoted</strong><% if (currentUser && String(post.author?._id) === String(currentUser.id)) { %> · Paid with <%= post.boostWavesCost %> Waves · ends <time datetime="<%= new Date(post.boostUntil).toISOString() %>"><%= new Date(post.boostUntil).toLocaleString() %></time><% } %></p>
		<% } %>
		<div class="post-view-body" data-translatable data-original="<%= post.body %>"><%- renderRichBody(post.body) %></div>
		<% if (post.poll?.question && post.poll.options?.length) { %>
		<section class="post-poll"><strong><%= post.poll.question %></strong><% post.poll.options.forEach((option, index) => { %><% if (currentUser) { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/poll/vote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="optionIndex" value="<%= index %>"><button type="submit"><%= option.label %> <span><%= option.votes?.length || 0 %></span></button></form><% } else { %><p><%= option.label %> <span><%= option.votes?.length || 0 %></span></p><% } %><% }) %><% if (!currentUser) { %><a class="public-interaction-prompt" href="/auth/register">Create an account to vote in this poll</a><% } %></section>
		<% } %>
		<% if (post.quotedPost) { %><a class="quoted-post" href="/posts/<%= post.quotedPost._id %>"><strong><%= post.quotedPost.author?.name || 'Crowdwide member' %>'s post</strong><p><%= preview(post.quotedPost.body, 400) %></p></a><% } %>
		<% if (post.replyTo) { %><a class="quoted-post reply-source" href="/posts/<%= post.replyTo._id %>"><strong>Replying to <%= post.replyTo.author?.name || 'Crowdwide member' %></strong><p><%= preview(post.replyTo.body, 400) %></p></a><% } %>
		<% if ((post.hashtags || []).length) { %><div class="hashtag-row"><% post.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
		<% if (post.linkPreview?.title) { %>
		<a class="link-preview-card" href="<%= post.linkPreview.url %>" target="_blank" rel="noopener noreferrer nofollow">
			<% if (post.linkPreview.image) { %><img src="<%= post.linkPreview.image %>" alt="" loading="lazy"><% } %>
			<div class="link-preview-body"><span class="link-preview-site"><%= post.linkPreview.siteName %></span><strong><%= post.linkPreview.title %></strong><% if (post.linkPreview.description) { %><p><%= post.linkPreview.description %></p><% } %></div>
		</a>
		<% } %>
		<%- include('../partials/post-media', { post }) %>

		<div class="post-view-counts">
			<span><strong data-like-total><%= post.likes?.length || 0 %></strong> likes</span>
			<span><strong data-comment-total><%= post.commentsCount || 0 %></strong> comments</span>
			<span><strong><%= post.replyPostsCount || 0 %></strong> replies with a post</span>
			<span><strong data-share-count-for="<%= post._id %>"><%= post.sharesCount || 0 %></strong> shares</span>
			<span><strong><%= post.viewsCount || 0 %></strong> views</span>
		</div>
		<a class="post-reposts-action" href="/posts/<%= post._id %>/replies-with-posts">
			<%- icon('reply-post', { size: 18 }) %><span>See replies with a post</span><strong><%= post.replyPostsCount || 0 %></strong>
		</a>

		<% if (currentUser) { %>
		<div class="post-view-actions" role="group" aria-label="Post activity">
			<form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="action-like <%= post.liked ? 'is-liked' : '' %>" aria-pressed="<%= post.liked ? 'true' : 'false' %>"><%- icon('heart', { size: 24 }) %><span class="label">Like</span></button></form>
			<a class="action-link" href="#comment-body" data-focus-comment><%- icon('message-circle', { size: 24 }) %><span class="label">Comment</span></a>
			<button type="button" class="action-link action-translate" data-translate-trigger><%- icon('globe', { size: 24 }) %><span class="label">Translate</span></button>
			<button type="button" class="action-share" data-share-open data-post-id="<%= post._id %>" data-post-url="/posts/<%= post._id %>"><%- icon('send', { size: 24 }) %><span class="label">Share</span></button>
			<form class="post-view-save" method="post" action="/posts/<%= post._id %>/bookmark"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="action-save <%= post.bookmarked ? 'is-saved' : '' %>" aria-pressed="<%= post.bookmarked ? 'true' : 'false' %>"><%- icon('bookmark', { size: 24 }) %><span class="label"><%= post.bookmarked ? 'Saved' : 'Save' %></span></button></form>
		</div>
		<div class="reaction-strip" role="group" aria-label="React to this post">
			<% [['celebrate', 'award', 'Celebrate'], ['insightful', 'lightbulb', 'Insightful'], ['support', 'thumbs-up', 'Support'], ['funny', 'smile', 'Funny']].forEach(([reaction, glyph, label]) => { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/reaction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reaction" value="<%= reaction %>"><button type="submit" title="<%= label %>" aria-label="<%= label %>" data-reaction="<%= reaction %>"><%- icon(glyph, { size: 16 }) %><span class="label"><%= label %></span><span class="count"><%= post.reactions?.[reaction]?.length || 0 %></span></button></form><% }) %>
		</div>

		<% if (currentUser && String(post.author?._id) !== String(currentUser.id)) { %>
		<dialog class="report-dialog" id="report-dialog" aria-labelledby="report-dialog-title">
			<form class="report-dialog-form" method="post" action="/posts/<%= post._id %>/report" enctype="multipart/form-data">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<div class="report-dialog-head"><h2 id="report-dialog-title">Report this post</h2><button class="report-dialog-x" type="button" data-dialog-close aria-label="Close"><%- icon('x', { size: 18 }) %></button></div>
				<p class="report-dialog-help">Reports go to our moderators. The author is not told who reported.</p>
				<%- include('../partials/report-reason-field') %>
				<label class="report-evidence-label">Evidence (optional)<input type="file" name="evidence" accept="image/*"></label>
				<div class="report-dialog-actions"><button class="button button-ghost button-small" type="button" data-dialog-close>Cancel</button><button class="button button-danger button-small" type="submit">Send report</button></div>
			</form>
		</dialog>
		<% } %>
		<% if (locals.postModerationRole) { %>
		<section class="post-moderation-tools" aria-labelledby="post-moderation-heading">
			<div class="post-moderation-heading"><%- icon('shield', { size: 16 }) %><strong id="post-moderation-heading">Moderation options</strong></div>
			<form class="post-moderation-form" method="post" action="/posts/<%= post._id %>/moderate">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<label>Action<select name="action"><option value="rate-good-post">Mark as good</option><option value="rate-bad-post">Mark for review</option><option value="report-post">Report post</option><option value="flag-spam">Flag as spam (hides it now)</option><option value="suspend-user">Suspend author</option><option value="delete-post">Delete post</option></select></label>
				<label>Reason <span class="form-optional">(optional for ratings)</span><input name="reason" maxlength="1000" placeholder="Add context for this action"></label>
				<button class="button button-small <%= locals.postModerationRole === 'admin' ? 'button-danger' : 'button-ghost' %>" type="submit"><%= locals.postModerationRole === 'admin' ? 'Apply action' : 'Submit' %></button>
			</form>
		</section>
		<% } %>
		<% } else { %>
		<div class="public-post-cta">
			<p>Thoughtful conversations live on Crowdwide.</p>
			<a class="button button-primary button-small" href="/auth/register">Join the conversation <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></a>
		</div>
		<% } %>
	</article>

	<section class="replies-section" id="replies">
		<div class="panel-heading"><h2>Comments</h2><span data-comment-total><%= comments.length %></span></div>
		<% if (currentUser) { %>
		<%- include('../partials/comment-form', { action: '/posts/' + post._id + '/comments', placeholder: 'Add a comment...', showAvatar: true, fieldId: 'comment-body', csrfToken }) %>
		<% } else { %>
		<div class="public-comments-join"><p>Reading the conversation is open to everyone. Create an account to add your voice.</p><a class="button button-primary button-small" href="/auth/register">Join the conversation</a></div>
		<% } %>
		<p class="no-comments" data-no-comments<%- comments.length ? ' hidden' : '' %>>No comments yet. Start the conversation.</p>
		<div class="post-detail-thread">
			<% commentTree.forEach((node) => { %>
				<%- include('../partials/comment-node', { node, depth: 0, postId: post._id, postAuthorId: post.author?._id, csrfToken, canReply: !!currentUser }) %>
			<% }) %>
		</div>
	</section>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/foot') %>
