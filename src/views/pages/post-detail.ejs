<%- include('../partials/head', { title, description: post.body?.slice(0, 160), pagePath, bodyClass: currentUser ? 'dashboard-page' : 'info-page' }) %>
<% if (currentUser) { %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% } else { %>
<header class="site-nav container">
	<a class="brand" href="/"><img src="/images/Crowdwide_logo.png" alt=""><span>Crowdwide</span></a>
	<a class="button button-small button-ghost" href="/auth/register">Join Crowdwide <span>↗</span></a>
</header>
<% } %>
<main class="community-detail post-detail-page">
	<a class="back-link" href="<%= currentUser ? '/dashboard' : '/' %>">← <%= currentUser ? 'Back to feed' : 'Crowdwide' %></a>
	<article class="post-card public-post">
		<div class="post-meta">
			<%- include('../partials/avatar', { person: post.author, size: 'small', link: !!currentUser }) %>
			<div><strong><%= post.author?.name || 'Crowdwide member' %></strong><span><%= post.type === 'article' ? 'Article' : post.type === 'poll' ? 'Poll' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %></span></div>
		</div>
		<p class="post-body" style="-webkit-line-clamp:unset;max-height:none;"><%- renderMentions(post.body) %></p>
		<% if (post.poll?.question && post.poll.options?.length) { %>
		<section class="post-poll"><strong><%= post.poll.question %></strong><% post.poll.options.forEach((option, index) => { %><% if (currentUser) { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/poll/vote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="optionIndex" value="<%= index %>"><button type="submit"><%= option.label %> <span><%= option.votes?.length || 0 %></span></button></form><% } else { %><p><%= option.label %> <span><%= option.votes?.length || 0 %></span></p><% } %><% }) %></section>
		<% } %>
		<% if (post.quotedPost) { %><a class="quoted-post" href="/posts/<%= post.quotedPost._id %>"><strong><%= post.quotedPost.author?.name || 'Crowdwide member' %>'s post</strong><p><%= post.quotedPost.body %></p></a><% } %>
		<% if ((post.hashtags || []).length) { %><div class="hashtag-row"><% post.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
		<% if ((post.media || []).length) { %>
		<div class="post-media <%= post.media.length === 2 ? 'count-2' : 'count-1' %>">
			<% post.media.forEach((media) => { %>
			<div class="post-media-frame">
				<% if (media.kind === 'image') { %><img src="<%= media.thumbnailUrl || media.url %>" alt="<%= media.alt || 'Post image' %>" loading="lazy">
				<% } else if (media.kind === 'video') { %><video controls controlsList="nodownload" disablePictureInPicture preload="none" src="<%= media.url %>"></video>
				<% } else if (media.kind === 'audio') { %><audio controls controlsList="nodownload" preload="none" src="<%= media.url %>"></audio><% } %>
			</div>
			<% }) %>
		</div>
		<% } %>
		<% if (currentUser) { %>
		<div class="post-actions">
			<form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= post.liked ? '♥' : '♡' %> <%= post.likes?.length || 0 %></button></form>
			<form method="post" action="/posts/<%= post._id %>/bookmark"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= post.bookmarked ? '▣ Saved' : '▱ Save' %></button></form>
			<form class="share-form" method="post" action="/posts/<%= post._id %>/share"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">↗ Share</button></form>
			<span>◉ <%= post.viewsCount || 0 %></span>
			<span>◌ <%= post.commentsCount || 0 %></span>
		</div>
		<div class="reaction-bar" aria-label="React to this post">
			<% [['celebrate', '👏'], ['insightful', '💡'], ['support', '🤝'], ['funny', '😄']].forEach(([reaction, icon]) => { %><form data-async-interaction method="post" action="/posts/<%= post._id %>/reaction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reaction" value="<%= reaction %>"><button type="submit" title="<%= reaction %>"><%= icon %> <%= post.reactions?.[reaction]?.length || 0 %></button></form><% }) %>
		</div>
		<form class="comment-form" data-async-interaction method="post" action="/posts/<%= post._id %>/comments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input data-mention-input name="body" maxlength="2000" placeholder="Add a thoughtful comment..." required><button type="submit">Comment</button></form>
		<details class="post-owner-tools"><summary>Quote</summary><form method="post" action="/posts/<%= post._id %>/quote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea data-mention-input name="body" maxlength="4000" placeholder="Add your commentary..." required></textarea><button type="submit">Publish quote</button></form></details>
		<% if (['admin', 'moderator'].includes(currentUser?.role) && String(post.author?._id) !== String(currentUser.id)) { %>
		<section class="post-moderation-tools">
			<strong>Moderation</strong>
			<form method="post" action="/posts/<%= post._id %>/moderate">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<label>Action<select name="action"><option value="rate-good-post">Mark as good</option><option value="rate-bad-post">Mark for review</option><option value="report-post">Report post</option><option value="suspend-user">Suspend author</option><option value="delete-post">Delete post</option></select></label>
				<input name="reason" maxlength="1000" placeholder="Reason (optional for ratings)">
				<button class="button button-small <%= currentUser.role === 'admin' ? 'button-danger' : 'button-ghost' %>" type="submit"><%= currentUser.role === 'admin' ? 'Apply action' : 'Send for approval' %></button>
			</form>
		</section>
		<% } %>
		<% } else { %>
		<div class="public-post-cta">
			<p>Thoughtful conversations live on Crowdwide.</p>
			<a class="button button-primary button-small" href="/auth/register">Join the conversation <span>↗</span></a>
		</div>
		<% } %>
	</article>
	<section class="community-posts">
		<div class="panel-heading"><h2>Replies</h2><span><%= comments.length %></span></div>
		<% if (!comments.length) { %><p style="color:#777a91;font-size:12px;">No replies yet.</p><% } %>
		<div class="post-detail-thread">
			<% commentTree.forEach((node) => { %>
				<%- include('../partials/comment-node', { node, depth: 0, postId: post._id, csrfToken, canReply: !!currentUser }) %>
			<% }) %>
		</div>
	</section>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/foot') %>
