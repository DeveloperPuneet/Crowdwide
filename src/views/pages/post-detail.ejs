<%- include('../partials/head', { title, description: post.body, pagePath }) %>
<div class="info-page"><header class="site-nav container"><a class="brand" href="/"><img src="/images/Crowdwide_logo.png" alt=""><span>Crowdwide</span></a><a class="button button-small button-ghost" href="/auth/register">Join Crowdwide <span>↗</span></a></header><main class="community-detail"><a class="back-link" href="/">← Crowdwide</a><article class="post-card public-post"><div class="post-meta"><div class="profile-avatar small"><%= post.author?.name?.charAt(0).toUpperCase() || '?' %></div><div><strong><%= post.author?.name || 'Crowdwide member' %></strong><span><%= post.type === 'article' ? 'Article' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %></span></div></div><p class="post-body"><%= post.body %></p><div class="public-post-cta"><p>Thoughtful conversations live on Crowdwide.</p><a class="button button-primary button-small" href="/auth/register">Join the conversation <span>↗</span></a></div></article><section class="community-posts"><div class="panel-heading"><h2>Replies</h2><span><%= comments.length %></span></div><% comments.forEach((comment) => { %><div class="comment"><strong><%= comment.author?.name || 'Member' %></strong><span><%= comment.body %></span></div><% }) %></section></main></div><%- include('../partials/foot') %>
