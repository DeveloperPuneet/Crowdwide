<%- include('../partials/auth-shell-start', { title }) %>
<p class="eyebrow">Contest a suspension</p><h1>Appeal your<br><em>suspension.</em></h1><p class="form-note">Enter the email on your suspended account and explain why the suspension should be lifted. A moderator will review it.</p>
<form class="auth-form" method="post" action="/auth/appeal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email address<input type="email" name="email" placeholder="you@example.com" required></label><label>Your appeal<textarea name="message" maxlength="1000" placeholder="Explain why this suspension should be reviewed" required></textarea></label><button class="button button-primary button-full" type="submit">Submit appeal <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button></form>
<p class="switch-auth"><a href="/auth/login">← Back to sign in</a></p>
<%- include('../partials/auth-shell-end') %>
