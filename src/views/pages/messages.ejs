<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'messages', currentUser }) %>
<main class="community-detail" style="width: 100%;">
  <a class="back-link" href="/dashboard">← Back to feed</a>
  <section class="community-posts">
    <div class="panel-heading"><h1>Messages</h1><span><%= conversations.length %></span></div>
    <% if (!conversations.length) { %>
    <div class="empty-feed"><h2>Your inbox is quiet.</h2><p>Start a conversation from someone’s profile.</p></div>
    <% } %>
    <% conversations.forEach((conversation) => { %>
    <a class="activity-row" href="/messages/<%= conversation.person._id %>" style="text-decoration:none;color:inherit;">
      <%- include('../partials/avatar', { person: conversation.person, size: 'small', link: false }) %>
      <div><strong><%= conversation.person.name %></strong><p><%= conversation.preview %></p><small><%= new Date(conversation.latest.createdAt).toLocaleString() %><% if (conversation.unread) { %> · <b><%= conversation.unread %> unread</b><% } %></small></div>
    </a>
    <% }) %>
  </section>
</main>
<%- include('../partials/app-footer') %><%- include('../partials/foot') %>
