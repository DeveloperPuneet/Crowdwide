<%- include('../partials/head', { title, pagePath, noIndex, bodyClass: 'onboarding-body' }) %>
<header class="onboarding-header">
	<a class="brand" href="/dashboard"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
	<% if (step < 4) { %>
	<form method="post" action="/welcome/skip"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit">Skip for now</button></form>
	<% } %>
</header>
<main class="onboarding-page">
	<%- include('../partials/flash') %>
	<ol class="onboarding-steps" aria-label="Setup progress">
		<% steps.forEach((label, index) => { const n = index + 1; %>
		<li class="<%= n === step ? 'is-current' : n < step ? 'is-done' : '' %>" <%- n === step ? 'aria-current="step"' : '' %>><span class="onboarding-step-num"><%= n < step ? '✓' : n %></span><span class="onboarding-step-label"><%= label %></span></li>
		<% }) %>
	</ol>

	<% if (step === 1) { %>
	<section class="onboarding-card">
		<p class="eyebrow">Step 1 of 4</p>
		<h1>What are you into?</h1>
		<p class="onboarding-lead">Pick a few topics. We use them to shape your feed and to suggest people and communities. You can change them any time in your profile.</p>
		<form method="post" action="/welcome/interests">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<div class="onboarding-chips" role="group" aria-label="Interests">
				<% interests.forEach((interest) => { %>
				<label class="onboarding-chip"><input type="checkbox" name="interests" value="<%= interest.value %>" <%= selectedInterests.includes(interest.value) ? 'checked' : '' %>><span><%= interest.label %></span></label>
				<% }) %>
			</div>
			<label class="onboarding-field">Anything else? <small>Optional · separate with spaces, e.g. #startups #chess</small>
				<input type="text" name="extraInterests" maxlength="200" value="<%= extraInterests %>" placeholder="#yourinterest">
			</label>
			<div class="onboarding-actions"><button class="button button-primary" type="submit">Continue</button></div>
		</form>
	</section>
	<% } %>

	<% if (step === 2) { %>
	<section class="onboarding-card">
		<p class="eyebrow">Step 2 of 4</p>
		<h1>Follow a few people</h1>
		<p class="onboarding-lead">Your feed gets better when it has people in it. Choose anyone who looks interesting. You can unfollow later.</p>
		<form method="post" action="/welcome/follow">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<% if (!people.length) { %>
			<p class="onboarding-empty">There is nobody new to suggest right now. You can find people any time from <a href="/people">People to follow</a>.</p>
			<% } %>
			<ul class="onboarding-list">
				<% people.forEach((person) => { %>
				<li class="onboarding-row">
					<label class="onboarding-row-label">
						<input type="checkbox" name="follow" value="<%= person._id %>">
						<%- include('../partials/avatar', { person, size: 'tiny', link: false }) %>
						<span class="onboarding-row-text"><strong><%= person.name %></strong><span><%= person.bio ? person.bio.slice(0, 90) : person.reason %></span><% if (person.bio) { %><small><%= person.reason %></small><% } %></span>
						<span class="onboarding-row-action">Follow</span>
					</label>
				</li>
				<% }) %>
			</ul>
			<div class="onboarding-actions"><a class="button button-ghost" href="/welcome?step=1">Back</a><button class="button button-primary" type="submit">Continue</button></div>
		</form>
	</section>
	<% } %>

	<% if (step === 3) { %>
	<section class="onboarding-card">
		<p class="eyebrow">Step 3 of 4</p>
		<h1>Join some communities</h1>
		<p class="onboarding-lead">Communities are where conversations happen. Matches for your interests come first.</p>
		<form method="post" action="/welcome/communities">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<input type="hidden" name="followed" value="<%= followed %>">
			<% if (!communities.length) { %>
			<p class="onboarding-empty">There are no public communities to suggest right now. Browse them any time in <a href="/communities">Communities</a>, or start your own.</p>
			<% } %>
			<ul class="onboarding-list">
				<% communities.forEach((community) => { %>
				<li class="onboarding-row">
					<label class="onboarding-row-label">
						<input type="checkbox" name="communities" value="<%= community._id %>">
						<span class="onboarding-community-icon" aria-hidden="true"><% if (community.avatarImage) { %><img src="<%= community.avatarImage %>" alt=""><% } else { %><%- icon('users', { size: 18 }) %><% } %></span>
						<span class="onboarding-row-text"><strong><%= community.name %></strong><span><%= (community.description || '').slice(0, 110) %></span><small><%= Number(community.membersCount || 0).toLocaleString() %> member<%= community.membersCount === 1 ? '' : 's' %><% if (community.matches) { %> · Matches your interests<% } %></small></span>
						<span class="onboarding-row-action">Join</span>
					</label>
				</li>
				<% }) %>
			</ul>
			<div class="onboarding-actions"><a class="button button-ghost" href="/welcome?step=2">Back</a><button class="button button-primary" type="submit">Finish</button></div>
		</form>
	</section>
	<% } %>

	<% if (step === 4) { %>
	<section class="onboarding-card onboarding-done">
		<p class="eyebrow">You're all set</p>
		<h1>Welcome to Crowdwide</h1>
		<p class="onboarding-lead">
			<% if (followed || joined) { %>You followed <strong><%= followed %></strong> <%= followed === 1 ? 'person' : 'people' %> and joined <strong><%= joined %></strong> <%= joined === 1 ? 'community' : 'communities' %>.<% } else { %>Your feed will get smarter as you read, like and join in.<% } %>
			Here are a few good next steps.
		</p>
		<ul class="onboarding-next">
			<li><%- icon('file-text', { size: 18 }) %> <span><strong>Say hello.</strong> Share your first post from the home feed.</span></li>
			<li><%- icon('bell', { size: 18 }) %> <span><strong>Stay in the loop.</strong> <a href="/settings/notifications">Choose notifications</a> for replies and messages.</span></li>
			<li><%- icon('waves', { size: 18 }) %> <span><strong>Earn Waves.</strong> <a href="/wallet">See how</a> posting and joining in earns Waves.</span></li>
		</ul>
		<div class="onboarding-actions">
			<button class="button button-ghost install-app-button" type="button" data-pwa-install hidden>Install the app</button>
			<form method="post" action="/welcome/finish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" type="submit">Go to my feed</button></form>
		</div>
	</section>
	<% } %>
</main>
<%- include('../partials/foot') %>
