<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% const monetizationApplications = Array.isArray(locals.pendingMonetization) ? locals.pendingMonetization : []; %>
<main class="explore-page admin-console"><%- include('../partials/flash') %>
  <p class="eyebrow">Restricted operations</p><h1>Moderator console</h1><p class="form-note">Identifier: <strong><%= moderator.moderatorId %></strong>. Personal emails, sessions, and account security data are hidden here. Every action you submit here is queued for an admin's approval before it takes effect.</p>

  <section class="settings-block admin-wide" id="monetization"><h2>Community monetization screening</h2><p>Check eligibility and policy history. This review is a recommendation; an admin makes the final decision.</p>
    <% if (!monetizationApplications.length) { %><p>No community monetization applications are waiting for review.</p><% } %>
    <% monetizationApplications.forEach((community) => { %>
    <article class="device-row" style="flex-direction:column;align-items:stretch;">
      <div><strong><%= community.name %></strong><span>Owner <%= community.owner?.name || 'unknown' %> · submitted <%= new Date(community.monetizationApplication?.submittedAt || community.createdAt).toLocaleDateString() %></span><p><%= community.monetizationApplication?.goals || 'No application goals provided.' %></p><p>Public community · confirm recent activity, owner standing, and upheld policy reports before clearing.</p></div>
      <form method="post" action="/moderator/communities/<%= community._id %>/monetization" style="display:flex;gap:8px;flex-wrap:wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="reason" maxlength="500" placeholder="Review notes (required)" required style="flex:1;min-width:180px;">
        <button class="button button-small button-primary" name="decision" value="cleared" type="submit">Clear for admin</button>
        <button class="button button-small button-danger" name="decision" value="flagged" type="submit">Flag for admin</button>
      </form>
    </article>
    <% }) %>
  </section>

  <section class="settings-block admin-wide" id="advertisers"><h2>Advertiser applications</h2><p>Screen advertiser details and policy fit. An admin makes the final approval or rejection decision.</p>
    <% if (!pendingAdvertisers.length) { %><p>No advertiser applications are waiting for moderator review.</p><% } %>
    <% pendingAdvertisers.forEach((advertiser) => { %>
    <article class="device-row" style="flex-direction:column;align-items:stretch;">
      <div><strong><%= advertiser.businessName %></strong><span><%= advertiser.user?.name || 'member' %></span>
        <% if (advertiser.website) { %><p><a href="<%= advertiser.website %>" rel="nofollow noopener"><%= advertiser.website %></a></p><% } %>
        <% if (advertiser.notes) { %><p><%= advertiser.notes %></p><% } %>
        <p>Advertising Terms: <%= advertiser.termsVersion || 'not accepted' %><% if (advertiser.termsAcceptedAt) { %> · <%= new Date(advertiser.termsAcceptedAt).toLocaleDateString() %><% } %></p>
        <details><summary>Advertiser review history (<%= (advertiser.moderationHistory || []).length %>)</summary>
          <% (advertiser.moderationHistory || []).slice().reverse().forEach((event) => { %><p><strong><%= event.status.replace(/-/g, ' ') %></strong> · <%= new Date(event.createdAt).toLocaleString() %> · <%= event.actor?.name || 'Staff' %><% if (event.reason) { %><br><%= event.reason %><% } %></p><% }) %>
        </details>
      </div>
      <form method="post" action="/moderator/advertisers/<%= advertiser._id %>/review" style="display:flex;gap:8px;flex-wrap:wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="reason" maxlength="500" placeholder="Review notes (required)" required style="flex:1;min-width:180px;">
        <button class="button button-small button-primary" name="decision" value="cleared" type="submit">Clear for admin</button>
        <button class="button button-small button-danger" name="decision" value="flagged" type="submit">Flag for admin</button>
      </form>
    </article>
    <% }) %>
  </section>

  <section class="settings-block admin-wide" id="campaigns"><h2>Advertisement campaign review</h2><p>Review submitted campaigns for policy concerns. An admin makes the final approval or rejection decision.</p>
    <% if (!pendingCampaigns.length) { %><p>No submitted campaigns are waiting for moderator review.</p><% } %>
    <% pendingCampaigns.forEach((campaign) => { %>
    <article class="device-row" style="flex-direction:column;align-items:stretch;">
      <div><strong><%= campaign.title %></strong><span><%= campaign.advertiser?.businessName || 'Advertiser' %> · <%= campaign.advertiser?.user?.name || 'member' %></span><p><%= campaign.description || 'No description provided.' %></p><p>Budget: <%= Number(campaign.totalBudget || 0).toLocaleString() %> Waves · targets: <%= (campaign.targetCommunities || []).length %> communities</p><p>Advertising Terms: <%= campaign.advertiser?.termsVersion || 'not accepted' %><% if (campaign.advertiser?.termsAcceptedAt) { %> · <%= new Date(campaign.advertiser.termsAcceptedAt).toLocaleDateString() %><% } %></p></div>
      <details><summary>Campaign review history (<%= (campaign.moderationHistory || []).length %>)</summary>
        <% (campaign.moderationHistory || []).slice().reverse().forEach((event) => { %><p><strong><%= event.status.replace(/-/g, ' ') %></strong> · <%= new Date(event.createdAt).toLocaleString() %> · <%= event.actor?.name || 'Staff' %><% if (event.reason) { %><br><%= event.reason %><% } %></p><% }) %>
      </details>
      <p>Do not clear campaigns promoting adult-only (18+) services, erotic or sexually explicit content, gambling or betting, pornography, or other inappropriate products or services. This is a policy review, not automated content detection.</p>
      <form method="post" action="/moderator/campaigns/<%= campaign._id %>/review" style="display:flex;gap:8px;flex-wrap:wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="reason" maxlength="500" placeholder="Review notes (required)" required style="flex:1;min-width:180px;">
        <fieldset style="flex-basis:100%;">
          <legend>For a clear decision, confirm every policy check</legend>
          <label class="checkbox-field"><input type="checkbox" name="policyChecks" value="adult-18-plus"> Not for adult-only (18+) products or services</label>
          <label class="checkbox-field"><input type="checkbox" name="policyChecks" value="sexual-content"> No erotic or sexually explicit content</label>
          <label class="checkbox-field"><input type="checkbox" name="policyChecks" value="gambling-betting"> No gambling or betting</label>
          <label class="checkbox-field"><input type="checkbox" name="policyChecks" value="pornography"> No pornography</label>
          <label class="checkbox-field"><input type="checkbox" name="policyChecks" value="other-inappropriate"> No other inappropriate products or services</label>
        </fieldset>
        <label>Flag category<select name="flaggedCategory"><option value="">Choose a category if flagging</option><option value="adult-18-plus">Adult-only (18+)</option><option value="sexual-content">Erotic or sexually explicit</option><option value="gambling-betting">Gambling or betting</option><option value="pornography">Pornography</option><option value="other-inappropriate">Other inappropriate content</option></select></label>
        <button class="button button-small button-primary" name="decision" value="cleared" type="submit">Clear for admin</button>
        <button class="button button-small button-danger" name="decision" value="flagged" type="submit">Flag for admin</button>
      </form>
    </article>
    <% }) %>
  </section>

  <section class="settings-block admin-wide"><h2>Moderation feed</h2><p>Review posts for usefulness, originality, civility, relevance, and clear evidence. Good-post ratings improve a post's review priority only after admin approval. Your own posts are excluded. Once <%= reviewThreshold %> moderators have reviewed a post, it drops out of everyone's queue.</p>
  <div style="display:flex;gap:8px;margin-bottom:14px;"><a href="/moderator" class="button button-small <%= locals.reportedOnly ? 'button-ghost' : 'button-primary' %>">All posts</a><a href="/moderator?filter=reported" class="button button-small <%= locals.reportedOnly ? 'button-primary' : 'button-ghost' %>">Reported only</a></div>
  <% if (!moderationFeed.length) { %><p><%= locals.reportedOnly ? 'No reported posts waiting on you right now.' : 'No posts are ready for review.' %></p><% } %><% moderationFeed.forEach((post) => { %><article class="moderation-post"><div><strong><%= post.author?.name || 'Member' %></strong><span><%= post.type === 'article' ? 'Article' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %> · score <%= post.moderationScore || 0 %> · reviewed by <%= (post.moderatorReviews || []).length %>/<%= reviewThreshold %> moderators<% if (post.moderationStatus === 'reported') { %> · <strong style="color:var(--ac-red);">reported</strong><% } %></span></div><p><%= post.body %></p><div class="moderation-actions"><form method="post" action="/moderator/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="mark-reviewed"><input type="hidden" name="target" value="<%= post._id %>"><button class="button button-small button-ghost" title="No issue - just remove it from my queue">Looks fine</button></form><form method="post" action="/moderator/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="rate-good-post"><input type="hidden" name="target" value="<%= post._id %>"><input type="hidden" name="reason" value="Meets quality criteria: useful, relevant, original, civil, and well-presented."><button class="button button-small button-primary">Good post</button></form><form method="post" action="/moderator/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="rate-bad-post"><input type="hidden" name="target" value="<%= post._id %>"><input name="reason" placeholder="Why does it need review?" required><button class="button button-small button-ghost">Bad post</button></form><form method="post" action="/moderator/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="report-post"><input type="hidden" name="target" value="<%= post._id %>"><input name="reason" placeholder="Report reason" required><button class="button button-small button-danger">Report</button></form></div>
  <details class="post-owner-tools"><summary>Propose edit (needs admin approval)</summary>
    <form method="post" action="/moderator/actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="edit-post">
      <input type="hidden" name="target" value="<%= post._id %>">
      <textarea name="payload[body]" maxlength="4000" placeholder="Corrected post body"><%= post.body %></textarea>
      <input name="reason" placeholder="Why does this need editing?" required style="margin-top:8px;width:100%;">
      <button class="button button-small button-primary" style="margin-top:8px;" type="submit">Send edit for approval</button>
    </form>
  </details>
  <details class="post-owner-tools"><summary>Warn or suspend author (needs admin approval)</summary>
    <form method="post" action="/moderator/actions" style="margin-bottom:8px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="warn-user">
      <input type="hidden" name="target" value="<%= post.author?._id %>">
      <input name="reason" placeholder="Reason for warning" required>
      <button class="button button-small button-ghost" type="submit">Send warning for approval</button>
    </form>
    <form method="post" action="/moderator/actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="suspend-user">
      <input type="hidden" name="target" value="<%= post.author?._id %>">
      <input name="reason" placeholder="Reason for suspension" required>
      <button class="button button-small button-danger" type="submit">Send suspension for approval</button>
    </form>
  </details>
  </article><% }) %></section>

  <section class="settings-block admin-wide"><h2>Community changes</h2><p>Propose edits to a community's description, guidelines, or banned-word list. An admin must approve before they apply.</p>
  <% communities.forEach((community) => { %>
  <details class="post-owner-tools"><summary><%= community.name %> · <%= community.membersCount %> members</summary>
    <form method="post" action="/moderator/actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="edit-community">
      <input type="hidden" name="target" value="<%= community._id %>">
      <label style="display:block;margin-bottom:6px;font-size:11px;color:var(--tx-lo);">Description<textarea name="payload[description]"><%= community.description %></textarea></label>
      <label style="display:block;margin-bottom:6px;font-size:11px;color:var(--tx-lo);">Guidelines<textarea name="payload[guidelines]"><%= community.guidelines || '' %></textarea></label>
      <label style="display:block;margin-bottom:6px;font-size:11px;color:var(--tx-lo);">Banned words (comma separated)<input name="payload[bannedWords]" value="<%= (community.bannedWords || []).join(', ') %>" style="width:100%;"></label>
      <input name="reason" placeholder="Why does this need changing?" required style="width:100%;margin-bottom:8px;">
      <button class="button button-small button-primary" type="submit">Send for approval</button>
    </form>
  </details>
  <% }) %></section>

  <section class="settings-block"><h2>Open reports</h2><p>New reports go here first. Recommend an outcome and an admin makes the final call before it's applied.</p><% if (!reports.length) { %><p>No open reports.</p><% } %><% reports.forEach((report) => { %><div class="device-row" style="flex-direction:column;align-items:stretch;"><div><strong><%= report.targetType %></strong><span> · reported by <%= report.reporter?.name || 'a member' %> · <%= report.reason %><% if (report.status === 'reviewing') { %> · <strong style="color:var(--ac-blue);">under review</strong><% } %></span><% if (report.evidenceUrl) { %><a href="<%= report.evidenceUrl %>" target="_blank" rel="noopener noreferrer"><img src="<%= report.evidenceUrl %>" alt="Reported evidence screenshot" style="max-width:140px;border-radius:6px;margin-top:6px;display:block;"></a><% } %></div>
  <% if (myOpenReportRecommendations.has(String(report._id))) { %>
  <p class="form-note">Your recommendation is waiting for admin approval.</p>
  <% } else if (report.status === 'reviewing') { %>
  <p class="form-note">Another moderator's recommendation is already waiting for admin approval.</p>
  <% } else { %>
  <form method="post" action="/moderator/actions" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" value="resolve-report">
    <input type="hidden" name="target" value="<%= report._id %>">
    <input name="reason" placeholder="Your notes for the admin" required style="flex:1;min-width:160px;">
    <button class="button button-small button-primary" name="payload[decision]" value="resolved">Recommend resolve</button>
    <button class="button button-small button-ghost" name="payload[decision]" value="dismissed">Recommend dismiss</button>
  </form>
  <% } %>
  </div><% }) %></section>
  <section class="settings-block" id="appeals"><h2>Pending appeals<% if (pendingAppeals.length) { %> (<%= pendingAppeals.length %>)<% } %></h2><p>Appeals of a suspension, posting restriction or warning. Approving lifts the action immediately.</p><% if (!pendingAppeals.length) { %><p>No pending appeals.</p><% } %><% pendingAppeals.forEach((appeal) => { %>
  <div class="device-row">
    <div>
      <strong><%= appeal.actionType %> · <%= appeal.user?.name || 'member' %> (<%= appeal.user?.email || 'unknown' %>)</strong>
      <span>Filed <%= new Date(appeal.createdAt).toLocaleString() %><% if (appeal.reasonSnapshot) { %> · original reason: <%= appeal.reasonSnapshot %><% } %></span>
      <p><%= appeal.message %></p>
    </div>
    <form method="post" action="/moderator/appeals/<%= appeal._id %>" style="display:flex;gap:6px;flex:1 1 260px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="note" placeholder="Review note (optional)" style="flex:1;min-width:0;background:transparent;border:1px solid var(--line);color:var(--tx-mid);border-radius:7px;padding:7px 9px;font-size:11px;">
      <button name="decision" value="approve" class="button button-small button-primary">Approve &amp; lift</button>
      <button name="decision" value="deny" class="button button-small button-ghost">Deny</button>
    </form>
  </div>
  <% }) %></section>
  <section class="settings-block"><h2>Your action history</h2><% actions.forEach((item) => { %><div class="device-row"><div><strong><%= item.action %></strong><span><%= item.targetType %> <%= item.target %> · <%= item.status %> · <%= item.reason %><% if (item.reviewNote) { %> · admin note: <%= item.reviewNote %><% } %></span></div></div><% }) %><% if (!actions.length) { %><p>No actions submitted yet.</p><% } %></section>
</main><%- include('../partials/app-footer') %><%- include('../partials/foot') %>
