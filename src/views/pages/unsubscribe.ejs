<%- include('../partials/head', { title, noIndex: true, bodyClass: 'auth-page' }) %>
<div class="auth-shell"><a class="brand auth-brand" href="/"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
<div class="auth-card">
<% if (state === 'confirm') { %>
  <p class="eyebrow">Email preferences</p>
  <h1>Stop come-back reminders?</h1>
  <p class="form-note">You will no longer get the "a question for you", "worth reading" and "what you missed" emails or pushes. Your other settings, like security alerts, stay as they are.</p>
  <form method="post" action="/unsubscribe/reminders/<%= id %>/<%= token %>"><button class="button button-primary button-full" type="submit">Yes, stop the reminders</button></form>
  <p class="form-note" style="margin-top:14px;"><a href="/">Keep them, take me to Crowdwide</a></p>
<% } else if (state === 'done') { %>
  <p class="eyebrow">All set</p>
  <h1>You are unsubscribed.</h1>
  <p class="form-note">We will not send come-back reminders any more. Changed your mind? Turn them back on any time in Settings → Notifications.</p>
  <a class="button button-primary button-full" href="/settings/notifications">Open notification settings</a>
<% } else if (state === 'error') { %>
  <p class="eyebrow">Something went wrong</p>
  <h1>We could not update that.</h1>
  <p class="form-note">Please try again in a moment, or switch the reminders off in Settings → Notifications.</p>
<% } else { %>
  <p class="eyebrow">Link not valid</p>
  <h1>That link did not work.</h1>
  <p class="form-note">It may be incomplete or from an old email. You can switch the reminders off any time in Settings → Notifications.</p>
  <a class="button button-primary button-full" href="/settings/notifications">Open notification settings</a>
<% } %>
</div></div>
<%- include('../partials/foot') %>
