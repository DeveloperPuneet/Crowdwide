<%- include('../partials/auth-shell-start', { title }) %>
<p class="eyebrow">A fresh start</p><h1>Forgot your<br><em>password?</em></h1><p class="form-note">Enter your email and we’ll send a reset link if we find your account.</p>
<form class="auth-form" method="post" action="/auth/forgot-password"><label>Email address<input type="email" name="email" placeholder="you@example.com" required></label><button class="button button-primary button-full" type="submit">Send reset link <span>↗</span></button></form>
<p class="switch-auth"><a href="/auth/login">← Back to sign in</a></p>
<%- include('../partials/auth-shell-end') %>
