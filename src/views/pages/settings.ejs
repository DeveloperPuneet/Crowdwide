<%- include('../partials/head', { title, bodyClass: 'dashboard-page' }) %>
<header class="app-nav"><a class="brand" href="/"><img src="/images/Crowdwide_logo.png" alt=""><span>Crowdwide</span></a><nav><a href="/dashboard">Home</a><a class="app-nav-active" href="/settings/profile">Settings</a></nav><div class="app-nav-actions"><a class="button button-small button-ghost" href="/dashboard">Back to app</a></div></header>
<main class="settings-layout"><aside class="settings-nav"><p class="eyebrow">Account center</p><h1>Settings</h1><a class="<%= section === 'profile' ? 'settings-active' : '' %>" href="/settings/profile">Profile</a><a class="<%= section === 'security' ? 'settings-active' : '' %>" href="/settings/security">Security & devices</a><a class="<%= section === 'privacy' ? 'settings-active' : '' %>" href="/settings/privacy">Privacy</a><a class="<%= section === 'account' ? 'settings-active' : '' %>" href="/settings/account">Account</a></aside><section class="settings-content"><%- include('../partials/flash') %><% if (section === 'profile') { %><p class="eyebrow">Identity</p><h2>Make your profile yours.</h2><form class="settings-form" method="post" action="/settings/profile" enctype="multipart/form-data"><label>Profile picture<input type="file" name="profilePicture" accept="image/*"><small>Images only, up to 1.5MB.</small></label><label>Display name<input name="name" value="<%= user.name %>" maxlength="80" required></label><label>Bio<textarea name="bio" maxlength="280" placeholder="What should people know about you?"><%= user.bio || '' %></textarea><small><%= (user.bio || '').length %>/280 characters</small></label><label>Profile privacy<select name="privacy"><option value="public" <%= user.privacy === 'public' ? 'selected' : '' %>>Public profile</option><option value="followers" <%= user.privacy === 'followers' ? 'selected' : '' %>>Followers only</option></select></label><button class="button button-primary" type="submit">Save profile <span>↗</span></button></form><% } else if (section === 'security') { %><p class="eyebrow">Safety first</p><h2>Password & devices.</h2><form class="settings-form compact" method="post" action="/settings/security/password"><label>Current password<input type="password" name="currentPassword" required></label><label>New password<input type="password" name="newPassword" minlength="8" required></label><button class="button button-primary" type="submit">Change password <span>↗</span></button></form><div class="settings-block"><div class="settings-block-heading"><div><h3>Where you are logged in</h3><p>Devices are tracked for 75 days.</p></div><form method="post" action="/settings/security/devices/logout-all"><button class="button button-small button-ghost" type="submit">Log out other devices</button></form></div><% sessions.forEach((device) => { %><div class="device-row"><span class="device-icon">◉</span><div><strong><%= device.userAgent || 'Unknown device' %></strong><span><%= device.ipAddress || 'Unknown location' %> · Last seen <%= new Date(device.lastSeenAt).toLocaleString() %></span></div><% if (device.sessionId === sessionID) { %><em>This device</em><% } else { %><form method="post" action="/settings/security/devices/<%= device._id %>/logout"><button class="round-action" aria-label="Log out device">×</button></form><% } %></div><% }) %></div><% } else if (section === 'privacy') { %><p class="eyebrow">Your boundaries</p><h2>Privacy controls.</h2><form class="settings-form compact" method="post" action="/settings/privacy"><label>Automatically log out inactive sessions<select name="inactivityLogoutDays"><option value="0" <%= user.inactivityLogoutDays === 0 ? 'selected' : '' %>>Never</option><option value="7" <%= user.inactivityLogoutDays === 7 ? 'selected' : '' %>>After 7 days</option><option value="30" <%= user.inactivityLogoutDays === 30 ? 'selected' : '' %>>After 30 days</option><option value="90" <%= user.inactivityLogoutDays === 90 ? 'selected' : '' %>>After 90 days</option></select></label><button class="button button-primary" type="submit">Save privacy settings <span>↗</span></button></form><div class="settings-block"><h3>What Crowdwide stores</h3><p>Your profile, posts, communities, and active device records are stored in MongoDB so the service can work across devices.</p></div><% } else { %><p class="eyebrow">Your account</p><h2>Take your data with you.</h2><div class="settings-block"><h3>Download your activity</h3><p>Get a JSON copy of your profile, posts, and communities you own.</p><a class="button button-small button-ghost" href="/settings/account/download">Request data download <span>↓</span></a></div><div class="settings-block danger-zone"><h3>Delete account</h3><p>This permanently removes your account, posts, sessions, and communities you own.</p><form method="post" action="/settings/account/delete"><input name="confirm" placeholder="Type DELETE to confirm" required><button class="button button-small button-danger" type="submit">Delete account</button></form></div><form method="post" action="/auth/logout"><button class="button button-small button-ghost" type="submit">Sign out this device</button></form><% } %></section></main><%- include('../partials/foot') %>
