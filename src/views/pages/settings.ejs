<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath: '/settings/' + section, noIndex: true }) %>
<%- include('../partials/app-nav', { active: 'settings', currentUser }) %>
<main class="settings-layout">
  <aside class="settings-nav">
    <p class="eyebrow">Account center</p><h1>Settings</h1>
    <a href="/u/<%= user._id %>" class="settings-link">View your public profile →</a>
    <nav class="settings-tabs">
      <a class="<%= section === 'profile' ? 'settings-active' : '' %>" href="/settings/profile">Profile</a>
      <a class="<%= section === 'security' ? 'settings-active' : '' %>" href="/settings/security">Security & devices</a>
      <a class="<%= section === 'privacy' ? 'settings-active' : '' %>" href="/settings/privacy">Privacy</a>
      <a class="<%= section === 'notifications' ? 'settings-active' : '' %>" href="/settings/notifications">Notifications</a>
      <a class="<%= section === 'history' ? 'settings-active' : '' %>" href="/settings/history">History</a>
      <% if (user.suspendedUntil || user.postingRestrictedUntil || user.warnings?.length || appeals.length) { %><a class="<%= section === 'moderation' ? 'settings-active' : '' %>" href="/settings/moderation">Moderation</a><% } %>
      <a class="<%= section === 'account' ? 'settings-active' : '' %>" href="/settings/account">Account</a>
    </nav>
  </aside>
  <section class="settings-content"><%- include('../partials/flash') %>
    <% if (section === 'profile') { %>
    <p class="eyebrow">Identity</p><h2>Make your profile yours.</h2>
    <form class="settings-form" method="post" action="/settings/profile" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Banner image<% if (user.bannerImage) { %><img src="<%= user.bannerImage %>" alt="" style="width:100%;object-fit:cover;border-radius:10px;border:1px solid var(--bd-1);margin-bottom:6px;"><% } %><input type="file" name="bannerImage" accept="image/*"><small>Shows at the top of your profile. Up to 1.5MB.</small></label>
      <label>Profile picture<%- include('../partials/avatar', { person: user, size: 'large', link: false }) %><input type="file" name="profilePicture" accept="image/*"><small>Images only, up to 1.5MB.</small></label>
      <label>Display name<input name="name" value="<%= user.name %>" maxlength="80" required></label>
      <label>Bio · up to 40 words<textarea name="bio" maxlength="2000" data-word-limit="40" aria-describedby="bio-word-count" placeholder="What should people know about you?"><%= user.bio || '' %></textarea><small id="bio-word-count" data-word-count><%= (user.bio || '').trim() ? (user.bio || '').trim().split(/\s+/).length : 0 %> / 40 words</small></label>
      <label>Profile hashtags<input name="hashtags" value="<%= (user.hashtags || []).map((tag) => `#${tag}`).join(' ') %>" placeholder="#design #music #makers"><small>Add topics people can use to find your profile.</small></label>
      <label>Links<small>Up to 4 - shown on your profile.</small><div class="link-fields"><% for (let i = 0; i < 4; i++) { const existing = (user.links || [])[i] || {}; %><div class="link-field-row"><input name="linkLabel<%= i %>" value="<%= existing.label || '' %>" placeholder="Label, e.g. Portfolio" maxlength="40"><input name="linkUrl<%= i %>" value="<%= existing.url || '' %>" placeholder="https://..." maxlength="300"></div><% } %></div></label>
      <label>Profile privacy<select name="privacy"><option value="public" <%= user.privacy === 'public' ? 'selected' : '' %>>Public profile</option><option value="followers" <%= user.privacy === 'followers' ? 'selected' : '' %>>Followers only</option></select></label>
      <button class="button button-primary" style="width:100%;" type="submit">Save profile <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button>
    </form>
    <% } else if (section === 'security') { %>
    <p class="eyebrow">Safety first</p><h2>Password & devices.</h2>
    <form class="settings-form compact" method="post" action="/settings/security/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Current password<input type="password" name="currentPassword" required></label><label>New password<input type="password" name="newPassword" minlength="8" required></label><button class="button button-primary" type="submit">Change password <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button></form>
    <div class="settings-block"><div class="settings-block-heading"><div><h3>Two-factor authentication</h3><p>Protect sign-in with an authenticator app or a one-time recovery code.</p></div><a class="button button-small button-ghost" href="/settings/security/2fa">Enable or manage 2FA <%- icon('arrow-up-right', { size: 13, className: 'inline-arrow' }) %></a></div></div>
    <div class="settings-block"><div class="settings-block-heading"><div><h3>Where you are logged in</h3><p>Devices are tracked for 75 days.</p></div><form method="post" action="/settings/security/devices/logout-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit">Log out other devices</button></form></div>
      <% sessions.forEach((device) => { %><div class="device-row"><span class="device-icon"><%- icon('monitor', { size: 16 }) %></span><div><strong><%= device.userAgent || 'Unknown device' %></strong><span><%= device.ipAddress || 'Unknown location' %> · Last seen <%= new Date(device.lastSeenAt).toLocaleString() %></span></div><% if (device.sessionId === sessionID) { %><em>This device</em><% } else { %><form method="post" action="/settings/security/devices/<%= device._id %>/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Log out device">×</button></form><% } %></div><% }) %>
    </div>
    <% } else if (section === 'privacy') { %>
    <p class="eyebrow">Your boundaries</p><h2>Privacy controls.</h2>
    <form class="settings-form compact" method="post" action="/settings/privacy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Automatically log out inactive sessions<select name="inactivityLogoutDays"><option value="0" <%= user.inactivityLogoutDays === 0 ? 'selected' : '' %>>Never</option><option value="7" <%= user.inactivityLogoutDays === 7 ? 'selected' : '' %>>After 7 days</option><option value="30" <%= user.inactivityLogoutDays === 30 ? 'selected' : '' %>>After 30 days</option><option value="90" <%= user.inactivityLogoutDays === 90 ? 'selected' : '' %>>After 90 days</option></select></label><button class="button button-primary" type="submit">Save privacy settings <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button></form>
    <div class="settings-block"><h3>Blocked accounts</h3><% if (!blockedUsers.length) { %><p>You haven't blocked anyone.</p><% } else { %><% blockedUsers.forEach((blocked) => { %><div class="device-row"><%- include('../partials/avatar', { person: blocked, size: 'tiny', link: false }) %><div><strong><%= blocked.name %></strong></div><form class="block-form" method="post" action="/users/<%= blocked._id %>/block"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Unblock <%= blocked.name %>">×</button></form></div><% }) %><% } %></div>
    <div class="settings-block"><h3>What Crowdwide stores</h3><p>Your profile, posts, communities, and active device records are stored in MongoDB so the service can work across devices.</p></div>
    <% } else if (section === 'notifications') { %>
    <p class="eyebrow">Choose your signal</p><h2>Notification preferences.</h2>
    <form class="settings-form compact notification-settings-form" method="post" action="/settings/notifications">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset class="notification-group">
        <legend>In-app notifications</legend>
        <p>Choose which activity appears in your notifications. Browser push follows these same choices.</p>
        <label class="notification-option"><span><strong>Likes on your posts</strong><small>Know when someone appreciates what you share.</small></span><input type="checkbox" name="notifyLikes" <%= user.notificationPreferences?.likes !== false ? 'checked' : '' %>></label>
        <% const commentNotificationMode = user.notificationPreferences?.comments === false ? 'off' : user.notificationPreferences?.mentionsOnly ? 'mentions' : 'all'; %>
        <label class="notification-option"><span><strong>Comments and replies</strong><small>Choose whether to get all replies, only @mentions, or no comment alerts.</small></span><select name="commentNotifications" aria-label="Comments and replies"><option value="all" <%= commentNotificationMode === 'all' ? 'selected' : '' %>>All comments and replies</option><option value="mentions" <%= commentNotificationMode === 'mentions' ? 'selected' : '' %>>Only @mentions</option><option value="off" <%= commentNotificationMode === 'off' ? 'selected' : '' %>>Off</option></select></label>
        <label class="notification-option"><span><strong>New followers</strong><small>Get a heads-up when someone joins your circle.</small></span><input type="checkbox" name="notifyFollows" <%= user.notificationPreferences?.follows !== false ? 'checked' : '' %>></label>
        <label class="notification-option"><span><strong>Direct messages</strong><small>Stay in the loop when people reach out.</small></span><input type="checkbox" name="notifyMessages" <%= user.notificationPreferences?.messages !== false ? 'checked' : '' %>></label>
        <label class="notification-option"><span><strong>Security alerts</strong><small>Important account and sign-in changes.</small></span><input type="checkbox" name="notifySecurity" <%= user.notificationPreferences?.security !== false ? 'checked' : '' %>></label>
      </fieldset>
      <fieldset class="notification-group">
        <legend>Email updates</legend>
        <p>Choose what Crowdwide sends to your inbox.</p>
        <label class="notification-option"><span><strong>Unread notification summary</strong><small>Email me when I have 5 unread notifications.</small></span><input type="checkbox" name="emailUnreadSummary" <%= user.notificationPreferences?.emailUnreadSummary !== false ? 'checked' : '' %>></label>
        <label class="notification-option"><span><strong>Weekly email newsletter</strong><small>Up to 20 new picks: 10 for you, 5 trending, and 5 from relevant communities. Posts are not repeated.</small></span><input type="checkbox" name="emailNewsletter" <%= user.notificationPreferences?.emailNewsletter !== false ? 'checked' : '' %>></label>
      </fieldset>
      <button class="button button-primary" type="submit">Save notification settings <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button>
    </form>
    <div class="settings-block">
      <h3>Browser push notifications</h3>
      <% if (!pushConfigured) { %>
      <p>Push notifications aren't configured on this server yet.</p>
      <% } else { %>
      <p>Get a notification on this device when someone likes, comments, follows, or mentions you - even when Crowdwide isn't open. Off by default; nothing is sent until you turn this on.</p>
      <label><span><input type="checkbox" id="push-toggle"> Enable push notifications on this device</span></label>
      <p class="form-note" id="push-status">Checking status…</p>
      <% } %>
    </div>
    <% } else if (section === 'history') { %>
    <p class="eyebrow">Your account</p><h2>Account history.</h2>
    <% if (!accountEvents.length) { %><p class="form-note">No account activity recorded yet.</p><% } %>
    <% const historyLabels = { 'login': 'Signed in', 'password-changed': 'Password changed', 'two-factor-enabled': 'Two-factor authentication turned on', 'two-factor-disabled': 'Two-factor authentication turned off', 'recovery-codes-regenerated': 'Recovery codes regenerated', 'suspended': 'Account suspended', 'suspension-lifted': 'Suspension lifted', 'posting-restricted': 'Posting restricted', 'posting-restriction-lifted': 'Posting restriction lifted', 'warning-issued': 'Warning issued', 'warning-removed': 'Warning removed', 'appeal-submitted': 'Appeal submitted', 'appeal-approved': 'Appeal approved', 'appeal-denied': 'Appeal denied' }; %>
    <% accountEvents.forEach((event) => { %>
    <div class="device-row"><div><strong><%= historyLabels[event.type] || event.type %></strong><span><%= new Date(event.createdAt).toLocaleString() %><% if (event.detail) { %> · <%= event.detail %><% } %></span></div></div>
    <% }) %>
    <% } else if (section === 'moderation') { %>
    <p class="eyebrow">Account standing</p><h2>Moderation status.</h2>
    <% if (user.postingRestrictedUntil && new Date(user.postingRestrictedUntil) > new Date()) { %>
    <div class="settings-block danger-zone">
      <h3>Posting restricted</h3>
      <p>You can't create new posts or comments until <%= new Date(user.postingRestrictedUntil).toLocaleString() %>.<% if (user.postingRestrictionReason) { %> Reason: <%= user.postingRestrictionReason %><% } %></p>
      <% const pendingRestrictionAppeal = appeals.find((appeal) => appeal.actionType === 'posting-restriction' && appeal.status === 'pending'); %>
      <% if (pendingRestrictionAppeal) { %><p><em>Your appeal is pending review.</em></p><% } else { %>
      <form method="post" action="/settings/appeals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="actionType" value="posting-restriction"><textarea name="message" maxlength="1000" placeholder="Explain why this restriction should be lifted" required></textarea><button class="button button-small" type="submit">Submit appeal</button></form>
      <% } %>
    </div>
    <% } %>
    <% (user.warnings || []).forEach((warning) => { %>
    <div class="settings-block">
      <h3>Warning · <%= new Date(warning.createdAt).toLocaleDateString() %></h3>
      <p><%= warning.reason %></p>
      <% const pendingWarningAppeal = appeals.find((appeal) => appeal.actionType === 'warning' && String(appeal.warningId) === String(warning._id) && appeal.status === 'pending'); %>
      <% if (pendingWarningAppeal) { %><p><em>Your appeal is pending review.</em></p><% } else { %>
      <form method="post" action="/settings/appeals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="actionType" value="warning"><input type="hidden" name="warningId" value="<%= warning._id %>"><textarea name="message" maxlength="1000" placeholder="Explain why this warning should be removed" required></textarea><button class="button button-small" type="submit">Submit appeal</button></form>
      <% } %>
    </div>
    <% }) %>
    <% if (appeals.length) { %>
    <div class="settings-block">
      <h3>Your appeal history</h3>
      <% appeals.forEach((appeal) => { %><div class="device-row"><div><strong><%= appeal.actionType %> · <%= appeal.status %></strong><span><%= new Date(appeal.createdAt).toLocaleDateString() %><% if (appeal.reviewNote) { %> · <%= appeal.reviewNote %><% } %></span></div></div><% }) %>
    </div>
    <% } %>
    <% } else { %>
    <p class="eyebrow">Your account</p><h2>Take your data with you.</h2>
    <div class="settings-block">
      <h3>Appearance</h3><p>Choose how Crowdwide looks on this device and your other signed-in sessions.</p>
      <form class="settings-form compact settings-theme-form" method="post" action="/settings/theme"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Theme<select name="theme"><option value="default" <%= (user.theme || 'default') === 'default' ? 'selected' : '' %>>Default</option><option value="light" <%= user.theme === 'light' ? 'selected' : '' %>>Light</option><option value="dark" <%= user.theme === 'dark' ? 'selected' : '' %>>Dark</option><option value="violet" <%= user.theme === 'violet' ? 'selected' : '' %>>Violet · high contrast</option><option value="pink" <%= user.theme === 'pink' ? 'selected' : '' %>>Light pink</option></select></label>
        <button class="button button-primary" type="submit">Save theme</button>
      </form>
    </div>
    <div class="settings-block"><h3>Download your activity</h3><p>Get a JSON copy of your profile, posts, and communities you own.</p><a class="button button-small button-ghost" href="/settings/account/download">Request data download <span>↓</span></a></div>
    <div class="settings-block danger-zone"><h3>Delete account</h3><p>This permanently removes your account, posts, sessions, and communities you own.</p><form method="post" action="/settings/account/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="confirm" placeholder="Type DELETE to confirm" required><button class="button button-small button-danger" type="submit">Delete account</button></form></div>
    <form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit">Sign out this device</button></form>
    <% } %>
  </section>
</main>
<%- include('../partials/app-footer') %><%- include('../partials/foot') %>
