<%- include('../partials/head', { title, bodyClass: 'crowdwide-ai-page', pagePath, noIndex, aiPage: true }) %>
<%- include('../partials/app-nav', { active: 'ai', currentUser, sideNav: true, hideBottomNav: true }) %>
<main class="cw-ai" id="crowdwide-ai" data-model="HuggingFaceTB/SmolLM2-135M-Instruct">
  <button class="cw-ai-sidebar-backdrop" type="button" aria-label="Close conversation list" data-ai-sidebar-backdrop hidden></button>
  <aside class="cw-ai-sidebar" aria-label="Crowdwide AI conversations">
    <div class="cw-ai-sidebar-top">
      <a class="cw-ai-brand" href="/crowdwide-ai" aria-label="Crowdwide AI home">
        <span class="cw-ai-mark" aria-hidden="true"><%- icon('sparkles', { size: 20 }) %></span>
        <span><strong>Crowdwide</strong><small>AI</small></span>
      </a>
      <button class="cw-ai-icon-button" type="button" data-ai-settings-open aria-label="AI settings" title="AI settings"><%- icon('settings', { size: 18 }) %></button>
    </div>
    <button class="cw-ai-new" type="button" data-ai-new><%- icon('plus', { size: 17 }) %> New conversation</button>
    <label class="cw-ai-search">
      <%- icon('search', { size: 16 }) %>
      <input type="search" placeholder="Search conversations" aria-label="Search conversations" data-ai-conversation-search>
    </label>
    <div class="cw-ai-conversation-heading">
      <span>Recent conversations</span>
      <button class="cw-ai-text-button" type="button" data-ai-memory-open>Memory</button>
    </div>
    <nav class="cw-ai-conversations" aria-label="Previous conversations" data-ai-conversations></nav>
    <p class="cw-ai-sidebar-note">Your conversations and memories are private to your account.</p>
  </aside>

  <section class="cw-ai-chat" aria-label="Chat with Crowdwide AI">
    <header class="cw-ai-topbar">
      <div class="cw-ai-topbar-title">
        <button class="cw-ai-icon-button cw-ai-sidebar-toggle" type="button" data-ai-sidebar-toggle aria-label="Open conversation list"><%- icon('menu', { size: 19 }) %></button>
        <span class="cw-ai-mark cw-ai-mark-small" aria-hidden="true"><%- icon('sparkles', { size: 16 }) %></span>
        <div><h1 data-ai-title>Crowdwide AI</h1><p data-ai-mode>On-device AI · grounded in public Crowdwide discussions</p></div>
      </div>
      <button class="cw-ai-icon-button cw-ai-mobile-settings" type="button" data-ai-settings-open aria-label="AI settings"><%- icon('settings', { size: 18 }) %></button>
    </header>

    <div class="cw-ai-thread" data-ai-thread aria-live="polite" aria-relevant="additions text">
      <section class="cw-ai-welcome" data-ai-welcome>
        <div class="cw-ai-orbit" aria-hidden="true"><span><%- icon('sparkles', { size: 30 }) %></span><i></i><b></b></div>
        <p class="cw-ai-eyebrow">YOUR CROWDWIDE SIDEKICK</p>
        <h2>Curious about your community?</h2>
        <p class="cw-ai-welcome-copy">I can search public posts, discussions, profiles, communities and trends. I’ll show my sources—and I won’t pretend a search result is a fact it doesn’t contain.</p>
        <div class="cw-ai-suggestions" data-ai-suggestions>
          <button type="button" data-prompt="What are the latest discussions on Crowdwide?">What’s being discussed lately?</button>
          <button type="button" data-prompt="Find posts about community building">Find posts about a topic</button>
          <button type="button" data-prompt="What topics are trending on Crowdwide?">What’s trending?</button>
          <button type="button" data-prompt="Find public communities about art">Find a community</button>
        </div>
      </section>
      <div class="cw-ai-messages" data-ai-messages></div>
    </div>

    <div class="cw-ai-composer-wrap">
      <p class="cw-ai-live-status" role="status" aria-live="polite" data-ai-status></p>
      <form class="cw-ai-composer" data-ai-form>
        <label class="visually-hidden" for="cw-ai-input">Message Crowdwide AI</label>
        <textarea id="cw-ai-input" rows="1" maxlength="4000" placeholder="Ask about posts, people, communities…" data-ai-input required></textarea>
        <div class="cw-ai-composer-bottom">
          <span class="cw-ai-composer-hint"><%- icon('shield', { size: 13 }) %> Crowdwide data only · no paid AI API</span>
          <div class="cw-ai-composer-actions">
            <button class="cw-ai-stop" type="button" data-ai-stop hidden><%- icon('square', { size: 14 }) %> Stop</button>
            <button class="cw-ai-send" type="submit" data-ai-send aria-label="Send message"><%- icon('arrow-up', { size: 17 }) %></button>
          </div>
        </div>
      </form>
      <p class="cw-ai-disclaimer">On-device AI runs on your device. It prefers GPU when available and otherwise uses CPU; verified search answers are the fallback if inference is unavailable.</p>
    </div>
  </section>
</main>

<dialog class="cw-ai-dialog" data-ai-settings>
  <form method="dialog" class="cw-ai-dialog-head">
    <div><p class="cw-ai-eyebrow">YOUR ASSISTANT</p><h2>AI settings</h2></div>
    <button class="cw-ai-icon-button" aria-label="Close settings"><%- icon('x', { size: 19 }) %></button>
  </form>
  <div class="cw-ai-dialog-content">
    <label class="cw-ai-setting-row">
      <span><strong>On-device AI</strong><small>Run an open model on this device. Your prompt and retrieved Crowdwide text are processed locally after they load in your browser.</small></span>
      <input type="checkbox" data-ai-local-toggle checked>
    </label>
    <div class="cw-ai-model-note">
      <strong>SmolLM2 · 135M · 4-bit</strong>
      <p>Downloads about 118 MB of GPU or 182 MB of CPU/WASM model weights from Hugging Face on first use and caches them in this browser. A GPU fallback may download both variants. Inference runs in a background worker; allow roughly 0.5–1 GB of free memory while it runs. Speed depends on your device.</p>
      <p>No model runs on Crowdwide’s Render server. If the browser, memory, download or inference is unsupported, verified search results remain available. This model is Apache-2.0 licensed.</p>
    </div>
    <label class="cw-ai-setting-field">Inference device
      <select data-ai-device-select>
        <option value="auto">Automatic (GPU, then CPU)</option>
        <option value="cpu">CPU (WASM)</option>
        <option value="gpu">GPU (fallback to CPU)</option>
      </select>
    </label>
    <label class="cw-ai-setting-field">AI appearance
      <select data-ai-theme-select>
        <option value="auto">Match Crowdwide</option>
        <option value="dark">Dark</option>
        <option value="light">Light</option>
      </select>
    </label>
    <p class="cw-ai-dialog-status" role="status" data-ai-settings-status></p>
    <button class="button button-primary" type="button" data-ai-settings-save>Save settings</button>
  </div>
</dialog>

<dialog class="cw-ai-dialog cw-ai-memory-dialog" data-ai-memory>
  <form method="dialog" class="cw-ai-dialog-head">
    <div><p class="cw-ai-eyebrow">PRIVATE TO YOU</p><h2>Assistant memory</h2></div>
    <button class="cw-ai-icon-button" aria-label="Close memory"><%- icon('x', { size: 19 }) %></button>
  </form>
  <div class="cw-ai-dialog-content">
    <p class="cw-ai-memory-help">Only memories you add here are kept between conversations. On-device AI uses them for personalization; they never override Crowdwide permissions or trusted system rules. You can edit or remove them any time.</p>
    <form class="cw-ai-memory-form" data-ai-memory-form>
      <label>Memory type
        <select name="kind"><option value="preference">Preference</option><option value="ongoing_task">Ongoing task</option><option value="summary">Conversation summary</option></select>
      </label>
      <label>What should I remember?
        <textarea name="text" maxlength="1000" rows="3" placeholder="For example: I prefer concise answers with links to sources." required></textarea>
      </label>
      <button class="button button-primary" type="submit">Add memory</button>
    </form>
    <p class="cw-ai-dialog-status" role="status" data-ai-memory-status></p>
    <div class="cw-ai-memory-list" data-ai-memory-list></div>
  </div>
</dialog>
<%- include('../partials/foot') %>
