<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'home', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="recap-layout">
	<a class="back-link" href="/dashboard">← Back to your feed</a>
	<header class="recap-heading">
		<p class="eyebrow">A year of showing up</p>
		<h1>Your Crowdwide recap</h1>
		<p><%= recap.periodLabel %></p>
	</header>
	<section class="recap-stats" aria-label="Activity totals">
		<div class="recap-stat"><span>Published posts</span><strong><%= recap.totals.posts.toLocaleString() %></strong></div>
		<div class="recap-stat"><span>Comments</span><strong><%= recap.totals.comments.toLocaleString() %></strong></div>
		<div class="recap-stat"><span>In-app shares</span><strong><%= recap.totals.shares.toLocaleString() %></strong></div>
		<div class="recap-stat"><span>Communities now</span><strong><%= recap.totals.communities.toLocaleString() %></strong></div>
	</section>
	<section class="recap-panel">
		<div class="recap-section-heading"><div><p class="eyebrow">Your activity</p><h2>Month by month</h2></div><div class="recap-legend" aria-label="Chart legend"><span><i class="recap-key-posts"></i>Posts</span><span><i class="recap-key-comments"></i>Comments</span><span><i class="recap-key-shares"></i>Shares</span></div></div>
		<% if (recap.totals.posts || recap.totals.comments || recap.totals.shares) { %>
		<div class="recap-chart" role="img" aria-label="Monthly totals for posts, comments, and in-app shares">
			<% recap.months.forEach((month) => { %>
			<div class="recap-month" aria-label="<%= month.fullLabel %>: <%= month.posts %> posts, <%= month.comments %> comments, <%= month.shares %> in-app shares">
				<div class="recap-bar-track"><div class="recap-bar">
					<span class="recap-bar-posts" style="height:<%= month.postsHeight %>%"></span>
					<span class="recap-bar-comments" style="height:<%= month.commentsHeight %>%"></span>
					<span class="recap-bar-shares" style="height:<%= month.sharesHeight %>%"></span>
				</div></div>
				<span class="recap-month-label"><%= month.label %></span>
			</div>
			<% }) %>
		</div>
		<ul class="visually-hidden" aria-label="Activity by month">
			<% recap.months.forEach((month) => { %><li><%= month.fullLabel %>: <%= month.posts %> posts, <%= month.comments %> comments, <%= month.shares %> in-app shares</li><% }) %>
		</ul>
		<% } else { %>
		<p class="recap-empty">Your next post, comment, or share will start this timeline.</p>
		<% } %>
	</section>
	<% if (recap.topTopics?.length) { %>
	<section class="recap-panel recap-topics">
		<div class="recap-section-heading"><div><p class="eyebrow">Your themes</p><h2>Topics you shared most</h2></div><span class="recap-muted">From hashtags on your published posts</span></div>
		<div class="recap-topic-list"><% recap.topTopics.forEach((topic, index) => { %><span class="recap-topic"><b><%= String(index + 1).padStart(2, '0') %></b><span>#<%= topic.tag %></span><small><%= topic.posts %> post<%= topic.posts === 1 ? '' : 's' %></small></span><% }) %></div>
		<div class="recap-month-topics"><% recap.months.filter((month) => month.topics?.length).forEach((month) => { %><div><strong><%= month.fullLabel %></strong><span><%= month.topics.map((topic) => `#${topic.tag}`).join(' · ') %></span></div><% }) %></div>
	</section>
	<% } %>
	<% if (recap.topPost) { %>
	<section class="recap-panel recap-highlight">
		<div><p class="eyebrow">A conversation starter</p><h2>Your most-engaged post</h2></div>
		<blockquote><%= recap.topPost.body %></blockquote>
		<div class="recap-highlight-meta"><span><%= recap.topPost.type === 'article' ? 'Article' : recap.topPost.type === 'poll' ? 'Poll' : 'Post' %></span><span><%= new Date(recap.topPost.createdAt).toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %></span><span><%= recap.topPost.engagement.toLocaleString() %> reactions, comments, and shares</span></div>
	</section>
	<% } %>
	<% if (recap.topComment) { %>
	<section class="recap-panel recap-highlight recap-comment-highlight">
		<div><p class="eyebrow">A conversation you moved</p><h2>Your most-interacted comment</h2></div>
		<blockquote><%= recap.topComment.body || 'Media comment' %></blockquote>
		<div class="recap-highlight-meta"><span><%= recap.topComment.interactions.toLocaleString() %> interactions</span><span><%= new Date(recap.topComment.createdAt).toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %></span>
		<% if (recap.topComment.post?._id) { %><a href="/posts/<%= recap.topComment.post._id %>#replies">View conversation</a><% } %></div>
		<% if (recap.topComment.post?.body) { %><p class="recap-comment-context">On: <%= recap.topComment.post.body.slice(0, 160) %><%= recap.topComment.post.body.length > 160 ? '…' : '' %></p><% } %>
	</section>
	<% } %>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
