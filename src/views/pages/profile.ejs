<%- include('../partials/head', { title, description: profileUser.bio, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: '', currentUser }) %>
<% const displayedPosts = profileTab === 'likes' ? profileLikes : profileTab === 'saved' ? savedPosts : posts; %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="<%= isSelf ? 'profile-layout' : 'community-detail' %>">
	<div>
	<a class="back-link" href="/dashboard">← Back to feed</a>
	<% if (profileUser.bannerImage) { %><div class="profile-banner"><img src="<%= profileUser.bannerImage %>" alt=""></div><% } %>
	<section class="profile-hero">
		<div class="profile-hero-top">
			<div class="profile-identity">
				<%- include('../partials/avatar', { person: profileUser, size: 'large', link: false }) %>
				<div>
					<h1><%= profileUser.name %><% if (profileUser.isVerified) { %><span class="verified-tick" title="Verified">✔</span><% } %></h1>
					<p class="profile-handle">@<%= profileUser.email.split('@')[0] %></p>
				</div>
			</div>
			<div class="profile-actions">
				<% if (isSelf) { %>
				<a class="button button-ghost button-small" href="/settings/profile">Edit profile</a>
				<% } else { %>
				<form class="follow-form" data-user="<%= profileUser._id %>" method="post" action="/users/<%= profileUser._id %>/follow">
					<input type="hidden" name="_csrf" value="<%= csrfToken %>">
					<button class="follow-button <%= isFollowing ? 'is-following' : '' %>" type="submit"><%= isFollowing ? 'Following' : isFollowingBack ? 'Follow back' : 'Follow' %></button>
				</form>
				<form class="block-form" method="post" action="/users/<%= profileUser._id %>/block">
					<input type="hidden" name="_csrf" value="<%= csrfToken %>">
					<button class="block-button <%= isBlocked ? 'is-blocked' : '' %>" type="submit"><%= isBlocked ? 'Blocked' : 'Block' %></button>
				</form>
				<form class="mute-form" data-user="<%= profileUser._id %>" method="post" action="/users/<%= profileUser._id %>/mute"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mute-button <%= isMuted ? 'is-muted' : '' %>" type="submit"><%= isMuted ? 'Unmute' : 'Mute' %></button></form>
				<% if (!isBlocked) { %><a class="button button-ghost button-small" href="/messages/<%= profileUser._id %>">Message</a><% } %>
				<% } %>
			</div>
		</div>
		<% if (profileUser.bio) { %><p class="profile-bio"><%= profileUser.bio %></p><% } %>
		<% if ((profileUser.hashtags || []).length) { %><div class="hashtag-row profile-hashtags"><% profileUser.hashtags.forEach((tag) => { %><a class="hashtag-chip" href="/search?q=%23<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
		<% if ((profileUser.links || []).length) { %>
		<div class="profile-links">
			<% profileUser.links.forEach((link) => { %><a class="profile-link-chip" href="<%= link.url %>" target="_blank" rel="noopener noreferrer nofollow">🔗 <%= link.label %></a><% }) %>
		</div>
		<% } %>
		<div class="profile-stats">
			<span><strong><%= postCount %></strong> posts</span>
			<a href="/u/<%= profileUser._id %>/followers" style="color:inherit;text-decoration:none;"><strong class="follower-count" data-user="<%= profileUser._id %>"><%= followersCount %></strong> followers</a>
			<a href="/u/<%= profileUser._id %>/following" style="color:inherit;text-decoration:none;"><strong><%= followingCount %></strong> following</a>
		</div>
		<p class="profile-joined">Joined <%= new Date(profileUser.createdAt).toLocaleDateString(undefined, { month: 'long', year: 'numeric' }) %></p>
		<div class="profile-engagement">
			<div class="panel-heading"><h2>Activity stats</h2><span>All time</span></div>
			<div class="engagement-grid">
				<div><strong><%- icon('heart', { size: 15 }) %><%= profileStats.totalLikes.toLocaleString() %></strong><span>Likes received</span></div>
				<div><strong><%- icon('message-circle', { size: 15 }) %><%= profileStats.totalComments.toLocaleString() %></strong><span>Comments received</span></div>
				<div><strong><%- icon('eye', { size: 15 }) %><%= profileStats.totalViews.toLocaleString() %></strong><span>Views</span></div>
				<div><strong><%- icon('send', { size: 15 }) %><%= profileStats.totalShares.toLocaleString() %></strong><span>Shares</span></div>
			</div>
		</div>
	</section>
	<nav class="profile-tabs" aria-label="Profile sections">
		<a class="<%= profileTab === 'posts' ? 'profile-tab-active' : '' %>" href="/u/<%= profileUser._id %>?tab=posts">Posts</a>
		<a class="<%= profileTab === 'activity' ? 'profile-tab-active' : '' %>" href="/u/<%= profileUser._id %>?tab=activity">Activity</a>
		<a class="<%= profileTab === 'likes' ? 'profile-tab-active' : '' %>" href="/u/<%= profileUser._id %>?tab=likes">Likes</a>
		<a class="<%= profileTab === 'comments' ? 'profile-tab-active' : '' %>" href="/u/<%= profileUser._id %>?tab=comments">Comments</a>
		<% if (isSelf) { %><a class="<%= profileTab === 'saved' ? 'profile-tab-active' : '' %>" href="/u/<%= profileUser._id %>?tab=saved">Saved</a><% } %>
	</nav>

	<% if (isSelf && profileTab === 'activity') { %>
	<section class="community-posts activity-section">
		<div class="panel-heading"><h2>Recent activity</h2><span>You</span></div>
		<% activity.forEach((item) => { %>
		<div class="activity-row">
			<span class="activity-icon"><%- icon(item.kind === 'like' ? 'heart' : 'message-circle', { size: 15 }) %></span>
			<% if (item.kind === 'like') { %>
			<p>You liked <a href="/posts/<%= item.post._id %>"><%= item.post.author?.name || 'a post' %>'s post</a><br><small><%= (item.post.body || '').slice(0, 90) %><%= (item.post.body || '').length > 90 ? '…' : '' %></small></p>
			<% } else { %>
			<p>You commented on <a href="/posts/<%= item.comment.post._id %>">a post</a><br><small>"<%= (item.comment.body || '').slice(0, 90) %><%= (item.comment.body || '').length > 90 ? '…' : '' %>"</small></p>
			<% } %>
		</div>
		<% }) %>
	</section>
	<% } %>
	<% if (profileTab === 'comments') { %>
	<section class="community-posts activity-section">
		<div class="panel-heading"><h2><%= isSelf ? 'Your comments' : `${profileUser.name}'s comments` %></h2><span><%= profileComments.length %></span></div>
		<% if (!profileComments.length) { %><div class="empty-feed"><h2>No comments yet.</h2><p>This profile has not joined a conversation yet.</p></div><% } %>
		<% profileComments.forEach((comment) => { %>
		<div class="activity-row"><span class="activity-icon"><%- icon('message-circle', { size: 15 }) %></span><p><%= isSelf ? 'You' : profileUser.name %> commented on <a href="/posts/<%= comment.post?._id %>">a post</a><br><small>"<%= comment.body %>"</small></p></div>
		<% }) %>
	</section>
	<% } %>

	<section class="community-posts">
		<% if (profileTab !== 'activity' && profileTab !== 'comments') { %>
		<div class="panel-heading"><h2><%= profileTab === 'likes' ? `${profileUser.name}'s likes` : profileTab === 'saved' ? 'Saved posts' : isSelf ? 'Your posts' : `${profileUser.name}'s posts` %></h2><span><%= displayedPosts.length %></span></div>
		<% if (!displayedPosts.length) { %>
		<div class="empty-feed"><h2><%= profileTab === 'saved' ? 'No saved posts yet.' : 'No posts yet.' %></h2><p><%= isSelf ? 'Posts and conversations you collect will appear here.' : 'This person has not posted yet.' %></p></div>
		<% } %>
		<% displayedPosts.forEach((post) => { %>
		<%- include('../partials/post-card', { post, csrfToken, hideSource: true }) %>
		<% }) %>
		<% } %>
	</section>
	</div>

	<% if (isSelf) { %>
	<aside class="discover-column">
		<section class="discover-panel">
			<div class="panel-heading"><h2>People to follow</h2><span>Popular</span></div>
			<% if (!suggestions.length) { %><p style="color:#777a91;font-size:12px;padding:10px 0;">Follow a few people to see suggestions here.</p><% } %>
			<% suggestions.forEach((person) => { %>
			<div class="discover-row">
				<%- include('../partials/avatar', { person, size: 'tiny' }) %>
				<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span><%= person.followers %> follower<%= person.followers === 1 ? '' : 's' %></span></div>
				<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>">+</button></form>
			</div>
			<% }) %>
		</section>
		<a class="settings-link" href="/explore">Explore Crowdwide →</a>
	</aside>
	<% } %>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
