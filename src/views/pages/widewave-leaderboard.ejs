<%- include('../partials/head', { title, description, pagePath, bodyClass: 'ww-body' }) %>
<% if (locals.currentUser) { %>
<%- include('../partials/app-nav', { active: 'widewaves', currentUser }) %>
<% } else { %>
<header class="site-nav container public-posts-nav">
	<a class="brand" href="/"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
	<div><a class="button button-small button-ghost" href="/auth/login">Sign in</a><a class="button button-small button-primary" href="/auth/register">Join Crowdwide</a></div>
</header>
<% } %>
<main class="ww-page ww-narrow">
	<a class="back-link" href="/widewaves">← All WideWaves</a>
	<p class="eyebrow">Leaderboard</p>
	<h1>Most posts in a WideWave</h1>
	<nav class="feed-tabs" aria-label="Time range">
		<% Object.entries(periods).forEach(([key, label]) => { %><a class="<%= period === key ? 'feed-tab-active' : '' %>" href="/widewaves/leaderboard?period=<%= key %>"><%= label %></a><% }) %>
	</nav>
	<% if (!rows.length) { %><div class="empty-feed"><h2>No posts in this range yet.</h2><p>Post in a WideWave and put it on the board.</p></div><% } %>
	<ol class="ww-board">
		<% rows.forEach((wave) => { %>
		<li class="ww-board-row <%= wave.rank <= 3 ? 'is-podium' : '' %>">
			<%- include('../partials/widewave-card', { wave, rank: wave.rank, stat: `${wave.periodPosts.toLocaleString()} post${wave.periodPosts === 1 ? '' : 's'} · ${wave.writers} writer${wave.writers === 1 ? '' : 's'}` }) %>
		</li>
		<% }) %>
	</ol>
</main>
<% if (locals.currentUser) { %><%- include('../partials/app-footer') %><% } else { %><%- include('../partials/site-footer') %><% } %>
<%- include('../partials/foot') %>
