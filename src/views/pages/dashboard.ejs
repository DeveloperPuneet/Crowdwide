<% const wordLimits = locals.wordLimits || { post: 60, article: 300, poll: 60 }; %>
<% const coAuthorSuggestions = locals.coAuthorSuggestions || []; %>
<% const composerCommunities = locals.composerCommunities || communities || []; %>
<% const availableQuests = locals.availableQuests || []; %>
<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'home', currentUser, sideNav: true }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<div class="sidebar-scrim" data-sidebar-scrim hidden></div>
<main class="app-layout dashboard-modern sidebar-collapsed">
	<aside class="app-sidebar">
		<button class="sidebar-toggle" type="button" data-sidebar-toggle aria-expanded="false" aria-controls="dashboard-sidebar" aria-label="Open sidebar"><%- icon('chevron-left', { size: 15 }) %></button>
		<div id="dashboard-sidebar">
		<%- include('../partials/side-links', { active: 'home', currentUser, openSurveys: locals.openSurveys || [] }) %>
		</div>
	</aside>
	<section class="feed-column">
		<button class="composer-prompt" type="button" data-composer-open aria-expanded="false" aria-controls="composer">
			<%- include('../partials/avatar', { person: locals.profileUser || currentUser, size: 'small', link: false }) %>
			<span class="composer-prompt-text">Share something…</span><span class="composer-prompt-plus"><%- icon('plus', { size: 16 }) %></span>
		</button>
		<%
	const feedTabs = [
		['for-you', '/dashboard?view=for-you', 'For you', 'sparkles', ['for-you']],
		['my-community', '/dashboard?view=my-community&feed=personalized', 'My community', 'users', ['my-community']],
		['posts', '/dashboard?view=posts-new', 'Posts', 'file-text', ['posts-new', 'posts-viral']],
		['articles', '/dashboard?view=articles-new', 'Articles', 'edit', ['articles-new', 'articles-viral']]
	];
	const subSorts = feed.activeTab.startsWith('posts-') ? ['posts', 'Posts'] : feed.activeTab.startsWith('articles-') ? ['articles', 'Articles'] : null;
%>
		<nav class="feed-tabs" aria-label="Feed views">
			<% feedTabs.forEach(([id, href, label, glyph, views]) => { const on = views.includes(feed.activeTab); %><a class="<%= on ? 'feed-tab-active' : '' %>" href="<%= href %>" <%- on ? 'aria-current="page"' : '' %>><span><%= label %></span></a>
			<% }) %>
		</nav>
		<% if (subSorts) { %>
		<nav class="feed-subtabs" aria-label="Sort <%= subSorts[1].toLowerCase() %>">
			<a class="<%= feed.activeTab.endsWith('-new') ? 'is-on' : '' %>" href="/dashboard?view=<%= subSorts[0] %>-new">New</a>
			<a class="<%= feed.activeTab.endsWith('-viral') ? 'is-on' : '' %>" href="/dashboard?view=<%= subSorts[0] %>-viral">Viral</a>
		</nav>
		<% } %>
		<% if (locals.awayInfo) { %>
		<aside class="welcome-back-card" aria-label="While you were away">
			<div class="welcome-back-head"><span class="welcome-back-icon"><%- icon('sparkles', { size: 20 }) %></span><div><strong>Welcome back!</strong><p>Here is what happened in the last <%= awayInfo.days === 1 ? 'day' : awayInfo.days + ' days' %>.</p></div></div>
			<ul class="welcome-back-stats">
				<% if (awayInfo.comments) { %><li><b><%= awayInfo.comments %></b> new <%= awayInfo.comments === 1 ? 'reply' : 'replies' %></li><% } %>
				<% if (awayInfo.likes) { %><li><b><%= awayInfo.likes %></b> <%= awayInfo.likes === 1 ? 'like' : 'likes' %></li><% } %>
				<% if (awayInfo.follows) { %><li><b><%= awayInfo.follows %></b> new <%= awayInfo.follows === 1 ? 'follower' : 'followers' %></li><% } %>
				<% if (awayInfo.mentions) { %><li><b><%= awayInfo.mentions %></b> <%= awayInfo.mentions === 1 ? 'mention' : 'mentions' %></li><% } %>
				<% if (awayInfo.communityPosts) { %><li><b><%= awayInfo.communityPosts %></b> new in your communities</li><% } %>
			</ul>
			<% if (awayInfo.topPost) { %><p class="welcome-back-top">Busiest right now<%= awayInfo.topPost.community ? ' in ' + awayInfo.topPost.community : '' %>: <a href="/posts/<%= awayInfo.topPost._id %>"><%= awayInfo.topPost.text %></a></p><% } %>
			<div class="welcome-back-actions"><a class="button button-small button-primary" href="/notifications">See notifications</a><button class="button button-small button-ghost" type="button" data-welcome-back-close>Dismiss</button></div>
		</aside>
		<% } %>
		<% if (locals.qotd) { %>
		<aside class="qotd-card" aria-label="Question of the Day">
			<div class="qotd-body"><p class="eyebrow">Question of the Day</p><strong><%= qotd.text %></strong><span><%= qotdAnswers ? qotdAnswers + (qotdAnswers === 1 ? ' answer' : ' answers') + ' so far today' : 'Be the first to answer today' %> · <a href="/question">See answers</a></span><% if (locals.streakInfo) { %><span class="streak-line <%= streakInfo.current ? 'is-live' : '' %>"><%- icon('flame', { size: 14 }) %> <%= streakInfo.current ? (streakInfo.doneToday ? streakInfo.current + '-day streak - done for today' : streakInfo.current + '-day streak - post or comment today to keep it') : 'Start a streak: post or comment today' %></span><% } %></div>
			<a class="button button-small button-primary" href="/dashboard?ask=qotd" data-qotd-answer data-prefill="<%= qotd.text %>&#10;&#10;#<%= qotd.tag %>">Answer</a>
		</aside>
		<% } %>
		<form class="composer composer-hidden" id="composer" method="post" action="/posts" enctype="multipart/form-data" data-prefill="<%= locals.composerPrefill || '' %>" data-word-limits='{"post":<%= wordLimits.post %>,"article":<%= wordLimits.article %>,"poll":<%= wordLimits.poll %>}'>
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<%- include('../partials/avatar', { person: locals.profileUser || currentUser, size: 'small', link: false }) %>
			<div class="composer-body">
				<textarea data-mention-input name="body" placeholder="What are you curious about today?" maxlength="4000" required></textarea>
				<div class="composer-meta"><div class="word-limit-status"><span data-word-count>0 / <%= wordLimits.post %> words</span><div class="word-limit-meter" role="progressbar" aria-label="Word limit" aria-valuemin="0" aria-valuemax="<%= wordLimits.post %>" aria-valuenow="0"><span data-word-progress></span></div></div><div class="hashtag-suggestions" data-hashtag-suggestions></div></div>
				<fieldset class="poll-composer" hidden><legend>Poll choices</legend><input name="pollQuestion" maxlength="200" placeholder="Ask a question" style="margin-bottom:1rem;"><div class="poll-option-grid"><input name="pollOptions" maxlength="80" placeholder="Option 1"><input name="pollOptions" maxlength="80" placeholder="Option 2"><input name="pollOptions" maxlength="80" placeholder="Option 3"><input name="pollOptions" maxlength="80" placeholder="Option 4"></div></fieldset>
				<div class="composer-actions" style="margin-bottom: 10px;">
					<select name="type" aria-label="Post type"><option value="post">Post · <%= wordLimits.post %> words</option><option value="article">Article · <%= wordLimits.article %> words</option><option value="poll">Poll · <%= wordLimits.poll %> words</option></select>
					<select name="community" data-community-select<%- composerCommunities.length || locals.selectedCommunityId ? "" : " hidden" %> aria-label="Choose a community"><option value="">Open Crowdwide</option><% composerCommunities.forEach((community) => { %><option value="<%= community._id %>" <%= String(community._id) === String(locals.selectedCommunityId || '') ? 'selected' : '' %>><%= community.name %></option><% }) %></select>
					<button class="button button-ghost button-small" type="button" data-composer-close>Cancel</button>
					<button class="button button-primary button-small" type="submit">Publish <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button>
				</div>
				<details class="composer-options">
					<summary>Media, schedule &amp; more</summary>
					<div class="composer-option-grid">
					<button class="button button-ghost button-small composer-draft" type="submit" name="saveAsDraft" value="on">Save as draft</button>
					<label class="quest-post-picker"><span>Post for quest (optional)</span><select name="quest" data-quest-picker aria-label="Link this post to a quest" aria-describedby="quest-post-help"><option value="">No quest</option><% availableQuests.forEach((quest) => { %><option value="<%= quest._id %>" data-community="<%= quest.community?._id %>" <%= String(quest._id) === String(locals.selectedQuestId || '') ? 'selected' : '' %>><%= quest.title %> · <%= quest.community?.name || 'Community' %></option><% }) %></select></label>
					<label class="schedule-picker">Schedule<input type="datetime-local" name="scheduledAt" min="<%= new Date(Date.now() + 60000).toISOString().slice(0, 16) %>"></label>
					<label class="schedule-picker">Content warning<input name="contentWarning" maxlength="120" placeholder="Optional label"></label>
					<div class="coauthor-picker">
						<div class="coauthor-picker-head"><span>Co-authors</span><small>Optional</small></div>
						<% if (!coAuthorSuggestions.length) { %>
						<p class="coauthor-empty">Follow someone or invite a follower to collaborate.</p>
						<% } else { %>
						<div class="coauthor-chip-list">
							<% coAuthorSuggestions.forEach((person) => { %>
							<label class="coauthor-chip">
								<input type="checkbox" name="coAuthors" value="<%= person._id %>">
								<span class="coauthor-avatar"><%= (person.name || 'C').charAt(0).toUpperCase() %></span>
								<span><%= person.name %></span>
							</label>
							<% }) %>
						</div>
						<% } %>
					</div>
					<label class="media-picker">Add media<input type="file" name="media" accept="image/*,video/*,audio/*" multiple></label>
					<small class="quest-picker-hint" id="quest-post-help" data-quest-hint><%= availableQuests.length ? 'Choose one of the active quests you have joined; its community will be selected for you.' : 'Join an active community quest to link a post to it.' %></small>
					</div>
					<details class="composer-media-details">
						<summary>Media details (alt text, caption, transcript)</summary>
						<% [1, 2].forEach((n) => { %>
						<fieldset class="composer-media-meta" data-media-meta="<%= n %>">
							<legend>File <%= n %><%= n === 2 ? ' (if you attach a second file)' : '' %></legend>
							<label>Alt text (for screen readers)<input name="mediaAlt" maxlength="280" placeholder="Describe this file"></label>
							<label>Caption (shown under it)<input name="mediaCaption" maxlength="280" placeholder="Optional caption"></label>
							<label>Transcript (for audio/video)<textarea name="mediaTranscript" maxlength="4000" placeholder="Optional transcript"></textarea></label>
						</fieldset>
						<% }) %>
					</details>
					<small class="upload-help">Image &lt; 1.5MB · Video &lt; 4MB · Audio &lt; 2MB · up to 2 files. Use **bold**, *italic*, "# heading" and "- list" lines for formatting, and triple backticks for code.</small>
				</details>
			</div>
		</form>
		<%
	const emptyCopy = {
		'my-community': ['Your community feed is waiting.', 'Join a community to see its posts appear here.'],
		'posts-viral': ['Nothing is going viral yet.', 'Posts that pick up likes, comments and shares will rise here.'],
		'articles-viral': ['No articles are trending yet.', 'Articles readers engage with will rise here.'],
		'articles-new': ['No articles yet.', `Be the first to publish one - articles can be up to ${wordLimits.article} words.`]
	};
	const [emptyTitle, emptyText] = emptyCopy[feed.activeTab] || ['Your feed starts with curiosity.', 'Follow someone, join a community, or share the first thought that gets the conversation moving.'];
	%>
		<% if (!feed.visiblePosts.length) { %>
		<section class="empty-feed">
			<div class="empty-orbit"><img src="/images/Crowdwide_logo_192.png" alt=""></div>
			<h2><%= emptyTitle %></h2>
			<p><%= emptyText %></p>
			<a class="button button-dark button-small" href="/explore">Explore communities <span><%- icon('arrow-up-right', { size: 14 }) %></span></a>
		</section>
		<% } %>
		<div id="feed-posts"><% feed.visiblePosts.forEach((post, postIndex) => { %><%- include('../partials/post-card', { post, csrfToken }) %><% (locals.sitewideFeedAds || []).filter((ad) => ad.afterPost === postIndex + 1).forEach((ad) => { %><%- include('../partials/community-ad', { ad, csrfToken }) %><% }) %><% }) %>
		<% if (!feed.visiblePosts.length) { %><% (locals.sitewideFeedAds || []).filter((ad) => ad.afterPost === 0).forEach((ad) => { %><%- include('../partials/community-ad', { ad, csrfToken }) %><% }) %><% } %></div>
		<% if (feed.visiblePosts.length && feed.hasMore) { %>
		<div id="feed-sentinel" data-feed-view="<%= feed.activeTab %>" data-page="1"></div>
		<% } %>
		<p id="feed-end-note" class="upload-help feed-end-note" style="display:<%= feed.visiblePosts.length && !feed.hasMore ? 'block' : 'none' %>;">You're all caught up.</p>
	</section>
	<aside class="discover-column" id="explore">
		<section class="discover-panel" id="communities">
			<div class="panel-heading"><h2>Communities for you</h2><a href="/explore">See all <%- icon('arrow-up-right', { size: 13, className: 'inline-arrow' }) %></a></div>
			<% if (!communities.length) { %>
			<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">No new communities to suggest right now — start one below.</p>
			<% } %>
			<% communities.forEach((community) => { %>
			<div class="discover-row">
				<a href="/communities/<%= community.slug %>" class="community-glyph" style="color:inherit;"><% if (community.avatarImage) { %><img src="<%= community.avatarImage %>" alt="" class="community-card-avatar-image"><% } else { %><%= (community.name || '?').trim().charAt(0).toUpperCase() || '?' %><% } %></a>
				<div><strong><a class="name-link" href="/communities/<%= community.slug %>"><%= community.name %></a></strong><span><%= (community.membersCount || 0).toLocaleString() %> members</span></div>
				<% if (String(community.owner) === String(currentUser.id)) { %><a class="joined-mark" href="/communities/<%= community._id %>/manage">Manage</a>
				<% } else if (!joinedCommunities.includes(String(community._id))) { %><form method="post" action="/communities/<%= community._id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Join <%= community.name %>"><%- icon('plus', { size: 14 }) %></button></form>
				<% } else { %><span class="joined-mark">Joined</span><% } %>
			</div>
			<% }) %>
			<a class="panel-link" href="/communities/mine">Start a community</a>
		</section>
		<section class="discover-panel" id="people">
			<div class="panel-heading"><h2>People to follow</h2><a href="/people">See all <%- icon('arrow-up-right', { size: 13, className: 'inline-arrow' }) %></a></div>
			<% if (!people.length) { %>
			<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">You're following everyone who's joined so far.</p>
			<% } %>
			<% people.forEach((person) => { %>
			<div class="discover-row">
				<%- include('../partials/avatar', { person, size: 'tiny' }) %>
				<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span>New voice on Crowdwide</span></div>
				<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>"><%- icon('plus', { size: 14 }) %></button></form>
			</div>
			<% }) %>
		</section>
	</aside>
</main>
<script nonce="<%= locals.cspNonce || '' %>">
document.addEventListener('DOMContentLoaded', function () {
  var cards = document.querySelectorAll('[data-community-ad][data-context-type="sitewide"]');
  if (!('IntersectionObserver' in window)) return;
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      observer.unobserve(entry.target);
      var card = entry.target;
      fetch('/ads/' + encodeURIComponent(card.dataset.campaignId) + '/impression', {
        method: 'POST',
        credentials: 'same-origin',
        keepalive: true,
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': card.dataset.csrf },
        body: JSON.stringify({ deliveryContext: 'sitewide', eventToken: card.dataset.eventToken })
      }).then(function (response) {
        if (!response.ok) console.error('Advertisement impression tracking failed:', response.status);
      }).catch(function (error) {
        console.error('Advertisement impression tracking failed:', error);
      });
    });
  }, { threshold: 0.5 });
  cards.forEach(function (card) { observer.observe(card); });
});
</script>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
