<%- include('../partials/head', { title, bodyClass: 'dashboard-page' }) %>
<header class="app-nav"><a class="brand" href="/"><img src="/images/Crowdwide_logo.png" alt="Crowdwide logo"><span>Crowdwide</span></a><nav><a class="app-nav-active" href="/dashboard">Home</a><a href="/explore">Explore</a><a href="#communities">Communities</a></nav><div class="app-nav-actions"><button class="icon-button" aria-label="Search">⌕</button><a class="notification-button" href="/notifications" aria-label="Notifications"><span>♢</span><b class="notification-badge" hidden>0</b></a><span class="welcome">Hey, <%= currentUser.name.split(' ')[0] %></span></div></header>
<main class="app-layout">
	<aside class="app-sidebar"><div class="sidebar-profile"><div class="profile-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></div><div><strong><%= currentUser.name %></strong><span>@<%= currentUser.email.split('@')[0] %></span></div></div><nav class="side-links"><a class="side-active" href="/dashboard">◉ <span>Home feed</span></a><a href="/explore">◎ <span>Explore</span></a><a href="#communities">⌂ <span>Communities</span></a><a href="#people">♧ <span>People to follow</span></a></nav><div class="sidebar-note"><span>✦</span><p><strong>Make room for new voices.</strong><br>Every follow shapes your Crowdwide.</p></div></aside>
	<section class="feed-column"><div class="feed-heading"><div><p class="eyebrow">Your corner of Crowdwide</p><h1>Good to see you, <em><%= currentUser.name.split(' ')[0] %>.</em></h1></div><a class="button button-primary" href="#composer">Share something <span>+</span></a></div>
		<div class="feed-tabs"><a class="<%= feed.label === 'Normal feed' ? 'feed-tab-active' : '' %>" href="/dashboard">For you</a><a class="<%= feed.label === 'Personalized feed' ? 'feed-tab-active' : '' %>" href="/dashboard?feed=personalized">My communities</a><span><%= feed.note %></span></div>
		<form class="composer" id="composer" method="post" action="/posts" enctype="multipart/form-data"><div class="profile-avatar small"><%= currentUser.name.charAt(0).toUpperCase() %></div><div class="composer-body"><textarea name="body" placeholder="What are you curious about today?" maxlength="50000" required></textarea><div class="composer-actions"><select name="type" aria-label="Post type"><option value="post">Post · 5,000 chars</option><option value="article">Article · 50,000 chars</option></select><select name="community" aria-label="Choose a community"><option value="">Open Crowdwide</option><% communities.forEach((community) => { if (community._id) { %><option value="<%= community._id %>"><%= community.name %></option><% } }) %></select><label class="media-picker">Add media<input type="file" name="media" accept="image/*,video/*,audio/*"></label><button class="button button-primary button-small" type="submit">Publish <span>↗</span></button></div><small class="upload-help">Image &lt; 1.5MB · Video &lt; 4MB · Audio &lt; 2MB</small></div></form>
		<% if (!feed.posts.length) { %><section class="empty-feed"><div class="empty-orbit"><img src="/images/Crowdwide_logo.png" alt=""></div><h2><%= feed.label === 'Personalized feed' ? 'Your community feed is waiting.' : 'Your feed starts with curiosity.' %></h2><p>Join a community or share the first thought that gets the conversation moving.</p><a class="button button-dark button-small" href="#communities">Explore communities <span>↗</span></a></section><% } %>
		<% feed.posts.forEach((post) => { %><article class="post-card" id="post-<%= post._id %>"><div class="post-meta"><div class="profile-avatar small"><%= post.author?.name?.charAt(0).toUpperCase() || '?' %></div><div><strong><%= post.author?.name || 'Crowdwide member' %></strong><span><%= post.type === 'article' ? 'Article' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %></span></div><span class="post-source"><%= post.feedSource || 'From your communities' %></span></div><p class="post-body"><%= post.body %></p><% (post.media || []).forEach((media) => { if (media.kind === 'image') { %><img src="<%= media.thumbnailUrl || media.url %>" alt="<%= media.alt || 'Post image' %>"><% } else if (media.kind === 'video') { %><video controls src="<%= media.url %>"></video><% } else if (media.kind === 'audio') { %><audio controls src="<%= media.url %>"></audio><% } }) %><div class="post-actions"><form method="post" action="/posts/<%= post._id %>/like"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= post.liked ? '♥' : '♡' %> <%= post.likes?.length || 0 %></button></form><form method="post" action="/posts/<%= post._id %>/bookmark"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= post.bookmarked ? '▣ Saved' : '▱ Save' %></button></form><form method="post" action="/posts/<%= post._id %>/share"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">↗ Share <%= post.sharesCount || 0 %></button></form><span>◌ <%= post.commentsCount || 0 %></span></div><% if (post.comments?.length) { %><div class="comment-thread"><% post.comments.forEach((comment) => { %><div class="comment"><strong><%= comment.author?.name || 'Member' %></strong><span><%= comment.body %></span><form method="post" action="/posts/<%= post._id %>/comments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="parent" value="<%= comment._id %>"><input name="body" maxlength="2000" placeholder="Reply to <%= comment.author?.name || 'this comment' %>" required><button type="submit">Reply</button></form></div><% }) %></div><% } %><form class="comment-form" method="post" action="/posts/<%= post._id %>/comments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="body" maxlength="2000" placeholder="Add a thoughtful comment..." required><button type="submit">Comment</button></form></article><% }) %>
	</section>
	<aside class="discover-column" id="explore"><section class="discover-panel" id="communities"><div class="panel-heading"><h2>Explore communities</h2><a href="/explore">See all ↗</a></div><% communities.forEach((community) => { %><div class="discover-row"><div class="community-glyph">✦</div><div><strong><%= community.name %></strong><span><%= (community.membersCount || 0).toLocaleString() %> members</span></div><% if (community._id && String(community.owner) === String(currentUser.id)) { %><a class="joined-mark" href="/communities/<%= community._id %>/manage">Manage</a><% } else if (community._id && !joinedCommunities.includes(String(community._id))) { %><form method="post" action="/communities/<%= community._id %>/join"><button class="round-action" aria-label="Join <%= community.name %>">+</button></form><% } else if (community._id) { %><span class="joined-mark">Joined</span><% } %></div><% }) %><form class="create-community" method="post" action="/communities"><input name="name" placeholder="Create a community" required><input name="description" placeholder="What is it about?" required><input name="category" placeholder="Category e.g. design"><label class="privacy-check"><input type="checkbox" name="isPrivate"> Private community</label><button class="button button-dark button-small" type="submit">Create <span>+</span></button></form></section><section class="discover-panel" id="people"><div class="panel-heading"><h2>People to follow</h2><span>New</span></div><% people.forEach((person) => { %><div class="discover-row"><div class="profile-avatar tiny"><%= person.name.charAt(0).toUpperCase() %></div><div><strong><%= person.name %></strong><span>New voice on Crowdwide</span></div><% if (!following.includes(String(person._id))) { %><form method="post" action="/users/<%= person._id %>/follow"><button class="round-action" aria-label="Follow <%= person.name %>">+</button></form><% } else { %><span class="joined-mark">Following</span><% } %></div><% }) %></section><a class="settings-link" href="/settings/profile">Account settings →</a></aside>
</main>
<%- include('../partials/foot') %>
