<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'home', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="app-layout">
	<aside class="app-sidebar">
		<button class="sidebar-toggle" type="button" data-sidebar-toggle aria-expanded="true" aria-controls="dashboard-sidebar" aria-label="Close sidebar">×</button>
		<div id="dashboard-sidebar">
		<div class="sidebar-profile">
			<%- include('../partials/avatar', { person: currentUser }) %>
			<div><strong><%= currentUser.name %></strong><span>@<%= currentUser.email.split('@')[0] %></span></div>
		</div>
		<nav class="side-links">
			<a class="side-active" href="/dashboard">◉ <span>Home feed</span></a>
			<a href="/explore">◎ <span>Explore</span></a>
			<a href="/communities">⌂ <span>Communities</span></a>
			<a href="/u/<%= currentUser.id %>">✦ <span>Your profile</span></a>
			<a href="/notifications">&#128276; <span>Notifications</span></a>
			<a href="#people">♧ <span>People to follow</span></a>
		</nav>
		<div class="sidebar-note"><span>✦</span><p><strong>Make room for new voices.</strong><br>Every follow shapes your Crowdwide.<br><a href="/guide" style="color:#8da0ff;">Read tips to grow →</a></p></div>
		</div>
	</aside>
	<section class="feed-column">
		<div class="feed-heading">
			<div><p class="eyebrow">Your corner of Crowdwide</p><h1>Good to see you, <em><%= currentUser.name.split(' ')[0] %>.</em></h1></div>
			<button class="button button-primary" type="button" data-composer-open>Share something <span>+</span></button>
		</div>
		<div class="feed-tabs">
			<a class="<%= feed.activeTab === 'for-you' ? 'feed-tab-active' : '' %>" href="/dashboard?view=for-you">For you</a>
			<a class="<%= feed.activeTab === 'my-community' ? 'feed-tab-active' : '' %>" href="/dashboard?view=my-community&feed=personalized">My community</a>
			<a class="<%= feed.activeTab === 'posts-new' ? 'feed-tab-active' : '' %>" href="/dashboard?view=posts-new">Posts · New</a>
			<a class="<%= feed.activeTab === 'posts-viral' ? 'feed-tab-active' : '' %>" href="/dashboard?view=posts-viral">Posts · Viral</a>
			<a class="<%= feed.activeTab === 'articles-new' ? 'feed-tab-active' : '' %>" href="/dashboard?view=articles-new">Articles · New</a>
			<a class="<%= feed.activeTab === 'articles-viral' ? 'feed-tab-active' : '' %>" href="/dashboard?view=articles-viral">Articles · Viral</a>
			<span><%= feed.note %></span>
		</div>
		<form class="composer composer-hidden" id="composer" method="post" action="/posts" enctype="multipart/form-data" data-word-limits='{"post":120,"article":550}'>
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<%- include('../partials/avatar', { person: currentUser, size: 'small', link: false }) %>
			<div class="composer-body">
				<textarea data-mention-input name="body" placeholder="What are you curious about today?" maxlength="4000" required></textarea>
				<div class="composer-meta"><div class="word-limit-status"><span data-word-count>0 / 120 words</span><div class="word-limit-meter" role="progressbar" aria-label="Word limit" aria-valuemin="0" aria-valuemax="120" aria-valuenow="0"><span data-word-progress></span></div></div><div class="hashtag-suggestions" data-hashtag-suggestions></div></div>
				<fieldset class="poll-composer" hidden><legend>Poll choices</legend><input name="pollQuestion" maxlength="200" placeholder="Ask a question"><div class="poll-option-grid"><input name="pollOptions" maxlength="80" placeholder="Option 1"><input name="pollOptions" maxlength="80" placeholder="Option 2"><input name="pollOptions" maxlength="80" placeholder="Option 3"><input name="pollOptions" maxlength="80" placeholder="Option 4"></div></fieldset>
				<div class="composer-actions">
					<select name="type" aria-label="Post type"><option value="post">Post · 120 words</option><option value="article">Article · 550 words</option><option value="poll">Poll · 120 words</option></select>
					<select name="community" aria-label="Choose a community"><option value="">Open Crowdwide</option><% communities.forEach((community) => { %><option value="<%= community._id %>"><%= community.name %></option><% }) %></select>
					<label class="schedule-picker">Schedule<input type="datetime-local" name="scheduledAt" min="<%= new Date(Date.now() + 60000).toISOString().slice(0, 16) %>"></label>
					<label class="schedule-picker">Content warning<input name="contentWarning" maxlength="120" placeholder="Optional label"></label>
					<label class="media-picker">Add media<input type="file" name="media" accept="image/*,video/*,audio/*" multiple></label>
					<button class="button button-ghost button-small" type="submit" name="saveAsDraft" value="on">Save draft</button>
					<button class="button button-primary button-small" type="submit">Publish <span>↗</span></button>
				</div>
				<div class="composer-media-meta">
					<label>Alt text (for screen readers)<input name="mediaAlt" maxlength="280" placeholder="Describe the media"></label>
					<label>Caption (shown under the media)<input name="mediaCaption" maxlength="280" placeholder="Optional caption"></label>
					<label>Transcript (for audio/video)<textarea name="mediaTranscript" maxlength="4000" placeholder="Optional transcript"></textarea></label>
				</div>
				<small class="upload-help">Image &lt; 1.5MB · Video &lt; 4MB · Audio &lt; 2MB · up to 2 files · use **bold**, *italic*, "# heading", and "- list" lines for richer formatting</small>
			</div>
		</form>
		<% if (!feed.visiblePosts.length) { %>
		<section class="empty-feed">
			<div class="empty-orbit"><img src="/images/Crowdwide_logo.png" alt=""></div>
			<h2><%= feed.label === 'Personalized feed' ? 'Your community feed is waiting.' : 'Your feed starts with curiosity.' %></h2>
			<p><%= feed.label === 'Personalized feed' ? 'Join a community to see its posts appear here.' : 'Follow someone, join a community, or share the first thought that gets the conversation moving.' %></p>
			<a class="button button-dark button-small" href="/explore">Explore communities <span>↗</span></a>
		</section>
		<% } %>
		<div id="feed-posts"><% feed.visiblePosts.forEach((post) => { %><%- include('../partials/post-card', { post, csrfToken }) %><% }) %></div>
		<% if (feed.visiblePosts.length) { %>
		<div id="feed-sentinel" data-feed-mode="<%= feed.label === 'Personalized feed' ? 'personalized' : 'normal' %>" data-feed-view="<%= feed.activeTab %>" data-cursor="<%= feed.visiblePosts[feed.visiblePosts.length - 1].createdAt.toISOString ? feed.visiblePosts[feed.visiblePosts.length - 1].createdAt.toISOString() : feed.visiblePosts[feed.visiblePosts.length - 1].createdAt %>"></div>
		<p id="feed-end-note" class="upload-help" style="display:none;text-align:center;padding:18px 0;">You're all caught up.</p>
		<% } %>
	</section>
	<aside class="discover-column" id="explore">
		<section class="discover-panel" id="communities">
			<div class="panel-heading"><h2>Explore communities</h2><a href="/explore">See all ↗</a></div>
			<% if (!communities.length) { %>
			<p style="color:#777a91;font-size:12px;padding:10px 0;">No communities yet — be the first to start one below.</p>
			<% } %>
			<% communities.forEach((community) => { %>
			<div class="discover-row">
				<a href="/communities/<%= community.slug %>" class="community-glyph" style="color:inherit;">✦</a>
				<div><strong><a class="name-link" href="/communities/<%= community.slug %>"><%= community.name %></a></strong><span><%= (community.membersCount || 0).toLocaleString() %> members</span></div>
				<% if (String(community.owner) === String(currentUser.id)) { %><a class="joined-mark" href="/communities/<%= community._id %>/manage">Manage</a>
				<% } else if (!joinedCommunities.includes(String(community._id))) { %><form method="post" action="/communities/<%= community._id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Join <%= community.name %>">+</button></form>
				<% } else { %><span class="joined-mark">Joined</span><% } %>
			</div>
			<% }) %>
			<form class="create-community" method="post" action="/communities"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Create a community" required><input name="description" placeholder="What is it about?" required><input name="category" placeholder="Category e.g. design"><label class="privacy-check"><input type="checkbox" name="isPrivate"> Private community</label><button class="button button-dark button-small" type="submit">Create <span>+</span></button></form>
		</section>
		<section class="discover-panel" id="people">
			<div class="panel-heading"><h2>People to follow</h2><span>New</span></div>
			<% if (!people.length) { %>
			<p style="color:#777a91;font-size:12px;padding:10px 0;">You're following everyone who's joined so far.</p>
			<% } %>
			<% people.forEach((person) => { %>
			<div class="discover-row">
				<%- include('../partials/avatar', { person, size: 'tiny' }) %>
				<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span>New voice on Crowdwide</span></div>
				<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>">+</button></form>
			</div>
			<% }) %>
		</section>
		<a class="settings-link" href="/settings/profile">Account settings →</a>
	</aside>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
