<%- include('../partials/head', { title, bodyClass: 'dashboard-page' }) %>
<header class="app-nav"><a class="brand" href="/"><img src="/images/Crowdwide_logo.png" alt=""><span>Crowdwide</span></a><nav><a class="app-nav-active" href="/dashboard">Home</a><a href="#explore">Explore</a><a href="#communities">Communities</a></nav><div class="app-nav-actions"><button class="icon-button" aria-label="Search">⌕</button><span class="welcome">Hey, <%= currentUser.name.split(' ')[0] %></span><form method="post" action="/auth/logout"><button class="button button-small button-ghost" type="submit">Sign out</button></form></div></header>
<main class="app-layout">
	<aside class="app-sidebar"><div class="sidebar-profile"><div class="profile-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></div><div><strong><%= currentUser.name %></strong><span>@<%= currentUser.email.split('@')[0] %></span></div></div><nav class="side-links"><a class="side-active" href="/dashboard">◉ <span>Home feed</span></a><a href="#explore">◎ <span>Explore</span></a><a href="#communities">⌂ <span>Communities</span></a><a href="#people">♧ <span>People to follow</span></a></nav><div class="sidebar-note"><span>✦</span><p><strong>Make room for new voices.</strong><br>Every follow shapes your Crowdwide.</p></div></aside>
	<section class="feed-column"><div class="feed-heading"><div><p class="eyebrow">Your corner of Crowdwide</p><h1>Good to see you, <em><%= currentUser.name.split(' ')[0] %>.</em></h1></div><a class="button button-primary" href="#composer">Share something <span>+</span></a></div>
		<div class="feed-tabs"><a class="<%= feed.label === 'Normal feed' ? 'feed-tab-active' : '' %>" href="/dashboard">For you</a><a class="<%= feed.label === 'Personalized feed' ? 'feed-tab-active' : '' %>" href="/dashboard?feed=personalized">My communities</a><span><%= feed.note %></span></div>
		<form class="composer" id="composer" method="post" action="/posts"><div class="profile-avatar small"><%= currentUser.name.charAt(0).toUpperCase() %></div><div class="composer-body"><textarea name="body" placeholder="What are you curious about today?" maxlength="5000" required></textarea><div class="composer-actions"><select name="type" aria-label="Post type"><option value="post">Post</option><option value="article">Article</option></select><select name="community" aria-label="Choose a community"><option value="">Open Crowdwide</option><% communities.forEach((community) => { if (community._id) { %><option value="<%= community._id %>"><%= community.name %></option><% } }) %></select><button class="button button-primary button-small" type="submit">Publish <span>↗</span></button></div></div></form>
		<% if (!feed.posts.length) { %><section class="empty-feed"><div class="empty-orbit"><img src="/images/Crowdwide_logo.png" alt=""></div><h2><%= feed.label === 'Personalized feed' ? 'Your community feed is waiting.' : 'Your feed starts with curiosity.' %></h2><p>Join a community or share the first thought that gets the conversation moving.</p><a class="button button-dark button-small" href="#communities">Explore communities <span>↗</span></a></section><% } %>
		<% feed.posts.forEach((post) => { %><article class="post-card"><div class="post-meta"><div class="profile-avatar small"><%= post.author?.name?.charAt(0).toUpperCase() || '?' %></div><div><strong><%= post.author?.name || 'Crowdwide member' %></strong><span><%= post.type === 'article' ? 'Article' : 'Post' %> · <%= post.community?.name || 'Open Crowdwide' %></span></div><span class="post-source"><%= post.feedSource || 'From your communities' %></span></div><p class="post-body"><%= post.body %></p><div class="post-actions"><button type="button">♡ <%= post.likes?.length || 0 %></button><button type="button">◌ <%= post.commentsCount || 0 %></button><button type="button">↗ Share</button></div></article><% }) %>
	</section>
	<aside class="discover-column" id="explore"><section class="discover-panel" id="communities"><div class="panel-heading"><h2>Explore communities</h2><span>Live</span></div><% communities.forEach((community) => { %><div class="discover-row"><div class="community-glyph">✦</div><div><strong><%= community.name %></strong><span><%= (community.membersCount || 0).toLocaleString() %> members</span></div><% if (community._id && !joinedCommunities.includes(String(community._id))) { %><form method="post" action="/communities/<%= community._id %>/join"><button class="round-action" aria-label="Join <%= community.name %>">+</button></form><% } else if (community._id) { %><span class="joined-mark">Joined</span><% } %></div><% }) %><form class="create-community" method="post" action="/communities"><input name="name" placeholder="Create a community" required><input name="description" placeholder="What is it about?" required><button class="button button-dark button-small" type="submit">Create <span>+</span></button></form></section><section class="discover-panel" id="people"><div class="panel-heading"><h2>People to follow</h2><span>New</span></div><% people.forEach((person) => { %><div class="discover-row"><div class="profile-avatar tiny"><%= person.name.charAt(0).toUpperCase() %></div><div><strong><%= person.name %></strong><span>New voice on Crowdwide</span></div><% if (!following.includes(String(person._id))) { %><form method="post" action="/users/<%= person._id %>/follow"><button class="round-action" aria-label="Follow <%= person.name %>">+</button></form><% } else { %><span class="joined-mark">Following</span><% } %></div><% }) %></section></aside>
</main>
<%- include('../partials/foot') %>
