<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'home', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="app-layout">
	<aside class="app-sidebar">
		<button class="sidebar-toggle" type="button" data-sidebar-toggle aria-expanded="true" aria-controls="dashboard-sidebar" aria-label="Close sidebar"><%- icon('chevron-left', { size: 15 }) %></button>
		<div id="dashboard-sidebar">
		<div class="sidebar-profile">
			<%- include('../partials/avatar', { person: currentUser }) %>
			<div><strong><%= currentUser.name %></strong><span>@<%= currentUser.email.split('@')[0] %></span></div>
		</div>
		<nav class="side-links">
			<a class="side-active" href="/dashboard"><%- icon('home') %> <span>Home feed</span></a>
			<a href="/explore"><%- icon('compass') %> <span>Explore</span></a>
			<a href="/communities"><%- icon('users') %> <span>Communities</span></a>
			<a href="/u/<%= currentUser.id %>"><%- icon('user') %> <span>Your profile</span></a>
			<a href="/notifications"><%- icon('bell') %> <span>Notifications</span></a>
			<a href="#people"><%- icon('plus') %> <span>People to follow</span></a>
		</nav>
		<div class="sidebar-note"><span><%- icon('sparkles', { size: 20 }) %></span><p><strong>Make room for new voices.</strong><br>Every follow shapes your Crowdwide.<br><a href="/guide" style="color:#8da0ff;">Read tips to grow →</a></p></div>
		</div>
	</aside>
	<section class="feed-column">
		<div class="feed-heading">
			<div><p class="eyebrow">Your corner of Crowdwide</p><h1>Good to see you, <em><%= currentUser.name.split(' ')[0] %>.</em></h1></div>
			<button class="button button-primary" type="button" data-composer-open aria-expanded="false" aria-controls="composer">Share something <span><%- icon('plus', { size: 16 }) %></span></button>
		</div>
		<%
	const feedTabs = [
		['for-you', '/dashboard?view=for-you', 'For you', 'sparkles'],
		['my-community', '/dashboard?view=my-community&feed=personalized', 'My community', 'users'],
		['posts-new', '/dashboard?view=posts-new', 'Posts · New', 'clock'],
		['posts-viral', '/dashboard?view=posts-viral', 'Posts · Viral', 'flame'],
		['articles-new', '/dashboard?view=articles-new', 'Articles · New', 'file-text'],
		['articles-viral', '/dashboard?view=articles-viral', 'Articles · Viral', 'trending-up']
	];
%>
		<nav class="feed-tabs" aria-label="Feed views">
			<% feedTabs.forEach(([id, href, label, glyph]) => { %><a class="<%= feed.activeTab === id ? 'feed-tab-active' : '' %>" href="<%= href %>" <%- feed.activeTab === id ? 'aria-current="page"' : '' %>><%- icon(glyph, { size: 15 }) %><span><%= label %></span></a><% }) %>
		</nav>
		<p class="feed-note"><%= feed.note %></p>
		<form class="composer composer-hidden" id="composer" method="post" action="/posts" enctype="multipart/form-data" data-word-limits='{"post":120,"article":550}'>
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<%- include('../partials/avatar', { person: currentUser, size: 'small', link: false }) %>
			<div class="composer-body">
				<textarea data-mention-input name="body" placeholder="What are you curious about today?" maxlength="4000" required></textarea>
				<div class="composer-meta"><div class="word-limit-status"><span data-word-count>0 / 120 words</span><div class="word-limit-meter" role="progressbar" aria-label="Word limit" aria-valuemin="0" aria-valuemax="120" aria-valuenow="0"><span data-word-progress></span></div></div><div class="hashtag-suggestions" data-hashtag-suggestions></div></div>
				<fieldset class="poll-composer" hidden><legend>Poll choices</legend><input name="pollQuestion" maxlength="200" placeholder="Ask a question"><div class="poll-option-grid"><input name="pollOptions" maxlength="80" placeholder="Option 1"><input name="pollOptions" maxlength="80" placeholder="Option 2"><input name="pollOptions" maxlength="80" placeholder="Option 3"><input name="pollOptions" maxlength="80" placeholder="Option 4"></div></fieldset>
				<div class="composer-actions">
					<select name="type" aria-label="Post type"><option value="post">Post · 120 words</option><option value="article">Article · 550 words</option><option value="poll">Poll · 120 words</option></select>
					<select name="community" aria-label="Choose a community"><option value="">Open Crowdwide</option><% communities.forEach((community) => { %><option value="<%= community._id %>"><%= community.name %></option><% }) %></select>
					<label class="schedule-picker">Schedule<input type="datetime-local" name="scheduledAt" min="<%= new Date(Date.now() + 60000).toISOString().slice(0, 16) %>"></label>
					<label class="schedule-picker">Content warning<input name="contentWarning" maxlength="120" placeholder="Optional label"></label>
					<label class="media-picker">Add media<input type="file" name="media" accept="image/*,video/*,audio/*" multiple></label>
					<button class="button button-ghost button-small" type="button" data-composer-close>Cancel</button>
					<button class="button button-ghost button-small" type="submit" name="saveAsDraft" value="on">Save draft</button>
					<button class="button button-primary button-small" type="submit">Publish <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button>
				</div>
				<details class="composer-media-details">
					<summary>Media details · alt text, caption, transcript</summary>
					<div class="composer-media-meta">
						<label>Alt text (for screen readers)<input name="mediaAlt" maxlength="280" placeholder="Describe the media"></label>
						<label>Caption (shown under the media)<input name="mediaCaption" maxlength="280" placeholder="Optional caption"></label>
						<label>Transcript (for audio/video)<textarea name="mediaTranscript" maxlength="4000" placeholder="Optional transcript"></textarea></label>
					</div>
				</details>
				<small class="upload-help">Image &lt; 1.5MB · Video &lt; 4MB · Audio &lt; 2MB · up to 2 files · use **bold**, *italic*, "# heading", and "- list" lines for richer formatting</small>
			</div>
		</form>
		<%
	const emptyCopy = {
		'my-community': ['Your community feed is waiting.', 'Join a community to see its posts appear here.'],
		'posts-viral': ['Nothing is going viral yet.', 'Posts that pick up likes, comments and shares will rise here.'],
		'articles-viral': ['No articles are trending yet.', 'Articles readers engage with will rise here.'],
		'articles-new': ['No articles yet.', 'Be the first to publish one - articles can be up to 550 words.']
	};
	const [emptyTitle, emptyText] = emptyCopy[feed.activeTab] || ['Your feed starts with curiosity.', 'Follow someone, join a community, or share the first thought that gets the conversation moving.'];
	%>
		<% if (!feed.visiblePosts.length) { %>
		<section class="empty-feed">
			<div class="empty-orbit"><img src="/images/Crowdwide_logo_192.png" alt=""></div>
			<h2><%= emptyTitle %></h2>
			<p><%= emptyText %></p>
			<a class="button button-dark button-small" href="/explore">Explore communities <span><%- icon('arrow-up-right', { size: 14 }) %></span></a>
		</section>
		<% } %>
		<div id="feed-posts"><% feed.visiblePosts.forEach((post) => { %><%- include('../partials/post-card', { post, csrfToken }) %><% }) %></div>
		<% if (feed.visiblePosts.length && feed.hasMore) { %>
		<div id="feed-sentinel" data-feed-view="<%= feed.activeTab %>" data-page="1"></div>
		<% } %>
		<p id="feed-end-note" class="upload-help feed-end-note" style="display:<%= feed.visiblePosts.length && !feed.hasMore ? 'block' : 'none' %>;">You're all caught up.</p>
	</section>
	<aside class="discover-column" id="explore">
		<section class="discover-panel" id="communities">
			<div class="panel-heading"><h2>Explore communities</h2><a href="/explore">See all <%- icon('arrow-up-right', { size: 13, className: 'inline-arrow' }) %></a></div>
			<% if (!communities.length) { %>
			<p style="color:#777a91;font-size:12px;padding:10px 0;">No communities yet — be the first to start one below.</p>
			<% } %>
			<% communities.forEach((community) => { %>
			<div class="discover-row">
				<a href="/communities/<%= community.slug %>" class="community-glyph" style="color:inherit;"><%- icon('users', { size: 15 }) %></a>
				<div><strong><a class="name-link" href="/communities/<%= community.slug %>"><%= community.name %></a></strong><span><%= (community.membersCount || 0).toLocaleString() %> members</span></div>
				<% if (String(community.owner) === String(currentUser.id)) { %><a class="joined-mark" href="/communities/<%= community._id %>/manage">Manage</a>
				<% } else if (!joinedCommunities.includes(String(community._id))) { %><form method="post" action="/communities/<%= community._id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Join <%= community.name %>"><%- icon('plus', { size: 14 }) %></button></form>
				<% } else { %><span class="joined-mark">Joined</span><% } %>
			</div>
			<% }) %>
			<form class="create-community" method="post" action="/communities"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Create a community" required><input name="description" placeholder="What is it about?" required><input name="category" placeholder="Category e.g. design"><label class="privacy-check"><input type="checkbox" name="isPrivate"> Private community</label><button class="button button-dark button-small" type="submit">Create <span><%- icon('plus', { size: 14 }) %></span></button></form>
		</section>
		<section class="discover-panel" id="people">
			<div class="panel-heading"><h2>People to follow</h2><span>New</span></div>
			<% if (!people.length) { %>
			<p style="color:#777a91;font-size:12px;padding:10px 0;">You're following everyone who's joined so far.</p>
			<% } %>
			<% people.forEach((person) => { %>
			<div class="discover-row">
				<%- include('../partials/avatar', { person, size: 'tiny' }) %>
				<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span>New voice on Crowdwide</span></div>
				<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>"><%- icon('plus', { size: 14 }) %></button></form>
			</div>
			<% }) %>
		</section>
		<a class="settings-link" href="/settings/profile">Account settings →</a>
	</aside>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
