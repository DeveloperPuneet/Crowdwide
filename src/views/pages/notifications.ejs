<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath: '/notifications', noIndex: true }) %>
<%- include('../partials/app-nav', { active: 'notifications', currentUser }) %>
<main class="notifications-page notifications-modern" data-notifications data-unread-total="<%= unread %>" data-filter="<%= unreadOnly ? 'unread' : 'all' %>">
	<div class="notifications-heading">
		<div><p class="eyebrow">Stay in the loop</p><h1>Notifications <em class="notification-total" data-notification-total <%- unread ? '' : 'hidden' %>><%= unread %></em></h1></div>
		<form method="post" action="/notifications/read" data-mark-all-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit" data-mark-all <%- unread ? '' : 'disabled' %>>Mark all read</button></form>
	</div>
	<nav class="notification-filters" aria-label="Filter notifications">
		<a class="<%= unreadOnly ? '' : 'is-on' %>" href="/notifications" <%- unreadOnly ? '' : 'aria-current="page"' %>>All</a>
		<a class="<%= unreadOnly ? 'is-on' : '' %>" href="/notifications?filter=unread" <%- unreadOnly ? 'aria-current="page"' : '' %>>Unread</a>
	</nav>
	<p class="notification-status" role="status" aria-live="polite" data-notification-status hidden></p>
	<section class="notification-list" data-notification-list>
		<% if (!notifications.length) { %>
		<div class="empty-feed"><div class="notifications-empty-icon" aria-hidden="true"><%- icon('bell', { size: 26 }) %></div><h2><%= unreadOnly ? 'You are all caught up.' : 'All quiet for now.' %></h2><p><%= unreadOnly ? 'No unread notifications.' : 'Your interactions and community updates will appear here.' %></p></div>
		<% } %>
		<%- include('../partials/notification-items', { notifications, lastLabel: '', csrfToken }) %>
		<% if (hasMore && nextBefore) { %>
		<div class="notification-more" data-notification-more data-before="<%= nextBefore %>"><button class="button button-dark" type="button" data-notification-more-button>Show earlier</button></div>
		<% } %>
	</section>
</main>
<%- include('../partials/app-footer') %>
<script defer src="/js/notifications.js"></script>
<%- include('../partials/foot') %>
