<%- include('../partials/head', { title, bodyClass: 'auth-page', pagePath: '/settings/security/2fa', noIndex: true }) %>
<div class="auth-shell"><a class="brand auth-brand" href="/"><img src="/images/Crowdwide_logo.png" alt=""><span>Crowdwide</span></a><div class="auth-card"><%- include('../partials/flash') %><p class="eyebrow">Account security</p><h1>Two-factor<br><em>authentication.</em></h1><p class="form-note"><%= enabled ? 'Two-factor authentication is currently enabled. Keep your recovery codes safe in case you lose your authenticator.' : 'Scan this QR code with an authenticator app, then enter the six-digit code.' %></p><% if (!enabled) { %><img class="two-factor-qr" src="<%= qrCode %>" alt="Authenticator QR code"><form class="auth-form" method="post" action="/settings/security/2fa"><label>Authenticator code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><button class="button button-primary button-full" type="submit">Enable 2FA <span>↗</span></button></form><% } else { %><form class="auth-form" method="post" action="/settings/security/2fa/recovery-codes/regenerate" style="margin-bottom:14px;"><label>Password (to regenerate recovery codes)<input type="password" name="password" required></label><button class="button button-ghost button-full" type="submit">Regenerate recovery codes <span>↻</span></button></form><form class="auth-form" method="post" action="/settings/security/2fa/disable"><label>Account password<input type="password" name="password" required></label><button class="button button-danger button-full" type="submit">Disable 2FA</button></form><% } %></div><p class="auth-foot"><a href="/settings/security">← Back to security</a></p></div><%- include('../partials/foot') %>
