<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex, communityPage: true }) %>
<%- include('../partials/app-nav', { active: 'explore', currentUser }) %>
<main class="community-invite-page community-waiting-page community-invite-modern">
	<% if (locals.flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
	<section class="community-invite-card">
		<p class="eyebrow"><%= requested ? 'Request submitted' : 'Private community' %></p>
		<h1><%= requested ? 'You’re on the list.' : `Request to join ${community.name}` %></h1>
		<% if (community.description) { %><p><%= community.description %></p><% } %>
		<p class="community-waiting-copy">Posts and members are only visible after your request is approved.</p>
		<% if (requested) { %>
		<div class="community-request-status" role="status"><span aria-hidden="true">✓</span><p><strong>Your request is pending moderator approval.</strong><small>We’ll open the community to you as soon as a moderator approves it.</small></p></div>
		<form method="post" action="/communities/<%= community._id %>/join-request/cancel">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<button class="button button-ghost" type="submit">Cancel request</button>
		</form>
		<% } else { %>
		<form method="post" action="/communities/<%= community._id %>/join">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<button class="button button-primary" type="submit">Request to join</button>
		</form>
		<% } %>
		<a class="back-link" href="/explore">Back to communities</a>
	</section>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
