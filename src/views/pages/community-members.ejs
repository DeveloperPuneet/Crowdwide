<%- include('../partials/head', { title, bodyClass: 'dashboard-page community-workspace', pagePath, noIndex: true, communityPage: true }) %>
<%- include('../partials/app-nav', { active: 'communities', currentUser }) %>
<main class="explore-page people-modern community-members-page">
  <header class="community-members-hero">
    <% if (community.avatarImage) { %><img class="community-members-avatar" src="<%= community.avatarImage %>" alt=""><% } else { %><span class="community-members-avatar"><%= (community.name || '?').trim().charAt(0).toUpperCase() || '?' %></span><% } %>
    <div class="community-members-heading">
      <p class="eyebrow">Community directory</p>
      <h1><%= community.name %></h1>
      <p><%= community.description %></p>
      <a class="community-map-entry" href="/communities/<%= community.slug %>">Back to community</a>
    </div>
  </header>

  <section class="member-directory-stats" aria-label="Community activity">
    <article><strong><%= memberStats.total %></strong><span>Members</span></article>
    <article><strong><%= memberStats.moderators %></strong><span>Moderators</span></article>
    <article><strong><%= memberStats.activeThisMonth %></strong><span>Active this month</span></article>
    <article><strong><%= memberStats.contributions.toLocaleString() %></strong><span>Posts &amp; comments</span></article>
  </section>

  <section class="explore-section community-directory-section">
    <div class="member-directory-heading">
      <div><p class="eyebrow">Meet the community</p><h2>Members &amp; contributors</h2><p>Recognize the people shaping the conversation, from community leaders to active voices.</p></div>
      <span class="member-directory-count"><%= members.length %> <%= members.length === 1 ? 'person' : 'people' %></span>
    </div>
    <% if (!members.length) { %>
      <div class="empty-feed member-directory-empty"><h2>No members to show yet</h2><p>Community members will appear here as they join.</p></div>
    <% } else { %>
    <div class="community-member-grid">
      <% members.forEach((member) => {
        const roleLabel = member.communityRole === 'owner' ? 'Owner' : member.communityRole === 'moderator' ? 'Moderator' : 'Member';
        const contributionLabel = member.contributionScore >= 15 ? 'Top contributor' : member.contributionScore >= 5 ? 'Active contributor' : 'Community voice';
        const recentActivity = member.recentPosts + member.recentComments;
      %>
        <article class="community-member-card">
          <div class="community-member-identity">
            <%- include('../partials/avatar', { person: member, size: 'small' }) %>
            <div><strong><a class="name-link" href="/u/<%= member._id %>"><%= member.name %></a></strong><p><%= member.bio || 'A member of the community' %></p></div>
          </div>
          <div class="member-badges">
            <span class="member-role-badge role-<%= member.communityRole %>"><%= roleLabel %></span>
            <span class="member-contribution-badge"><%= contributionLabel %></span>
            <% if (member.isVerified) { %><span class="member-verified-badge">Verified</span><% } %>
          </div>
          <% if ((member.hashtags || []).length) { %>
          <div class="member-topic-row" aria-label="Topics"><% member.hashtags.slice(0, 4).forEach((topic) => { %><a href="/search?q=%23<%= topic %>">#<%= topic %></a><% }) %></div>
          <% } %>
          <footer class="member-contribution-stats">
            <span><strong><%= member.posts %></strong> posts</span>
            <span><strong><%= member.comments %></strong> comments</span>
            <span class="<%= recentActivity ? 'is-active' : '' %>"><strong><%= recentActivity %></strong> this month</span>
          </footer>
        </article>
      <% }) %>
    </div>
    <% } %>
  </section>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
