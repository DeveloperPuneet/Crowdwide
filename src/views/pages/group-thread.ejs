<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'groups', currentUser }) %>
<main class="community-detail">
  <a class="back-link" href="/groups">← Groups</a>
  <% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
  <section class="community-posts">
    <div class="panel-heading"><div><p class="eyebrow">Group conversation</p><h1><%= group.name %></h1></div><span><%= group.members.length %> members</span></div>
    <p class="upload-help"><%= group.members.map((member) => member.name).join(' · ') %></p>
    <div class="message-thread">
      <% if (!messages.length) { %><p class="upload-help">Start the conversation.</p><% } %>
      <% messages.forEach((message) => { %>
      <article class="activity-row <%= String(message.sender?._id) === String(currentUser.id) ? 'message-own' : '' %>"><%- include('../partials/avatar', { person: message.sender, size: 'tiny', link: false }) %><div><strong><%= message.sender?.name || 'Member' %></strong><p><%= message.body %></p><small><%= new Date(message.createdAt).toLocaleString() %></small></div></article>
      <% }) %>
    </div>
    <form class="comment-form" method="post" action="/groups/<%= group._id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="body" maxlength="2000" placeholder="Write to the group..." required>
      <button type="submit">Send</button>
    </form>
  </section>
</main>
<%- include('../partials/app-footer') %><%- include('../partials/foot') %>
