<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'explore', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="owner-layout community-owner-layout community-owner-modern">
	<% const promotionOffer = locals.communityPromotionOffer || null; %>
	<% if (community.coverImage) { %><div class="profile-banner" style="margin-bottom:26px;"><img src="<%= community.coverImage %>" alt=""></div><% } %>
	<section class="owner-hero">
		<p class="eyebrow">Community owner dashboard</p>
		<div class="community-owner-identity">
			<% if (community.avatarImage) { %><img src="<%= community.avatarImage %>" alt="" style="width:56px;height:56px;border-radius:14px;object-fit:cover;"><% } %>
			<h1 style="margin:0;"><%= community.name %></h1>
		</div>
		<p><%= community.description %></p>
		<span class="owner-stat"><strong><%= community.membersCount %></strong> members</span>
		<a href="/communities/<%= community.slug %>" class="settings-link" style="display:inline-block;margin-left:16px;">View public page →</a>
	</section>
	<section class="settings-block" id="promotion">
		<h2>Community promotion</h2>
		<% const promotionActive = community.promotionStatus === 'active' && community.promotionUntil && new Date(community.promotionUntil) > new Date(); %>
		<% if (promotionActive) { %>
		<p class="admin-badge status-good">Promoted · paid with <%= community.promotionWavesCost %> Waves</p>
		<p>Your community is eligible for labeled promoted placements in Explore and Communities until <time datetime="<%= new Date(community.promotionUntil).toISOString() %>"><%= new Date(community.promotionUntil).toLocaleString() %></time>. Placements do not guarantee views or new members.</p>
		<% } else if (community.promotionStatus === 'active') { %>
		<p>Your previous promotion has ended.</p>
		<% } %>
		<% if (community.isPrivate) { %>
		<p>Private communities cannot be promoted. Make the community public before purchasing a promotion.</p>
		<% } else if (promotionOffer && !promotionActive) { %>
		<p>Place your public community in clearly labeled discovery placements for <%= promotionOffer.durationHours %> hours. This does not guarantee views, members, or engagement. Price: <strong><%= promotionOffer.wavesCost %> Waves</strong>.</p>
		<form method="post" action="/communities/<%= community._id %>/promote" data-confirm="Spend <%= promotionOffer.wavesCost %> Waves to promote this community for <%= promotionOffer.durationHours %> hours?">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<button class="button button-primary button-small" type="submit">Promote with Waves</button>
		</form>
		<% } else if (!promotionOffer && !promotionActive) { %>
		<p>Community promotions are currently unavailable.</p>
		<% } %>
		<p><a href="/waves/terms">Waves Terms</a></p>
	</section>
	<section class="owner-grid">
		<form class="settings-block community-owner-details" method="post" action="/communities/<%= community._id %>/manage" enctype="multipart/form-data">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>">
			<h2>Community details</h2>
			<label>Community picture (pfp)<% if (community.avatarImage) { %><img src="<%= community.avatarImage %>" alt="" style="width:64px;height:64px;border-radius:14px;object-fit:cover;margin-bottom:6px;"><% } %><input type="file" name="avatarImage" accept="image/*"><small>Up to 1.5MB.</small></label>
			<label>Community banner<% if (community.coverImage) { %><img src="<%= community.coverImage %>" alt="" style="width:100%;max-width:360px;height:90px;object-fit:cover;border-radius:10px;margin-bottom:6px;"><% } %><input type="file" name="bannerImage" accept="image/*"><small>Up to 2MB.</small></label>
			<label>Name<input name="name" value="<%= community.name %>" required></label>
			<label>Description<textarea name="description" maxlength="280" required><%= community.description %></textarea></label>
			<label>Category<select name="category" required>
				<% if (!communityCategories.some((category) => category.value === (community.category || 'general'))) { %><option value="<%= community.category %>" selected><%= community.category %> (existing category)</option><% } %>
				<% communityCategories.forEach((category) => { %><option value="<%= category.value %>" <%= (community.category || 'general') === category.value ? 'selected' : '' %>><%= category.label %></option><% }) %>
			</select></label>
			<label>Hashtags<input name="hashtags" value="<%= (community.hashtags || []).join(', ') %>" placeholder="woodworking, diy, makers"><small>Comma separated - helps people find this community.</small></label>
			<fieldset class="community-location-settings">
				<legend>Community map location</legend>
				<label class="privacy-check"><input type="checkbox" name="showOnMap" data-show-on-map <%= community.showOnMap ? 'checked' : '' %>> Show this public community on the discovery map</label>
				<label>General location<input name="locationLabel" data-location-label maxlength="100" value="<%= community.locationLabel || '' %>" placeholder="City, region, country"><small>Use a broad city or region center, never a home or personal address.</small></label>
				<div class="community-location-map" data-owner-location-map data-map-api-key="<%= locals.mapApiKey || '' %>" data-lat="<%= community.locationLat ?? '' %>" data-lng="<%= community.locationLng ?? '' %>" aria-label="Choose a general community location by clicking the map"></div>
				<p class="community-map-tile-error" data-map-tile-error role="status" hidden>Map tiles are blocked on this connection. Try again on another network to place the location pin.</p>
				<input type="hidden" name="locationLat" data-location-lat value="<%= community.locationLat ?? '' %>">
				<input type="hidden" name="locationLng" data-location-lng value="<%= community.locationLng ?? '' %>">
				<div class="community-location-actions"><button type="button" class="button button-small button-ghost" data-use-current-location><%- icon('map-pin', { size: 14 }) %> Use current location</button><button type="button" class="button button-small button-ghost" data-clear-community-location>Clear location</button></div>
				<p class="community-location-status" data-location-status role="status" aria-live="polite"></p>
			</fieldset>
			<label class="community-guidelines-field">Community guidelines<textarea name="guidelines" maxlength="4000" placeholder="What's expected from members here?"><%= community.guidelines || '' %></textarea></label>
			<label class="privacy-check"><input type="checkbox" name="isPrivate" <%= community.isPrivate ? 'checked' : '' %>> Private community <small>(new members must be approved to join)</small></label>
			<label class="privacy-check"><input type="checkbox" name="requireApproval" <%= community.requireApproval ? 'checked' : '' %>> Review posts before they appear <small>(moderation queue below)</small></label>
			<label>Banned words<input name="bannedWords" value="<%= (community.bannedWords || []).join(', ') %>" placeholder="word, phrase"></label>
			<button class="button button-primary button-small upper-margin-15" type="submit">Save controls <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button>
		</form>

		<% if (community.isPrivate) { %>
		<section class="settings-block community-invite-settings">
			<h2>Private community invite</h2>
			<p>Anyone signed in to Crowdwide who opens this invite can join immediately, without a join request.</p>
			<% if (inviteUrl) { %>
			<%- include('../partials/invite-share', { inviteUrl, shareId: `community-${community._id}`, shareText: `Join ${community.name} on Crowdwide` }) %>
			<div class="invite-share-actions">
				<form method="post" action="/communities/<%= community._id %>/invite" data-confirm="Create a new link? The current invite will stop working."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small" type="submit">Reset link</button></form>
				<form method="post" action="/communities/<%= community._id %>/invite/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small" type="submit">Turn off link</button></form>
			</div>
			<% } else { %>
			<p class="upload-help">Create an invite link to let people join without approval.</p>
			<form method="post" action="/communities/<%= community._id %>/invite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-small" type="submit"><%- icon('link', { size: 15 }) %> Create invite link</button></form>
			<% } %>
		</section>
		<% } %>

		<section class="settings-block" id="monetization">
			<h2>Community monetization</h2>
			<p><a href="/community-monetization/terms">Community Monetization Terms</a> · <a href="/advertising/terms">Advertising Terms</a></p>
			<% const monetizationStatus = community.monetizationStatus || 'none'; %>
			<% const monetizationChecklist = locals.monetizationEligibility || { eligible: false, requirements: {
				posts: { label: 'Published posts', actual: 0, minimum: 20, met: false },
				likes: { label: 'Total post likes', actual: 0, minimum: 30, met: false },
				comments: { label: 'Total comments', actual: 0, minimum: 10, met: false }
			} }; %>
			<% const adStats = locals.monetizationStats || { impressions: 0, clicks: 0 }; %>
			<% if (monetizationStatus === 'approved') { %>
			<p class="admin-badge status-good">Application approved.</p>
			<div class="admin-stats" aria-label="Community advertising totals">
				<article class="admin-stat"><span>Delivery</span><strong><%= adStats.impressions.toLocaleString() %></strong><small>impressions</small></article>
				<article class="admin-stat"><span>Engagement</span><strong><%= adStats.clicks.toLocaleString() %></strong><small>clicks</small></article>
				<article class="admin-stat"><span>Campaign spend</span><strong><%= Number(adStats.campaignSpendWaves || 0).toLocaleString() %></strong><small>Waves charged to campaigns</small></article>
				<article class="admin-stat"><span>Owner share</span><strong><%= Number(adStats.ownerShareWaves || 0).toLocaleString() %></strong><small><%= Number(community.monetizationSettings?.revenueSharePercent || 0) %>% · credited Waves</small></article>
			</div>
			<p>Your share is <%= Number(community.monetizationSettings?.revenueSharePercent || 0) %>% of eligible, deduplicated campaign spend in this public community, credited directly to your Waves wallet. This is an internal Waves ledger credit only; Crowdwide does not process real-money ad payments or payouts, and Waves cannot be withdrawn.</p>
			<section class="community-ad-earnings-history" aria-labelledby="community-ad-earnings-heading">
				<h3 id="community-ad-earnings-heading">Recent Waves earnings</h3>
				<% const earningsHistory = Array.isArray(locals.ownerEarningsHistory) ? locals.ownerEarningsHistory : []; %>
				<% if (earningsHistory.length) { %>
				<div class="community-ad-earnings-list">
					<% earningsHistory.forEach((entry) => { %>
					<div class="community-ad-earnings-row">
						<span><%= entry.status === 'posted' ? 'Credited' : 'Pending' %><small><%= new Date(entry.createdAt).toLocaleString() %></small></span>
						<strong>+<%= Number(entry.amount || 0).toLocaleString() %> Waves</strong>
					</div>
					<% }) %>
				</div>
				<% } else { %><p>No campaign-funded Waves shares have been credited yet.</p><% } %>
				<p><a href="/wallet">View your full Waves wallet history</a></p>
			</section>
			<% } else if (monetizationStatus === 'pending') { %>
			<p class="admin-badge status-reviewing">Application is pending staged review. Moderator screening: <strong><%= community.monetizationModeratorReview?.status || 'pending' %></strong><% if (community.monetizationModeratorReview?.reason) { %> — <%= community.monetizationModeratorReview.reason %><% } %></p>
			<% } else if (monetizationStatus === 'rejected') { %>
			<p class="admin-badge status-suspended">Application was rejected.</p>
			<% if (community.monetizationApplication?.rejectionReason) { %><p><%= community.monetizationApplication.rejectionReason %></p><% } %>
			<% if (community.monetizationApplication?.appealStatus === 'pending') { %><p>Your appeal is awaiting admin review.</p><% } else { %>
			<form method="post" action="/communities/<%= community._id %>/monetization/appeal">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<label>Appeal this decision<textarea name="message" minlength="20" maxlength="1000" required placeholder="Explain why the decision should be reconsidered."></textarea></label>
				<button class="button button-ghost button-small" type="submit">Submit appeal</button>
			</form>
			<% } %>
			<% } else if (monetizationStatus === 'paused') { %>
			<p class="admin-badge status-suspended">Monetization has been paused.</p>
			<% if (community.monetizationApplication?.appealStatus === 'pending') { %><p>Your appeal is awaiting admin review.</p><% } else { %>
			<form method="post" action="/communities/<%= community._id %>/monetization/appeal">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<label>Appeal this suspension<textarea name="message" minlength="20" maxlength="1000" required placeholder="Explain why the suspension should be reconsidered."></textarea></label>
				<button class="button button-ghost button-small" type="submit">Submit appeal</button>
			</form>
			<% } %>
			<% } %>
			<% if ((community.monetizationHistory || []).length) { %>
			<details><summary>Monetization review history (<%= community.monetizationHistory.length %>)</summary>
				<% community.monetizationHistory.slice().reverse().forEach((entry) => { %><p><strong><%= entry.action.replace(/-/g, ' ') %></strong> · <%= new Date(entry.createdAt).toLocaleString() %><% if (entry.note) { %><br><%= entry.note %><% } %></p><% }) %>
			</details>
			<% } %>
			<% if (monetizationStatus !== 'pending' && monetizationStatus !== 'approved') { %>
			<p>Meet each requirement to apply:</p>
			<form method="post" action="/communities/<%= community._id %>/monetization" style="margin-top:16px;">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<div class="settings-form compact">
					<% Object.values(monetizationChecklist.requirements).forEach((requirement) => { %>
					<label class="checkbox-field" style="display:flex;align-items: center;"><input type="checkbox" aria-label="<%= requirement.label %> requirement met" <%= requirement.met ? 'checked' : '' %> disabled> <%= requirement.label %>: <%= typeof requirement.actual === 'boolean' ? (requirement.actual ? 'Yes' : 'No') : `${requirement.actual} / ${requirement.minimum}` %></label>
					<% }) %>
				</div>
				<button class="button button-primary button-small" style="margin-top:25px;" type="submit" <%= monetizationChecklist.eligible ? '' : 'disabled' %>>Apply for monetization</button>
			</form>
			<% } %>
		</section>

		<% if (community.requireApproval) { %>
		<section class="settings-block">
			<h2>Posts awaiting review</h2>
			<% if (!pendingPosts.length) { %><p>Nothing waiting for review.</p><% } %>
			<% pendingPosts.forEach((post) => { %>
			<div style="border-top:1px solid var(--line);padding:14px 0;">
				<strong style="font-size:12px;"><a class="name-link" href="/u/<%= post.author?._id %>"><%= post.author?.name || 'Member' %></a></strong>
				<p style="color:var(--tx-mid);font-size:13px;margin:8px 0;"><%= post.body %></p>
				<form method="post" action="/communities/<%= community._id %>/posts/<%= post._id %>/review" style="display:flex;gap:8px;">
					<input type="hidden" name="_csrf" value="<%= csrfToken %>">
					<button class="button button-small button-primary" name="decision" value="approve" type="submit">Approve</button>
					<button class="button button-small button-danger" name="decision" value="reject" type="submit">Reject</button>
				</form>
			</div>
			<% }) %>
		</section>
		<% } %>

		<section class="settings-block">
			<h2>Join requests</h2>
			<% if (!requests.length) { %><p>No pending requests.</p><% } %>
			<% requests.forEach((requestUser) => { %>
			<div class="device-row">
				<%- include('../partials/avatar', { person: requestUser, size: 'tiny', link: false }) %>
				<div><strong><%= requestUser.name %></strong><span><%= requestUser.email %></span></div>
				<form method="post" action="/communities/<%= community._id %>/requests/<%= requestUser._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-primary" name="decision" value="approve" type="submit">Approve</button><button class="round-action" name="decision" value="reject" type="submit">×</button></form>
			</div>
			<% }) %>
		</section>

		<section class="settings-block">
			<div class="settings-block-heading"><h2>Moderators</h2></div>
			<p>Add a trusted member as a moderator by their username or email. If they are not a member yet, they'll be added to the community.</p>
			<form method="post" action="/communities/<%= community._id %>/moderators" style="display:flex;gap:8px;margin:10px 0 16px;">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<input name="identifier" placeholder="Username or email" required>
				<button class="button button-small button-dark" type="submit">Add moderator</button>
			</form>
			<% moderators.forEach((mod) => { %><div class="device-row"><span class="device-icon"><%- icon('user', { size: 16 }) %></span><div><strong><%= mod.name %></strong><span><%= mod.email %></span></div></div><% }) %>
		</section>

		<section class="settings-block">
			<h2>Members & roles</h2>
			<% members.forEach((member) => { %>
			<div class="device-row">
				<%- include('../partials/avatar', { person: member, size: 'tiny' }) %>
				<div><strong><a class="name-link" href="/u/<%= member._id %>"><%= member.name %></a></strong><span><%= member.email %></span></div>
				<% if (String(member._id) !== String(community.owner)) { %>
				<form method="post" action="/communities/<%= community._id %>/members/<%= member._id %>/role"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="role-button" name="role" value="<%= community.moderators.some((id) => String(id) === String(member._id)) ? 'member' : 'moderator' %>" type="submit"><%= community.moderators.some((id) => String(id) === String(member._id)) ? 'Remove mod' : 'Make mod' %></button></form>
				<form method="post" action="/communities/<%= community._id %>/members/<%= member._id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Remove member">×</button></form>
				<% } else { %><em>Owner</em><% } %>
			</div>
			<% }) %>
		</section>
		<section class="settings-block">
			<h2>Quest board</h2>
			<form method="post" action="/communities/<%= community._id %>/quests" style="display:grid;gap:10px;">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<label>Title<input name="title" maxlength="80" placeholder="Community challenge" required></label>
				<label>Goal<input name="goal" maxlength="150" placeholder="What should members do?"></label>
				<label>Description<textarea name="description" maxlength="260" placeholder="Give the community some context and a clear target."></textarea></label>
				<label>Reward<input name="reward" maxlength="120" placeholder="Example: Featured post or badge"></label>
				<label>Winner achievement tag<input name="achievementTag" maxlength="60" placeholder="Example: Community Artist"><small>Shown on the winner's profile after the quest ends.</small></label>
				<button class="button button-primary button-small" type="submit">Launch quest</button>
			</form>
			<% if (!quests.length) { %><p>No quests yet.</p><% } %>
			<% quests.forEach((quest) => { %>
			<div class="quest-manage-card">
				<div class="quest-header">
					<span class="quest-badge <%= quest.status === 'ended' ? 'quest-badge-complete' : (quest.status === 'completed' ? 'quest-badge-complete' : 'quest-badge-open') %>"><%= quest.status === 'ended' ? 'Ended' : quest.status === 'completed' ? 'Completed' : quest.status === 'active' ? 'Active' : 'Open' %></span>
					<span class="quest-progress"><%= (quest.completedBy || []).length %> complete</span>
				</div>
				<strong><%= quest.title %></strong>
				<p><%= quest.description || quest.goal || 'Community challenge' %></p>
				<small>Reward: <%= quest.reward || 'Community recognition' %></small>
				<% if (quest.status === 'ended' && quest.winner) { %><small>Winner: <%= quest.winner?.name || 'Community member' %></small><% } %>
				<% if (quest.status === 'ended' && quest.rewarded) { %><small>Reward sent</small><% } %>
				<div class="quest-actions">
					<span><%= (quest.participants || []).length %> joined</span>
				</div>
				<% if (quest.status !== 'ended') { %>
				<form method="post" action="/communities/<%= community._id %>/quests/<%= quest._id %>/end" style="display:grid;gap:8px;">
					<input type="hidden" name="_csrf" value="<%= csrfToken %>">
					<label>Declare winner<select name="winnerId" required>
						<option value="">Choose the winner</option>
						<% (quest.participants || []).forEach((person) => { %><option value="<%= person._id %>"><%= person.name %></option><% }) %>
					</select></label>
					<button class="button button-small button-primary" type="submit">End quest</button>
				</form>
				<% } else if (quest.winner && !quest.rewarded) { %>
				<form method="post" action="/communities/<%= community._id %>/quests/<%= quest._id %>/reward"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit">Mark reward sent</button></form>
				<% } %>
			</div>
			<% }) %>
		</section>
		<section class="settings-block owner-posts">
			<h2>Recent posts</h2>
			<% if (!posts.length) { %><p>No posts in this community yet.</p><% } %>
			<% posts.forEach((post) => { %><article><strong><a class="name-link" href="/u/<%= post.author?._id %>"><%= post.author?.name || 'Member' %></a></strong><% if (community.pinnedPosts?.some((id) => String(id) === String(post._id))) { %> <b style="color:var(--ac-orange);font-size:11px;">Pinned</b><% } %><p><%= post.body %></p><form method="post" action="/communities/<%= community._id %>/posts/<%= post._id %>/pin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-ghost" type="submit"><%= community.pinnedPosts?.some((id) => String(id) === String(post._id)) ? 'Unpin post' : 'Pin post' %></button></form></article><% }) %>
		</section>
	</section>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
