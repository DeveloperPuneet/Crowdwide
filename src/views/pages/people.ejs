<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'explore', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="explore-page people-modern">
	<section class="explore-hero">
		<p class="eyebrow">Grow your circle</p>
		<h1>People worth<br><em>following.</em></h1>
		<p style="color:var(--tx-lo);max-width:520px;margin-top:14px;">Picked from what you're into, who your network follows, and who's active right now — not just the same big accounts every time.</p>
	</section>

	<section class="explore-section">
		<div class="explore-people-cols">
			<div class="discover-panel">
				<div class="panel-heading"><h2>Because you're into...</h2><span>Common interests</span></div>
				<% if (!hasInterests) { %>
				<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">Add a few hashtags to your profile and we'll match you with people who share them.</p>
				<% } else if (!commonInterests.length) { %>
				<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">No matches yet — follow a few more people or post with hashtags to sharpen this.</p>
				<% } %>
				<% commonInterests.forEach((person) => { %>
				<div class="discover-row">
					<%- include('../partials/avatar', { person, size: 'tiny' }) %>
					<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span><% if ((person.sharedTags || []).length) { %>Also into <%= person.sharedTags.map((tag) => '#' + tag).join(', ') %><% } else { %><span class="person-bio" data-bio-limit><%= person.bio || 'Shares your interests' %></span><% } %></span></div>
					<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>"><%- icon('plus', { size: 14 }) %></button></form>
				</div>
				<% }) %>
			</div>

			<div class="discover-panel">
				<div class="panel-heading"><h2>People you may know</h2><span>Common creators</span></div>
				<% if (!mutualNetwork.length) { %>
				<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">Follow a few people and we'll surface who they follow too.</p>
				<% } %>
				<% mutualNetwork.forEach((person) => { %>
				<div class="discover-row">
					<%- include('../partials/avatar', { person, size: 'tiny' }) %>
					<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span>Followed by <%= person.mutualCount %> <%= person.mutualCount === 1 ? 'person' : 'people' %> you follow</span></div>
					<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>"><%- icon('plus', { size: 14 }) %></button></form>
				</div>
				<% }) %>
			</div>

			<div class="discover-panel">
				<div class="panel-heading"><h2>Trending creators</h2><span>Last 7 days</span></div>
				<% if (!trending.length) { %>
				<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">Nothing trending yet — check back soon.</p>
				<% } %>
				<% trending.forEach((person) => { %>
				<div class="discover-row">
					<%- include('../partials/avatar', { person, size: 'tiny' }) %>
					<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span class="person-bio" data-bio-limit><%= person.bio || 'Gaining traction this week' %></span></div>
					<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>"><%- icon('plus', { size: 14 }) %></button></form>
				</div>
				<% }) %>
			</div>

			<div class="discover-panel">
				<div class="panel-heading"><h2>New on Crowdwide</h2><span>Just joined</span></div>
				<% if (!newJoiners.length) { %>
				<p style="color:var(--tx-faint);font-size:12px;padding:10px 0;">No new members right now.</p>
				<% } %>
				<% newJoiners.forEach((person) => { %>
				<div class="discover-row">
					<%- include('../partials/avatar', { person, size: 'tiny' }) %>
					<div><strong><a class="name-link" href="/u/<%= person._id %>"><%= person.name %></a></strong><span class="person-bio" data-bio-limit><%= person.bio || 'New voice on Crowdwide' %></span></div>
					<form class="follow-form" data-user="<%= person._id %>" method="post" action="/users/<%= person._id %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="round-action" aria-label="Follow <%= person.name %>"><%- icon('plus', { size: 14 }) %></button></form>
				</div>
				<% }) %>
			</div>
		</div>
	</section>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
