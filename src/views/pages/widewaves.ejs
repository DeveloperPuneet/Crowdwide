<%- include('../partials/head', { title, description, pagePath, bodyClass: 'ww-body' }) %>
<% if (locals.currentUser) { %>
<%- include('../partials/app-nav', { active: 'widewaves', currentUser }) %>
<% } else { %>
<header class="site-nav container public-posts-nav">
	<a class="brand" href="/"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
	<div><a class="button button-small button-ghost" href="/auth/login">Sign in</a><a class="button button-small button-primary" href="/auth/register">Join Crowdwide</a></div>
</header>
<% } %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="ww-page">
	<header class="ww-hero">
		<div>
			<p class="eyebrow">Open to everyone</p>
			<h1>WideWaves</h1>
			<p>Topic spaces anyone can read, post in and join the conversation. No joining, no following. Pick a topic like <strong>ww/poetry</strong> or <strong>ww/gaming</strong> and dive in.</p>
		</div>
		<div class="ww-hero-actions">
			<% if (locals.currentUser) { %><a class="button button-primary" href="/widewaves/new"><%- icon('plus', { size: 15 }) %> Create a WideWave</a><% } else { %><a class="button button-primary" href="/auth/register">Join to post</a><% } %>
			<a class="button button-ghost" href="/widewaves/leaderboard"><%- icon('trending-up', { size: 15 }) %> Leaderboard</a>
		</div>
	</header>
	<form class="ww-search" method="get" action="/widewaves" role="search">
		<%- icon('search', { size: 16 }) %>
		<input type="search" name="q" value="<%= query %>" maxlength="60" placeholder="Find a WideWave, e.g. art, poetry, gaming" aria-label="Find a WideWave">
		<button class="button button-small button-primary" type="submit">Search</button>
	</form>
	<% if (query) { %>
	<section class="ww-results" aria-label="Search results">
		<div class="panel-heading"><h2>Results for “<%= query %>”</h2><span><%= results.length %></span></div>
		<% if (!results.length) { %><p class="ww-empty">No WideWave matches that yet.<% if (locals.currentUser) { %> <a href="/widewaves/new?name=<%= encodeURIComponent(query.replace(/^ww\//i, '')) %>">Create ww/<%= query.replace(/^ww\//i, '').toLowerCase().replace(/[^a-z0-9_]/g, '') %></a><% } %></p><% } %>
		<% results.forEach((wave) => { %><%- include('../partials/widewave-card', { wave }) %><% }) %>
	</section>
	<% } %>

	<div class="ww-layout">
		<section class="ww-main">
			<nav class="feed-tabs" aria-label="WideWave feed">
				<% if (locals.currentUser) { %><a class="<%= tab === 'for-you' ? 'feed-tab-active' : '' %>" href="/widewaves?tab=for-you">For you</a><% } %>
				<a class="<%= tab === 'trending' ? 'feed-tab-active' : '' %>" href="/widewaves?tab=trending">Top posts</a>
				<a class="<%= tab === 'new' ? 'feed-tab-active' : '' %>" href="/widewaves?tab=new">Newest</a>
			</nav>
			<% if (tab === 'for-you') { %><p class="ww-note">Picked from every WideWave using what you read, like and post.</p><% } %>
			<% if (!feed.posts.length) { %>
			<div class="empty-feed"><h2>Nothing here yet.</h2><p>Be the first to start a WideWave and post in it.</p><% if (locals.currentUser) { %><a class="button button-primary button-small" href="/widewaves/new">Create a WideWave</a><% } %></div>
			<% } %>
			<div class="ww-posts"><% feed.posts.forEach((post) => { %><%- include('../partials/post-card', { post, csrfToken: locals.csrfToken, hideSource: false }) %><% }) %></div>
			<% if (feed.hasMore || page > 1) { %>
			<nav class="ww-pager" aria-label="Pages">
				<% if (page > 1) { %><a class="button button-ghost button-small" href="/widewaves?tab=<%= tab %>&page=<%= page - 1 %>">← Newer</a><% } %>
				<% if (feed.hasMore) { %><a class="button button-ghost button-small" href="/widewaves?tab=<%= tab %>&page=<%= page + 1 %>">More posts →</a><% } %>
			</nav>
			<% } %>
		</section>
		<aside class="ww-side">
			<% if (recommended.length) { %>
			<section class="discover-panel">
				<div class="panel-heading"><h2>Picked for you</h2><span>Interests</span></div>
				<% recommended.forEach((wave) => { %><%- include('../partials/widewave-card', { wave }) %><% }) %>
			</section>
			<% } %>
			<section class="discover-panel">
				<div class="panel-heading"><h2>Trending now</h2><span>7 days</span></div>
				<% if (!trending.length) { %><p class="ww-empty">No WideWaves yet. Start the first one.</p><% } %>
				<% trending.forEach((wave, index) => { %><%- include('../partials/widewave-card', { wave, rank: index + 1, stat: wave.weekPosts ? `${wave.weekPosts} this week` : '' }) %><% }) %>
			</section>
			<section class="discover-panel">
				<div class="panel-heading"><h2>Most posts this week</h2><a href="/widewaves/leaderboard">All boards →</a></div>
				<% if (!board.length) { %><p class="ww-empty">Post in a WideWave to get on the board.</p><% } %>
				<% board.forEach((wave) => { %><%- include('../partials/widewave-card', { wave, rank: wave.rank, stat: `${wave.periodPosts} posts` }) %><% }) %>
			</section>
		</aside>
	</div>
	<% if (!locals.currentUser) { %>
	<aside class="public-posts-join"><div><strong>Join the conversation.</strong><span>Create a free account to post in WideWaves, like and comment.</span></div><a class="button button-primary button-small" href="/auth/register">Create your account</a></aside>
	<% } %>
</main>
<% if (locals.currentUser) { %><%- include('../partials/app-footer') %><% } else { %><%- include('../partials/site-footer') %><% } %>
<%- include('../partials/foot') %>
