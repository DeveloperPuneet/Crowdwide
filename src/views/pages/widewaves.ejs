<%- include('../partials/head', { title, description, pagePath, bodyClass: 'ww-body' }) %>
<% if (locals.currentUser) { %>
<%- include('../partials/app-nav', { active: 'widewaves', currentUser }) %>
<% } else { %>
<header class="site-nav container public-posts-nav">
	<a class="brand" href="/"><img src="/images/Crowdwide_logo_192.png" alt=""><span>Crowdwide</span></a>
	<div><a class="button button-small button-ghost" href="/auth/login">Sign in</a><a class="button button-small button-primary" href="/auth/register">Join Crowdwide</a></div>
</header>
<% } %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="ww-page ww-threads">
	<div class="ww-shell">
		<section class="ww-column">
			<header class="ww-top">
				<div>
					<h1><%- icon('widewave', { size: 30 }) %> WideWave</h1>
					<p>Open conversations. Read, reply and start a thread. No joining, no following.</p>
				</div>
				<div class="ww-top-actions">
					<a class="icon-button" href="/widewaves/leaderboard" aria-label="Leaderboard" title="Leaderboard"><%- icon('trending-up', { size: 19 }) %></a>
					<% if (locals.currentUser) { %><a class="button button-small button-primary" href="/widewaves/new"><%- icon('plus', { size: 14 }) %> New WideWave</a><% } %>
				</div>
			</header>
			<div class="ww-stories" aria-label="Topics">
				<% if (locals.currentUser) { %><a class="ww-story ww-story-new" href="/widewaves/new"><span class="ww-ring"><span class="ww-badge"><%- icon('plus', { size: 22 }) %></span></span><small>Create</small></a><% } %>
				<% trending.forEach((wave, index) => { %><%- include('../partials/widewave-story', { wave, hot: index < 3 }) %><% }) %>
				<% recommended.filter((wave) => !trending.some((t) => t.name === wave.name)).forEach((wave) => { %><%- include('../partials/widewave-story', { wave }) %><% }) %>
			</div>
			<form class="ww-search" method="get" action="/widewaves" role="search">
				<%- icon('search', { size: 16 }) %>
				<input type="search" name="q" value="<%= query %>" maxlength="60" placeholder="Search WideWaves: art, poetry, gaming" aria-label="Find a WideWave">
			</form>
			<% if (query) { %>
			<section class="ww-results" aria-label="Search results">
				<div class="panel-heading"><h2>Results for “<%= query %>”</h2><span><%= results.length %></span></div>
				<% if (!results.length) { %><p class="ww-empty">No WideWave matches that yet.<% if (locals.currentUser) { %> <a href="/widewaves/new?name=<%= encodeURIComponent(query.replace(/^ww\//i, '')) %>">Create ww/<%= query.replace(/^ww\//i, '').toLowerCase().replace(/[^a-z0-9_]/g, '') %></a><% } %></p><% } %>
				<% results.forEach((wave) => { %><%- include('../partials/widewave-card', { wave }) %><% }) %>
			</section>
			<% } %>
			<nav class="ww-tabs" aria-label="WideWave feed">
				<% if (locals.currentUser) { %><a class="<%= tab === 'for-you' ? 'is-on' : '' %>" href="/widewaves?tab=for-you">For you</a><% } %>
				<a class="<%= tab === 'trending' ? 'is-on' : '' %>" href="/widewaves?tab=trending">Top</a>
				<a class="<%= tab === 'new' ? 'is-on' : '' %>" href="/widewaves?tab=new">Newest</a>
			</nav>
			<%- include('../partials/ww-composer', { preset: '', returnTo: '/widewaves' }) %>
			<% if (!feed.posts.length) { %>
			<div class="empty-feed ww-empty-feed"><h2>Nothing here yet.</h2><p>Start the first thread, or create a WideWave for your topic.</p></div>
			<% } %>
			<div class="ww-posts ww-thread-list"><% feed.posts.forEach((post) => { %><%- include('../partials/thread-card', { post, csrfToken: locals.csrfToken }) %><% }) %></div>
			<% if (feed.hasMore || page > 1) { %>
			<nav class="ww-pager" aria-label="Pages">
				<% if (page > 1) { %><a class="button button-ghost button-small" href="/widewaves?tab=<%= tab %>&page=<%= page - 1 %>">← Newer</a><% } %>
				<% if (feed.hasMore) { %><a class="button button-ghost button-small" href="/widewaves?tab=<%= tab %>&page=<%= page + 1 %>">More threads →</a><% } %>
			</nav>
			<% } %>
		</section>
		<aside class="ww-side">
			<section class="discover-panel">
				<div class="panel-heading"><h2>Trending now</h2><span>7 days</span></div>
				<% if (!trending.length) { %><p class="ww-empty">No WideWaves yet. Start the first one.</p><% } %>
				<% trending.slice(0, 6).forEach((wave, index) => { %><%- include('../partials/widewave-card', { wave, rank: index + 1, stat: wave.weekPosts ? `${wave.weekPosts} this week` : '' }) %><% }) %>
			</section>
			<section class="discover-panel">
				<div class="panel-heading"><h2>Most active</h2><a href="/widewaves/leaderboard">All boards →</a></div>
				<% if (!board.length) { %><p class="ww-empty">Post in a WideWave to get on the board.</p><% } %>
				<% board.forEach((wave) => { %><%- include('../partials/widewave-card', { wave, rank: wave.rank, stat: `${wave.periodPosts} posts` }) %><% }) %>
			</section>
			<p class="ww-note"><a href="/dashboard">← Back to Crowdwide</a></p>
		</aside>
	</div>
	<% if (!locals.currentUser) { %>
	<aside class="public-posts-join"><div><strong>Join the conversation.</strong><span>Create a free account to post in WideWaves, like and reply.</span></div><a class="button button-primary button-small" href="/auth/register">Create your account</a></aside>
	<% } %>
</main>
<% if (locals.currentUser) { %><%- include('../partials/app-footer') %><% } else { %><%- include('../partials/site-footer') %><% } %>
<%- include('../partials/foot') %>
