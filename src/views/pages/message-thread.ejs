<%- include('../partials/head', { title, bodyClass: 'dashboard-page chat-page', pagePath, noIndex }) %>
<%- include('../partials/app-nav', { active: 'messages', currentUser }) %>
<main class="chat-main">
	<% if (locals.flash) { %><%- include('../partials/flash') %><% } %>
	<section class="chat-shell" data-chat data-kind="dm" data-poll-url="/messages/<%= person._id %>/poll" data-history-url="/messages/<%= person._id %>/history" data-last-id="<%= lastId || '' %>" data-viewer-id="<%= currentUser.id %>">
		<header class="chat-header">
			<a class="chat-back" href="/messages" aria-label="Back to inbox"><%- icon('arrow-left', { size: 20 }) %></a>
			<%- include('../partials/avatar', { person, size: 'small', link: false }) %>
			<div class="chat-title"><strong><%= person.name %></strong><a class="name-link" href="/u/<%= person._id %>">View profile</a></div>
		</header>
		<%- include('../partials/chat-body', { sendUrl: '/messages/' + person._id, messagesHtml, hasMore, placeholder: 'Message ' + person.name, emptyText: 'Start the conversation with ' + person.name + '.', csrfToken, gifsEnabled: locals.gifsEnabled }) %>
	</section>
</main>
<%- include('../partials/foot') %>
