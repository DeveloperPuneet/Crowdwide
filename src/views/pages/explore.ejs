<%- include('../partials/head', { title, bodyClass: 'dashboard-page' }) %>
<header class="app-nav"><a class="brand" href="/"><img src="/images/Crowdwide_logo.png" alt=""><span>Crowdwide</span></a><nav><a href="/dashboard">Home</a><a class="app-nav-active" href="/explore">Explore</a></nav><div class="app-nav-actions"><a class="button button-small button-ghost" href="/settings/profile">Settings</a></div></header>
<main class="explore-page"><section class="explore-hero"><p class="eyebrow">Find your people</p><h1>There is a community<br><em>for your kind of curious.</em></h1><form class="explore-search" method="get" action="/explore"><input name="q" value="<%= query %>" placeholder="Search communities"><select name="category"><option value="">All categories</option><% categories.forEach((item) => { %><option value="<%= item %>" <%= category === item ? 'selected' : '' %>><%= item %></option><% }) %></select><button class="button button-primary" type="submit">Search <span>⌕</span></button></form></section><section class="explore-grid"><% if (!communities.length) { %><div class="empty-feed"><h2>No communities found yet.</h2><p>Try a different search or create the first space around your interest.</p><a class="button button-primary button-small" href="/dashboard#communities">Create a community <span>+</span></a></div><% } %><% communities.forEach((community) => { %><a class="community-card" href="/communities/<%= community.slug %>"><div class="community-card-top"><span class="community-glyph">✦</span><span class="community-category"><%= community.category || 'general' %></span></div><h2><%= community.name %></h2><p><%= community.description %></p><footer><span><%= community.membersCount.toLocaleString() %> members</span><span><%= community.isPrivate ? 'Request to join' : 'Open to join' %> ↗</span></footer></a><% }) %></section></main><%- include('../partials/foot') %>
