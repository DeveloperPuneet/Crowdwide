<%- include('../partials/auth-shell-start', { title }) %>
<div class="auth-badge" aria-hidden="true"><%- icon('user-plus', { size: 26 }) %></div><p class="eyebrow">Almost there</p><h1>Finish signing up<br><em>with <%= providerLabel %>.</em></h1><p class="form-note">We'll create your Crowdwide account for <strong><%= profile.email %></strong>. Your <%= providerLabel %> password is never shared with us.</p>
<form class="auth-form" method="post" action="/auth/social/confirm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Your name<input type="text" name="name" value="<%= profile.name %>" maxlength="60" placeholder="How should we call you?" required></label><label class="consent-check"><input type="checkbox" name="acceptTerms" value="on" required><span>I agree to Crowdwide's <a href="/terms" target="_blank" rel="noopener">Terms of use</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy policy</a>.</span></label><button class="button button-primary button-full" type="submit">Create account <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button></form>
<p class="switch-auth">Not you? <a href="/auth/register">Start over</a></p>
<%- include('../partials/auth-shell-end') %>
