<%- include('../partials/head', { title, bodyClass: 'home-page' }) %>
<div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
<%- include('../partials/nav') %>
<main>
  <section class="hero container">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span class="eyebrow-dot"></span> A social network for real discovery</p>
      <h1>Find your people.<br><em>Not just your audience.</em></h1>
      <p class="hero-lede">Crowdwide gives every voice a fair chance at discovery. Follow your curiosity, meet the people who get it, and make space for something new.</p>
      <div class="hero-actions"><a class="button button-primary" href="/auth/register">Create your account <span>↗</span></a><a class="text-link" href="#why">See how it works <span>↓</span></a></div>
      <div class="hero-proof"><div class="avatar-stack"><span>J</span><span>M</span><span>R</span><span>+</span></div><p><strong>Built for curious people</strong><br><span>and the communities they create</span></p></div>
    </div>
    <div class="hero-visual reveal reveal-delay"><div class="orbit-card"><img src="/images/Crowdwide_cover.png" alt="Crowdwide network illustration"></div><div class="visual-note note-top"><span class="note-icon">✦</span><strong>New voices</strong><small>are worth finding</small></div><div class="visual-note note-bottom"><span class="note-icon blue">◎</span><strong>Discovery</strong><small>without the noise</small></div></div>
  </section>
  <section class="trust-strip container"><span>Made for the in-between moments</span><i></i><span>People over popularity</span><i></i><span>Curiosity is the algorithm</span></section>
  <section class="principles container" id="why">
    <div class="section-intro"><p class="eyebrow">A different kind of social</p><h2>More signal.<br><em>More serendipity.</em></h2></div>
    <div class="principle-grid" id="principles"><article><span class="principle-number">01</span><h3>Find your people</h3><p>Meet communities around the ideas, crafts, and small obsessions that make you feel most like yourself.</p></article><article><span class="principle-number">02</span><h3>See what matters</h3><p>A calmer feed that puts thoughtful posts and fresh perspectives ahead of empty volume.</p></article><article><span class="principle-number">03</span><h3>Make an impact</h3><p>Share work that matters to you and let the right people find it, no popularity contest required.</p></article></div>
  </section>
  <section class="stats-section container" id="communities"><div class="section-intro"><p class="eyebrow">Crowdwide, live</p><h2>Real people.<br><em>Real momentum.</em></h2><p class="section-copy">These numbers update from the Crowdwide community as it grows. When a space is just beginning, we leave it open for the first people to shape.</p></div><div class="stats-content"><div class="stats-grid"><div><strong><%= stats.members.toLocaleString() %></strong><span>members</span></div><div><strong><%= stats.posts.toLocaleString() %></strong><span>posts shared</span></div><div><strong><%= stats.communities.toLocaleString() %></strong><span>communities</span></div></div><div class="community-list"><div class="list-heading"><h3>Top communities</h3><span><%= stats.communitiesAreLive ? 'Live from MongoDB' : 'Ready for yours' %></span></div><% if (!stats.topCommunities.length) { %><p style="color:#8e90a4;font-size:12px;padding:16px 0;border-top:1px solid var(--line);">No communities yet — <a href="/auth/register" style="color:#8da0ff;">join Crowdwide</a> and start the first one.</p><% } %><% stats.topCommunities.forEach((community, index) => { %><article class="community-row"><span class="community-index">0<%= index + 1 %></span><div><h4><%= community.name %></h4><p><%= community.description %></p></div><span class="community-members"><%= community.members.toLocaleString() %> members</span></article><% }) %></div></div></section>

  <% if (viralPosts.length) { %>
  <section class="container landing-highlight">
    <div class="section-intro"><p class="eyebrow">What's resonating</p><h2>Viral right now.</h2></div>
    <div class="explore-viral-grid">
      <% viralPosts.forEach((post) => { %>
      <div class="viral-card" style="cursor:default;">
        <div class="post-meta"><span class="avatar tiny"><%= (post.author?.name || '?').charAt(0).toUpperCase() %></span><div><strong style="color:#f6f6fa;"><%= post.author?.name || 'Member' %></strong></div></div>
        <p><%= (post.body || '').slice(0, 140) %><%= (post.body || '').length > 140 ? '…' : '' %></p>
        <span class="viral-likes">♥ <%= post.likesTotal %> likes</span>
      </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (popularPeople.length) { %>
  <section class="container landing-highlight">
    <div class="section-intro"><p class="eyebrow">Who people follow</p><h2>Most popular right now.</h2></div>
    <div class="community-list">
      <% popularPeople.forEach((person, index) => { %>
      <article class="community-row"><span class="community-index">0<%= index + 1 %></span><div><h4><%= person.name %></h4><p><%= person.bio || 'Active on Crowdwide' %></p></div><span class="community-members"><%= person.followers %> follower<%= person.followers === 1 ? '' : 's' %></span></article>
      <% }) %>
    </div>
    <p class="section-copy" style="margin-top:20px;"><a class="text-link" href="/auth/register">Join to follow them <span>↗</span></a></p>
  </section>
  <% } %>

  <section class="story-section container"><div class="story-marker">✦</div><div><p class="eyebrow">A better default</p><h2>What if social felt<br><em>like an open door?</em></h2><p>There is more to the internet than the loudest take and the fastest trend. Crowdwide is a place for the slow burn: the person who makes something beautiful, the question that changes how you see a subject, the community that feels like a room you were hoping to find.</p><a class="text-link" href="/about">Read our story <span>↗</span></a></div></section>
  <section class="cta-band container"><div><p class="eyebrow">The door is open</p><h2>Your next community<br><em>is already here.</em></h2></div><a class="button button-light" href="/auth/register">Step inside <span>↗</span></a></section>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/foot') %>
