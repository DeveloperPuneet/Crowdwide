<%- include('../partials/auth-shell-start', { title }) %>
<p class="eyebrow">One more step</p>
<h1>Enter your<br><em>security code.</em></h1>
<p class="form-note" id="twofa-copy">Open your authenticator app and enter the current six-digit code.</p>
<form class="auth-form" id="twofa-form" method="post" action="/auth/2fa">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>">
	<label id="twofa-code-label">Authenticator code<input class="code-input" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autofocus></label>
	<label id="twofa-recovery-label" hidden>Recovery code<input class="code-input" name="recoveryCode" placeholder="XXXXX-XXXXX" maxlength="11" style="letter-spacing:2px;font-size:19px;"></label>
	<button class="button button-primary button-full" type="submit">Continue <span>↗</span></button>
</form>
<p class="switch-auth"><a href="#" id="twofa-toggle">Use a recovery code instead</a></p>
<script>
document.getElementById('twofa-toggle').addEventListener('click', function (event) {
	event.preventDefault();
	var usingRecovery = !document.getElementById('twofa-recovery-label').hidden;
	document.getElementById('twofa-recovery-label').hidden = usingRecovery;
	document.getElementById('twofa-code-label').hidden = !usingRecovery;
	document.getElementById('twofa-copy').textContent = usingRecovery ? 'Open your authenticator app and enter the current six-digit code.' : 'Enter one of the one-time recovery codes you saved when you set up 2FA.';
	this.textContent = usingRecovery ? 'Use a recovery code instead' : 'Use your authenticator app instead';
});
</script>
<%- include('../partials/auth-shell-end') %>
