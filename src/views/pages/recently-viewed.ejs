<%- include('../partials/head', { title, bodyClass: 'dashboard-page', pagePath: '/recently-viewed', noIndex: true }) %>
<%- include('../partials/app-nav', { active: 'recent', currentUser }) %>
<main class="feature-page feature-page-modern dashboard-modern">
  <header class="feature-hero">
    <div><p class="eyebrow">Pick up where you left off</p><h1>Recently viewed</h1><p>Return to posts you've opened recently.</p></div>
    <a class="button button-primary button-small" href="/top">Explore popular posts</a>
  </header>
  <nav class="feature-nav" aria-label="Your activity">
    <a href="/topics">Topics</a>
    <a href="/conversations">Conversations</a>
    <a href="/recently-viewed" aria-current="page">Recently viewed <span><%= (posts || []).length %></span></a>
  </nav>
  <section class="feed-column">
    <div class="panel-heading feature-feed-heading">
      <div><p class="eyebrow">Your reading history</p><h2>Posts you've opened</h2></div>
      <span><%= (posts || []).length %> <%= (posts || []).length === 1 ? 'post' : 'posts' %></span>
    </div>
    <% if (!(posts || []).length) { %>
      <div class="empty-feed"><h2>Nothing viewed yet</h2><p>Posts you open will remain here for quick return.</p></div>
    <% } else { %>
      <div id="feed-posts"><% posts.forEach((post) => { %><%- include('../partials/post-card', { post, csrfToken }) %><% }) %></div>
    <% } %>
  </section>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
