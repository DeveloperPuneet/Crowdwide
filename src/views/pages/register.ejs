<%- include('../partials/auth-shell-start', { title }) %>
<div class="auth-badge" aria-hidden="true"><%- icon('user-plus', { size: 26 }) %></div><p class="eyebrow">Start your journey</p><h1>There’s room<br><em>for your voice.</em></h1><p class="form-note">Create your account and find a more human internet.</p>
<form class="auth-form" method="post" action="/auth/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Your name<input type="text" name="name" placeholder="How should we call you?" required></label><label>Email address<input type="email" name="email" placeholder="you@example.com" required></label><label>Password<input type="password" name="password" placeholder="At least 8 characters" minlength="8" required></label><% if (turnstileSiteKey) { %><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } else { %><label>Quick check: what is <%= captcha.a %> + <%= captcha.b %>?<input type="text" inputmode="numeric" name="captchaAnswer" placeholder="Your answer" required></label><% } %><div class="hp-field" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div><label class="consent-check"><input type="checkbox" name="acceptTerms" value="on" required><span>I agree to Crowdwide's <a href="/terms" target="_blank" rel="noopener">Terms of use</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy policy</a>.</span></label><button class="button button-primary button-full" type="submit">Create account <span class="btn-arrow"><%- icon('arrow-up-right', { size: 14 }) %></span></button></form>
<p class="terms">Also see our <a href="/community-guidelines">Community guidelines</a>.</p><p class="switch-auth">Already have an account? <a href="/auth/login">Sign in</a></p>
<%- include('../partials/auth-shell-end') %>
