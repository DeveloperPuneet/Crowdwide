<%- include('../partials/head', { title, description, bodyClass: 'dashboard-page', pagePath, noIndex, includeLeaflet }) %>
<%- include('../partials/app-nav', { active: 'explore', currentUser }) %>
<% if (locals.flash) { %><div class="container" style="padding-top:18px;"><%- include('../partials/flash') %></div><% } %>
<main class="community-map-page community-map-modern">
	<header class="community-map-heading">
		<a class="back-link" href="/explore">← Explore</a>
		<p class="eyebrow">Find your people, somewhere new</p>
		<h1>Community Galaxy</h1>
		<p>Explore public communities by location, topic, and category. Owners choose whether to share a general location.</p>
	</header>
	<section class="community-map-tools" aria-label="Filter communities">
		<label class="community-map-search"><span class="visually-hidden">Search communities and interests</span><%- icon('search', { size: 16 }) %><input type="search" placeholder="Search communities or interests" data-map-search></label>
		<label class="community-map-category"><span class="visually-hidden">Filter by category</span><select data-map-category><option value="">All categories</option><% categories.forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }) %></select></label>
		<p class="community-map-count" data-map-count><%= mapCommunities.length %> mapped communities</p>
	</section>
	<section class="community-map-layout">
		<div>
			<div class="community-map-canvas" data-community-discovery-map data-map-api-key="<%= locals.mapApiKey || '' %>" aria-label="Map of public communities"></div>
			<p class="community-map-tile-error" data-map-tile-error role="status" hidden>Map tiles are blocked on this connection. You can still search and open communities from the list.</p>
		</div>
		<div class="community-map-results" aria-label="Mapped communities">
			<div class="community-map-results-heading"><h2>Mapped communities</h2><span><%= mapCommunities.length %></span></div>
			<div class="community-map-list" data-map-list>
				<% mapCommunities.forEach((community) => { %>
				<article class="community-map-row" data-map-community data-name="<%= community.name %>" data-location="<%= community.locationLabel %>" data-category="<%= community.category || 'general' %>" data-topics="<%= (community.hashtags || []).join(' ') %>" data-lat="<%= community.locationLat %>" data-lng="<%= community.locationLng %>" data-members="<%= community.membersCount || 0 %>" data-slug="<%= community.slug %>">
					<div class="community-map-row-top">
						<% if (community.avatarImage) { %><img src="<%= community.avatarImage %>" alt="" loading="lazy"><% } else { %><span class="community-map-avatar"><%= (community.name || '?').trim().charAt(0).toUpperCase() || '?' %></span><% } %>
						<div><a href="/communities/<%= community.slug %>"><%= community.name %></a><span><%= community.locationLabel %></span></div>
					</div>
					<p><%= community.description %></p>
					<div class="community-map-row-meta"><span><%= (community.membersCount || 0).toLocaleString() %> members</span><span><%= community.category || 'general' %></span></div>
					<% if ((community.hashtags || []).length) { %><div class="hashtag-row"><% community.hashtags.slice(0, 4).forEach((tag) => { %><span class="hashtag-chip">#<%= tag %></span><% }) %></div><% } %>
					<button class="community-map-focus" type="button" data-map-focus>Show on map <%- icon('map-pin', { size: 13 }) %></button>
				</article>
				<% }) %>
				<p class="community-map-empty" data-map-empty <%= mapCommunities.length ? 'hidden' : '' %>>No communities are mapped yet. Community owners can add an optional general location in their community settings.</p>
			</div>
		</div>
	</section>
	<p class="community-map-attribution">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a> © <a href="https://carto.com/attributions" target="_blank" rel="noopener noreferrer">CARTO</a><% if (locals.mapApiKey) { %> © <a href="https://www.maptiler.com/copyright/" target="_blank" rel="noopener noreferrer">MapTiler</a><% } %> · <a href="https://www.openstreetmap.org/fixthemap" target="_blank" rel="noopener noreferrer">Report a map issue</a></p>
</main>
<%- include('../partials/app-footer') %>
<%- include('../partials/foot') %>
