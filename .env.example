PORT=3000
NODE_ENV=development
# Set to 1 on Render or another single reverse-proxy deployment.
TRUST_PROXY_HOPS=0
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/crowdwide
SESSION_SECRET=replace-with-a-long-random-string
# Google Cloud Gmail OAuth2
MAIL_PROVIDER=gmail
GMAIL_USER=your-verified-gmail-address@gmail.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
MAIL_FROM=Crowdwide <your-verified-gmail-address@gmail.com>

# Optional generic SMTP fallback (used when MAIL_PROVIDER is not gmail)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password

# Optional Google Cloud Storage media pipeline
GCS_PROJECT_ID=your-google-cloud-project-id
GCS_BUCKET=your-crowdwide-media-bucket
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
MEDIA_CDN_URL=https://cdn.example.com

APP_URL=https://crowdwide.onrender.com