PORT=3000
NODE_ENV=development
# Set to 1 on Render or another single reverse-proxy deployment.
TRUST_PROXY_HOPS=0
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/crowdwide
SESSION_SECRET=replace-with-a-long-random-string
# The verified account with this email becomes the admin on its next login.
ADMIN_EMAIL=admin@example.com

# Extended media storage (optional). Crowdwide always stores media on the
# primary MONGODB_URI cluster above ("cluster 0"). To spread images/video/
# audio/avatars across additional MongoDB clusters (e.g. more free-tier
# Atlas clusters), add as many of these as you want, numbered from 0 or 1
# upward with no gaps. Uploads are distributed across every cluster you
# define here in round-robin order - just add another MONGO_DB_URL_<n> and
# restart the app to add more storage capacity.
# MONGO_DB_URL_0=mongodb+srv://user:pass@cluster-a.mongodb.net/crowdwide-media-0
# MONGO_DB_URL_1=mongodb+srv://user:pass@cluster-b.mongodb.net/crowdwide-media-1
# MONGO_DB_URL_2=mongodb+srv://user:pass@cluster-c.mongodb.net/crowdwide-media-2
# Google Cloud Gmail OAuth2
MAIL_PROVIDER=gmail
GMAIL_USER=your-verified-gmail-address@gmail.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
MAIL_FROM=Crowdwide <your-verified-gmail-address@gmail.com>
# Gmail is sent over HTTPS (Gmail API) by default, which works on hosts that
# block SMTP ports (e.g. Render free tier). Set MAIL_TRANSPORT=smtp to force SMTP.
# MAIL_TRANSPORT=smtp
# Check your setup any time with:  npm run mail:test -- you@example.com
# MAIL_TIMEOUT_MS=15000
# bcrypt cost for NEW passwords (default 10; higher = slower sign-in/sign-up on small hosts)
# BCRYPT_ROUNDS=10

# Optional generic SMTP fallback (used when MAIL_PROVIDER is not gmail)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password

# Optional Google Cloud Storage media pipeline
GCS_PROJECT_ID=your-google-cloud-project-id
GCS_BUCKET=your-crowdwide-media-bucket
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
MEDIA_CDN_URL=https://cdn.example.com

APP_URL=https://www.crowdwide.run.place

# Web push notifications (optional - push stays off until these are set,
# and even then each user must explicitly opt in from Settings). Generate
# your own pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Critical-error alerting (optional - unhandled 5xx errors email this
# address instead of only ever showing up in logs; rate-limited to one
# email per distinct error per 15 minutes). Leave unset to disable.
ADMIN_ALERT_EMAIL=

# Upload scanning requires a separately running ClamAV daemon. It is free
# software, but needs a host with enough memory/disk and a private network;
# do not expose clamd's unauthenticated TCP port publicly. See DEPLOYMENT.md.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SOCKET=
# Set true to reject uploads when no scanner is configured. With a scanner
# configured, outages block uploads unless CLAMAV_FAIL_OPEN=true.
CLAMAV_REQUIRED=false
CLAMAV_FAIL_OPEN=false
# Free-tier keep-alive (node-cron pings your own /health URL so the host doesn't sleep).
# On by default only when NODE_ENV=production and a public APP_URL is set.
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URL=https://www.crowdwide.run.place
# KEEP_ALIVE_CRON=*/10 * * * *
# KEEP_ALIVE_TIMEOUT_MS=20000

# Feed: share of each page that comes from outside the viewer's network
# (people they don't follow / communities they haven't joined). Kept within 0.35-0.40.
# FEED_DISCOVERY_RATIO=0.375

# Popular searches: how many different members must search a query before it is shown.
# POPULAR_SEARCH_MIN_USERS=2

# GIFs in chat, group chat and comments (GIPHY). Google shut the Tenor API down on
# 30 June 2026, so GIPHY is the provider. Get a key at https://developers.giphy.com/
# Without a key the GIF buttons are simply hidden.
# GIPHY_API_KEY=your-giphy-api-key
# GIF_RATING=pg-13   # g, pg, pg-13 or r

# Registration CAPTCHA. By default sign-up uses a built-in arithmetic
# question plus an invisible honeypot field and a minimum-fill-time check.
# To use Cloudflare Turnstile (a managed CAPTCHA) instead, create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and set BOTH keys.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Minimum seconds-to-fill for the sign-up form, in ms (default 2000).
# CAPTCHA_MIN_FILL_MS=2000

# Community map tiles use OSM's standard HTTPS endpoint first with visible
# attribution, origin-only Referer, normal browser caching, and no prefetching.
# CARTO is the no-key fallback; MapTiler is optional after that and also provides
# city/region labels for the owner’s “Use current location” control. Restrict the
# key to your production domain; it is sent to browsers when map pages load.
# MAPTILER_API_KEY=

# Post/comment translation (optional). Set the base URL of a separate
# LibreTranslate service, not the Crowdwide website URL. For example, a
# private service might be http://libretranslate:5000.
LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=

# Staging: set APP_ENV=staging on a second deployment to add noindex headers,
# a visible banner, and to restrict outbound email to the allowlist below
# (comma-separated addresses or @domains). Leave unset in production.
# APP_ENV=staging
# STAGING_MAIL_ALLOWLIST=qa@yourteam.com,@yourcompany.com

# About-page community charts: member counts that define the size tiers.
# STATS_MID_COMMUNITY_MIN=10
# STATS_LARGE_COMMUNITY_MIN=50
