{
  "id": "/",
  "name": "Crowdwide",
  "short_name": "Crowdwide",
  "description": "A calmer social network for real discovery, thoughtful communities, and voices worth finding.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
